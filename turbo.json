{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "LVBT_REQUIRE_ANALYTICS",
    "LVWWD_E2E_PORT",
    "PUBLIC_LVBT_ANALYTICS_COLLECTOR",
    "PUBLIC_LVBT_CWA_TOKEN",
    "LVBT_PREVIEW_URL",
    "LVBT_PREVIEW_BINDINGS",
    "PLAYWRIGHT_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "build:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist-e2e/**"]
    },
    "sync": {
      "outputs": [".astro/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "sync"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "validate": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "check-types:worker": {},
    "@lasvegasfortransit/site#validate": {
      "dependsOn": [
        "^build",
        "check-types:worker",
        "//#security:dependencies",
        "//#security:secrets"
      ]
    },
    "//#security:dependencies": {
      "cache": false
    },
    "//#security:secrets": {
      "cache": false
    }
  },
  "globalPassThroughEnv": ["CF_ACCESS_CLIENT_ID", "CF_ACCESS_CLIENT_SECRET"],
  "globalDependencies": [".lvbt/web-platform.json", ".lvbt/tooling.json", ".github/workflows/**"]
}
