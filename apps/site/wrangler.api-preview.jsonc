{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The participant API's preview: the same Worker and pages as lvwwd.org,
  // on workers.dev, with its own database and photo bucket. It shows each
  // "Open my week" link on the page instead of only sending it, and treats
  // every day as Day 3 of the week so shared trips and reminders can be
  // tested before October. Deploy with:
  //   pnpm build && pnpm exec wrangler deploy -c wrangler.api-preview.jsonc
  // TURNSTILE_SECRET is a secret (`wrangler secret put -c ...`); the preview
  // uses Cloudflare's always-pass test keys.
  //
  // Reminders: VAPID_PRIVATE_KEY is a test key used only here
  // (`wrangler secret put VAPID_PRIVATE_KEY -c ...`), never production's.
  // The shared reminder trigger matches production. Browser notifications
  // concern saved plans; daily texts require separately confirmed consent.
  // Enable either release switch only for a controlled test. SMS also needs
  // preview-only Twilio services and this preview's HTTPS SMS_ORIGIN.
  // The "Send test reminder" button in /admin sends a push straight away.
  //
  // Admin views require Cloudflare Access, including on this isolated preview.
  // Configure ACCESS_TEAM_DOMAIN and ACCESS_AUD for a restricted preview Access
  // application before using them. PREVIEW_ADMIN_KEY is retired and ignored.
  // PREVIEW_DRAW_ANYTIME lets the draw run before October 14, on the preview only.
  "name": "lvwwd-api-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // As on lvwwd.org, the Worker sees every request first, so the old-address
    // redirects (worker/redirect.ts) can be tried here too.
    "run_worker_first": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lvwwd-api-preview",
      "database_id": "cb80dc98-8f84-4122-984a-7d2e60683986",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "lvwwd-api-preview-photos" }],
  "vars": {
    "PREVIEW_SHOW_LINKS": "true",
    "CHECKIN_PREVIEW_DAY": "3",
    "PREVIEW_DRAW_ANYTIME": "true",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "VAPID_SUBJECT": "mailto:wwd@lasvegasfortransit.org",
    "EVENT_REMINDERS_ENABLED": "false",
    "SMS_REMINDERS_ENABLED": "false",
  },
  "triggers": { "crons": ["0 13 * * *", "2-59/5 * * * *"] },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
}
