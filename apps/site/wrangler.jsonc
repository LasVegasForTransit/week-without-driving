{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Legacy mirror for Wrangler commands that cf cannot run yet. Production
  // builds and deployments use apps/deploy/cloudflare.config.ts.
  "name": "lvwwd",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  // The site is static. The Worker sends www to the apex, runs the
  // participant API under /api/ and the volunteer admin views under /admin
  // and /api/admin/, opens "Open my week" links, and writes the Turnstile
  // site key into the sign-up and link pages.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages answer at /guides, as every link on the site writes them, with
    // no redirect to /guides/ on the way (a round trip on a slow phone).
    "html_handling": "drop-trailing-slash",
    // The Worker sees every request first: it sends www to the apex on every
    // path, and runs the API, the admin views and the pages it fills in.
    "run_worker_first": true,
  },
  // Routes on the lvwwd.org zone: the Worker answers every request for the
  // apex and www in front of the zone's proxied DNS records, and serves the
  // site from its own assets, so nothing reaches an origin.
  "routes": [
    { "pattern": "lvwwd.org/*", "zone_name": "lvwwd.org" },
    { "pattern": "www.lvwwd.org/*", "zone_name": "lvwwd.org" },
  ],
  // Cron Triggers (worker/index.ts picks the job):
  // - "0 13 * * *": rate-limit housekeeping every day, and the deletion of
  //   all participant data from November 30, 2026 (worker/cleanup.ts).
  // - Every five minutes: saved-plan browser notifications and, at 8 am
  //   Las Vegas time October 1–8, confirmed daily texts. Each channel has
  //   its own consent and release switch; both start off.
  "triggers": {
    "crons": ["0 13 * * *", "2-59/5 * * * *"],
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  // The participant database and the bucket for screenshots of shared
  // posts, on LVBT's account with the lvwwd.org zone. Apply migrations with
  // `pnpm exec cf d1 migrations apply <DATABASE_ID> --dir migrations`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lvwwd",
      "database_id": "a3a6c177-f000-4a64-8bc8-a4aad6d07cf1",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "lvwwd-photos" }],
  // The secrets, the Turnstile widget, volunteer sign-in (Cloudflare Access)
  // and email are listed in platform.json; `pnpm bootstrap --production`
  // sets them up and `pnpm preflight --production` checks them. The bot
  // check requires the Turnstile widget, its public TURNSTILE_SITE_KEY var,
  // and its TURNSTILE_SECRET Worker secret. Sign-up and "Get my link" fail
  // closed until they are configured.
  //
  // VAPID_SUBJECT is the contact push services use to reach LVBT about its
  // reminder notifications. The key that signs them, VAPID_PRIVATE_KEY, is
  // a secret that `pnpm bootstrap --production` generates once.
  "vars": {
    "VAPID_SUBJECT": "mailto:wwd@lasvegasfortransit.org",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFJwyZWXSScAitjH",
    "EVENT_REMINDERS_ENABLED": "false",
    "SMS_REMINDERS_ENABLED": "false",
    "SMS_ORIGIN": "https://lvwwd.org",
  },
}
