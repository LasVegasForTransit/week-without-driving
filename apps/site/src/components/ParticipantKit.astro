---
import { Icon } from 'astro-icon/components';
import { kitFramingParagraph, kitNextSteps, type PledgeTier } from '../lib/pledge';

// The one participant kit layout shared by /pledged/trip, /pledged/day and
// /pledged/week (built by the pledge Epic's "Give each pledger a
// participant kit with next steps", plus the reminders, share and
// "stay involved" Epics whose sections live on this same page). Order is
// fixed by the shared decisions file, section 6.9: tier heading and phase
// line; "Your next steps"; "Share your pledge"; "Get a daily reminder";
// "Keep going after the week"; "Change my pledge" and "Start a new pledge".
//
// All interaction here is a front-end demo — see /scripts/participant-kit.js
// for which task connects each part to a real backend.

interface Props {
  tier: PledgeTier;
}

const { tier } = Astro.props;
---

<section class="container-page pt-12 pb-8 md:pt-16">
  <h1 class="text-display-sm">You’re in for {tier.name}</h1>
  <p class="mt-3 text-title-md text-on-surface-variant">October 1 to 8, 2026</p>
  <p data-phase-line class="mt-1 text-title-md font-semibold text-primary-ink">
    The week starts October 1.
  </p>
  <p class="lede mt-5 max-w-2xl">{kitFramingParagraph}</p>
</section>

<section
  class="container-page border-t border-outline-variant/15 py-10"
  aria-labelledby="next-steps-heading"
>
  <h2 id="next-steps-heading" class="text-headline-sm">Your next steps</h2>
  <ul class="mt-5 divide-y divide-outline-variant/15 border-t border-b border-outline-variant/15">
    {
      kitNextSteps.map((step) => (
        <li>
          <a
            href={step.href}
            class="group flex min-h-[44px] items-center justify-between gap-4 py-4 no-underline"
          >
            <span class="font-semibold group-hover:text-primary-ink group-focus-visible:text-primary-ink">
              {step.label}
            </span>
            <Icon
              name="mdi:arrow-right"
              class="size-5 shrink-0 text-on-surface-variant group-hover:text-primary-ink"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section class="container-page border-t border-outline-variant/15 py-10">
  <button
    type="button"
    data-share-pledge
    data-tier-name={tier.name}
    class="press inline-flex items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
  >
    <Icon name="mdi:share-variant-outline" class="size-5" aria-hidden="true" />
    Share your pledge
  </button>
  <p data-share-status class="mt-3 text-sm font-semibold text-primary-ink" aria-live="polite"></p>
  <noscript>
    <style>
      [data-share-pledge] {
        display: none;
      }
    </style>
  </noscript>
</section>

<section
  class="container-page border-t border-outline-variant/15 py-10"
  aria-labelledby="reminder-heading"
>
  <h2 id="reminder-heading" class="text-headline-sm">Get a daily reminder</h2>
  <p class="lede mt-3 max-w-2xl">
    One short reminder a day, October 1 to 8, at about 8:00 am Las Vegas time. Get it as a browser
    notification, a text message, or both. You can stop anytime.
  </p>

  <div data-reminder-live class="mt-8 grid gap-8 md:grid-cols-2">
    {
      /* Browser notifications — task "Send daily reminders by web
       push" connects this to real web push. */
    }
    <div>
      <h3 class="text-title-lg">Browser notifications</h3>
      <div data-push-default class="mt-3">
        <p class="text-sm leading-relaxed text-on-surface-variant">
          One notification a day, October 1 to 8, at about 8:00 am. No phone number or email needed.
          Turn them off anytime with Stop reminders on this page. See{' '}
          <a href="/privacy" class="body-link">Privacy</a>.
        </p>
        <button
          type="button"
          data-push-enable
          class="press mt-3 inline-flex min-h-[44px] items-center border border-outline px-5 font-bold hover:border-primary hover:text-primary-ink focus-visible:border-primary focus-visible:text-primary-ink"
        >
          Turn on notifications
        </button>
      </div>
      <div data-push-ios hidden class="mt-3">
        <p class="text-sm leading-relaxed text-on-surface-variant">
          On iPhone, notifications work only from the Home Screen. Add lvwwd.org to your Home
          Screen, open it from the new WWD Las Vegas icon, tap View your kit, then tap Turn on
          notifications here.
        </p>
      </div>
      <div data-push-on hidden class="mt-3" aria-live="polite">
        <p data-push-on-message class="font-semibold"></p>
        <button
          type="button"
          data-push-stop
          class="press mt-3 inline-flex min-h-[44px] items-center border border-outline px-5 font-bold hover:border-primary hover:text-primary-ink focus-visible:border-primary focus-visible:text-primary-ink"
        >
          Stop reminders
        </button>
      </div>
    </div>

    {
      /* Text messages — task "Send daily reminders by text message" connects this to Twilio and the real
       YES/STOP/HELP replies. */
    }
    <div>
      <h3 class="text-title-lg">Text messages</h3>
      <form data-text-form class="mt-3" novalidate>
        <label for="reminder-phone" class="text-sm font-bold">Mobile number (US only)</label>
        <input
          id="reminder-phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="For example, (702) 555-0123"
          class="field mt-2 w-full"
        />
        <label class="check-row mt-3">
          <input type="checkbox" data-text-consent />
          <span
            >Text me one reminder a day, October 1 to 8, 2026, from Week Without Driving Las Vegas.</span
          >
        </label>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
          Up to 8 reminder texts, plus a confirmation text and a reply when you confirm. Each is one
          standard text. Message and data rates may apply. Reply STOP to end, HELP for help. We use
          your number only for these reminders and delete it on November 30, 2026. See{' '}
          <a href="/privacy" class="body-link">Privacy</a>.
        </p>
        <button
          type="submit"
          data-text-submit
          disabled
          class="press mt-3 inline-flex min-h-[44px] items-center border border-outline px-5 font-bold enabled:hover:border-primary enabled:hover:text-primary-ink enabled:focus-visible:border-primary enabled:focus-visible:text-primary-ink disabled:opacity-50"
        >
          Text me reminders
        </button>
        <p data-text-error class="mt-2 text-sm font-semibold text-primary-ink" aria-live="polite">
        </p>
      </form>
      <div data-text-confirm hidden class="mt-3" aria-live="polite">
        <p data-text-confirm-message class="font-semibold"></p>
      </div>
    </div>
  </div>

  <div data-reminder-closed hidden class="mt-8">
    <p class="font-semibold">Daily reminders have ended. Thanks for taking part!</p>
  </div>

  <noscript>
    <style>
      [data-reminder-live] {
        display: none;
      }
    </style>
    <p class="mt-4 text-sm font-semibold text-primary-ink">
      Reminder sign-up needs JavaScript turned on in your browser.
    </p>
  </noscript>
</section>

{
  /* Keep going after the week — Epic "Invite participants to stay involved
   with LVBT". task (newsletter sign-up), (Beehiiv) and
   (this card) connect it to a real subscription. */
}
<section
  id="keep-going"
  class="container-page scroll-mt-24 border-t border-outline-variant/15 py-10"
  aria-labelledby="keep-going-heading"
>
  <div
    class="relative overflow-hidden border border-outline bg-surface-container p-6 pl-8 md:p-8 md:pl-10"
  >
    <span class="absolute inset-y-0 left-0 w-2 bg-primary" aria-hidden="true"></span>
    <h2 id="keep-going-heading" class="text-headline-sm">Keep going after the week</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-pretty">
      Week Without Driving lasts eight days, but Las Vegans for Better Transit works all year for
      better buses and safer streets across the valley. Keep going with us.
    </p>

    <form data-newsletter-form class="mt-5 max-w-md" novalidate>
      <label for="keepgoing-email" class="text-sm font-bold">Email</label>
      <input
        id="keepgoing-email"
        name="email"
        type="email"
        autocomplete="email"
        class="field mt-2 w-full"
      />
      <button
        type="submit"
        data-newsletter-submit
        class="press mt-3 inline-flex min-h-[44px] items-center bg-primary px-6 py-3 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
      >
        Join the newsletter
      </button>
      <p data-form-status class="mt-2 text-sm font-semibold text-primary-ink" aria-live="polite">
      </p>
    </form>

    <p class="mt-4 max-w-md text-sm leading-relaxed text-on-surface-variant">
      The newsletter comes from LVBT, not this campaign, so your subscription isn’t deleted on
      November 30. You can unsubscribe at any time. See our{' '}
      <a href="/privacy" class="body-link">Privacy page</a>.
    </p>

    <p class="mt-6 font-semibold">Ready to do more?</p>
    <a href="https://lasvegasfortransit.org/join" class="body-link font-semibold">Become a member</a
    >

    <noscript>
      <style>
        [data-newsletter-form] {
          display: none;
        }
      </style>
      <p class="mt-5">
        <a href="https://mail.lasvegasfortransit.org/" class="body-link font-semibold"
          >Sign up on LVBT’s newsletter page</a
        >
      </p>
    </noscript>
  </div>
</section>

<section class="container-page border-t border-outline-variant/15 py-10">
  <div class="flex flex-col items-start gap-3">
    <a data-change-pledge href="/take-part#pledge" class="body-link font-semibold"
      >Change my pledge</a
    >
    <a data-start-new-pledge href="/take-part" class="body-link font-semibold">Start a new pledge</a
    >
  </div>
</section>

<style>
  .field {
    display: block;
    min-height: 44px;
    border: 1px solid var(--color-outline-variant);
    background: var(--color-surface);
    padding: 0.625rem 0.875rem;
  }
  .field:focus-visible {
    box-shadow: inset 0 -4px 0 var(--color-primary);
  }
  .check-row {
    display: flex;
    min-height: 44px;
    cursor: pointer;
    align-items: center;
    gap: 0.75rem;
    line-height: 1.4;
  }
  .check-row input {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    accent-color: var(--color-primary);
  }
</style>

<script is:inline src="/scripts/participant-kit.js" defer></script>
