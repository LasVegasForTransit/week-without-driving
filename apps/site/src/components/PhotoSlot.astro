---
import type { Photo } from '../lib/photos';

// A photo, or a clearly marked place for one that LVBT has not supplied
// yet. With `photo`, it renders the image at the right size for the screen
// plus the credit its license asks for. Without it, it renders a warm,
// patterned panel with a "Photo to come" tag and a description of the
// photo it is waiting for, so nobody mistakes it for the finished image.
interface Props {
  /** What the finished photo should show, in plain words. */
  shows: string;
  photo?: Photo | undefined;
  class?: string;
  /** Hide the caption when text is laid over the slot (the hero). */
  quiet?: boolean;
  /** Load right away (the hero) instead of when scrolled near. */
  eager?: boolean;
  /** How wide the photo is drawn, for choosing a file size. */
  sizes?: string;
}
const {
  shows,
  photo,
  class: className,
  quiet = false,
  eager = false,
  sizes = '100vw',
} = Astro.props;
const srcset = photo?.widths.map((w) => `/photos/${photo.name}-${w}.webp ${w}w`).join(', ');
const largest = photo ? `/photos/${photo.name}-${photo.widths.at(-1)}.webp` : undefined;
---

{
  photo ? (
    <figure class:list={['photo', className]}>
      <img
        src={largest}
        srcset={srcset}
        sizes={sizes}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
      <figcaption class="photo__credit">
        <a href={photo.sourceUrl} target="_blank" rel="noopener noreferrer">
          Photo: {photo.credit}
        </a>
        {photo.licenseUrl ? (
          <>
            {', '}
            <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">
              {photo.license}
            </a>
          </>
        ) : (
          `, ${photo.license}`
        )}
      </figcaption>
    </figure>
  ) : (
    <div class:list={['photo-slot', className]} role="img" aria-label={`Photo to come: ${shows}`}>
      <span class="photo-slot__tag" aria-hidden="true">
        Photo to come
      </span>
      {!quiet && (
        <span class="photo-slot__shows" aria-hidden="true">
          {shows}
        </span>
      )}
    </div>
  )
}

<style>
  .photo {
    position: relative;
    overflow: hidden;
    margin: 0;
    background: var(--color-surface-container);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Above any shade a page lays over the photo, so it stays readable. */
  .photo__credit {
    position: absolute;
    z-index: 2;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.1rem 0.45rem;
    font-size: 0.7rem;
    line-height: 1.4;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    border-radius: 999px;
  }
  .photo__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .photo-slot {
    position: relative;
    overflow: hidden;
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        color-mix(in srgb, var(--color-on-surface) 5%, transparent) 14px 15px
      ),
      radial-gradient(
        120% 90% at 20% 10%,
        color-mix(in srgb, var(--color-primary-warm) 55%, transparent),
        transparent 60%
      ),
      radial-gradient(
        120% 90% at 90% 90%,
        color-mix(in srgb, var(--color-primary) 45%, transparent),
        transparent 65%
      ),
      var(--color-surface-container);
  }
  .photo-slot__tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    border-radius: 999px;
  }
  .photo-slot__shows {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-on-surface);
  }
</style>
