---
import { Icon } from 'astro-icon/components';
import type { Photo } from '../lib/photos';

// A photo, or an icon panel until LVBT has one. With `photo`, it renders
// the image at the right size for the screen plus the credit its license
// asks for. Without it, it draws a quiet panel with an icon for what the
// photo will show (`shows` describes it, for whoever adds the photo).
interface Props {
  /** What the finished photo should show, in plain words. */
  shows: string;
  photo?: Photo | undefined;
  class?: string;
  /** Hide the caption when text is laid over the slot (the hero). */
  quiet?: boolean;
  /** The icon drawn when there is no photo. */
  icon?: string;
  /** Load right away (the hero) instead of when scrolled near. */
  eager?: boolean;
  /** How wide the photo is drawn, for choosing a file size. */
  sizes?: string;
}
const {
  shows,
  photo,
  class: className,
  quiet: _quiet = false,
  icon = 'mdi:bus',
  eager = false,
  sizes = '100vw',
} = Astro.props;
const srcset = photo?.widths.map((w) => `/photos/${photo.name}-${w}.webp ${w}w`).join(', ');
const largest = photo ? `/photos/${photo.name}-${photo.widths.at(-1)}.webp` : undefined;
---

{
  photo ? (
    <figure class:list={['photo', className]}>
      <img
        src={largest}
        srcset={srcset}
        sizes={sizes}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
      <figcaption class="photo__credit">
        <a href={photo.sourceUrl} target="_blank" rel="noopener noreferrer">
          Photo: {photo.credit}
        </a>
        {photo.licenseUrl ? (
          <>
            {', '}
            <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">
              {photo.license}
            </a>
          </>
        ) : (
          `, ${photo.license}`
        )}
      </figcaption>
    </figure>
  ) : (
    <div class:list={['photo-slot', className]} aria-hidden="true" data-shows={shows}>
      <Icon name={icon} class="photo-slot__icon" />
    </div>
  )
}

<style>
  .photo {
    position: relative;
    overflow: hidden;
    margin: 0;
    background: var(--color-surface-container);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Above any shade a page lays over the photo, so it stays readable. */
  .photo__credit {
    position: absolute;
    z-index: 2;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.1rem 0.45rem;
    font-size: 0.7rem;
    line-height: 1.4;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    border-radius: 999px;
  }
  .photo__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  /* No photo yet: a quiet panel with an icon for what the photo will show. */
  .photo-slot {
    display: grid;
    place-items: center;
    color: var(--color-primary-ink);
    background: var(--color-primary-container);
  }
  .photo-slot :global(.photo-slot__icon) {
    width: 30%;
    max-width: 6rem;
    height: auto;
    aspect-ratio: 1;
  }
</style>
