---
// A clearly marked place for a real photo that LVBT has not supplied yet.
// It renders as a warm, patterned panel with a "Photo to come" tag and a
// description of the photo it is waiting for, so nobody mistakes it for
// the finished image. Replace each slot with a real <img> (with alt text)
// before the site is shared outside LVBT.
interface Props {
  /** What the finished photo should show, in plain words. */
  shows: string;
  class?: string;
  /** Hide the caption when text is laid over the slot (the hero). */
  quiet?: boolean;
}
const { shows, class: className, quiet = false } = Astro.props;
---

<div class:list={['photo-slot', className]} role="img" aria-label={`Photo to come: ${shows}`}>
  <span class="photo-slot__tag" aria-hidden="true">Photo to come</span>
  {
    !quiet && (
      <span class="photo-slot__shows" aria-hidden="true">
        {shows}
      </span>
    )
  }
</div>

<style>
  .photo-slot {
    position: relative;
    overflow: hidden;
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        color-mix(in srgb, var(--color-on-surface) 5%, transparent) 14px 15px
      ),
      radial-gradient(
        120% 90% at 20% 10%,
        color-mix(in srgb, var(--color-primary-warm) 55%, transparent),
        transparent 60%
      ),
      radial-gradient(
        120% 90% at 90% 90%,
        color-mix(in srgb, var(--color-primary) 45%, transparent),
        transparent 65%
      ),
      var(--color-surface-container);
  }
  .photo-slot__tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    border-radius: 999px;
  }
  .photo-slot__shows {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-on-surface);
  }
</style>
