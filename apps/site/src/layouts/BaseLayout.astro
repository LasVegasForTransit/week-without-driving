---
import '../styles/global.css';
// Must import after global.css: print.css's non-!important declarations win
// same-specificity screen rules by source order (see its header comment).
import '../styles/print.css';
import { lvbt, site } from '../lib/site';
import { Icon } from 'astro-icon/components';
import { footerLinks, isCurrent, moreNav, tabNav, topNav } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og-wwd.png',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
{
  /* `reveal-ready` is rendered server-side so the `.reveal-ready .reveal`
    cascade in global.css applies before any reveal element paints. The
    <noscript> override restores graceful degradation for visitors without
    JS: reveals snap to visible instead of getting stuck hidden. */
}
<html lang="en" class="reveal-ready">
  <head>
    <meta charset="UTF-8" />
    <script is:inline src="/scripts/theme-preview.js"></script>
    <noscript>
      <style>
        .reveal-ready .reveal,
        .reveal-ready .reveal-stat,
        .reveal-ready .reveal-quote {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
          transition: none !important;
        }
      </style>
    </noscript>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/public-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col" data-canvas="paper">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="min-h-dvh flex flex-col">
      <header data-site-header class="site-header">
        <div class="container-page site-header__row">
          <a href="/" class="site-logo" aria-label="Week Without Driving Las Vegas, home">
            <span class="site-logo__badge" aria-hidden="true">WWD</span>
            <span class="site-logo__text" aria-hidden="true">
              <span class="site-logo__place">Las Vegas</span>
              <span class="site-logo__dates">Oct 1–8, 2026</span>
            </span>
          </a>
          <nav aria-label="Main" class="site-topnav">
            <ul>
              {
                topNav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent(item.href, path) ? 'page' : undefined}
                      class="nav-link"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a href="/take-part#pledge" class="site-pledge" data-pledge-link>
            <span data-pledge-label>Pledge</span>
          </a>
        </div>
      </header>
      <main id="main" class="flex-1">
        <slot />
      </main>
    </div>
    <nav aria-label="Main" class="tabbar">
      <ul>
        {
          tabNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.match, path) ? 'page' : undefined}
                class="tabbar__link"
                {...(item.pledge ? { 'data-pledge-link': '' } : {})}
              >
                <Icon name={item.icon} class="tabbar__icon" aria-hidden="true" />
                <span {...(item.pledge ? { 'data-pledge-label': '' } : {})}>{item.label}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="#more" class="tabbar__link" data-more-open aria-haspopup="dialog">
            <Icon
              name="mdi:dots-horizontal-circle-outline"
              class="tabbar__icon"
              aria-hidden="true"
            />
            <span>More</span>
          </a>
        </li>
      </ul>
    </nav>
    <dialog id="more" class="more-sheet" aria-labelledby="more-heading" data-more-sheet>
      <div class="more-sheet__head">
        <h2 id="more-heading" class="more-sheet__title">More</h2>
        <button type="button" class="more-sheet__close" data-more-close aria-label="Close">
          <Icon name="mdi:close" class="size-6" aria-hidden="true" />
        </button>
      </div>
      <ul class="more-sheet__list">
        {
          moreNav.map((item) => (
            <li>
              <a href={item.href} class="more-sheet__link">
                <Icon name={item.icon} class="size-6" aria-hidden="true" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more-sheet__credit">
        An initiative by <a href={lvbt.url} class="body-link">{lvbt.name}</a>
      </p>
    </dialog>
    <footer
      id="site-footer"
      class="site-footer container-page border-t border-outline-variant/15 py-10"
    >
      <div class="flex flex-wrap items-start justify-between gap-x-12 gap-y-6">
        <p class="max-w-md text-sm leading-relaxed text-on-surface-variant">
          An initiative by{' '}
          <a href={lvbt.url} data-print-url={lvbt.url} class="body-link font-semibold"
            >{lvbt.name}</a
          >, a 501(c)(3) nonprofit. The national campaign is organized by{' '}
          <a
            href="https://weekwithoutdriving.org/"
            data-print-url="https://weekwithoutdriving.org/"
            target="_blank"
            rel="noopener noreferrer"
            class="body-link">America Walks</a
          >.
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          <li>
            <a
              href={lvbt.instagramUrl}
              data-print-url={lvbt.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="body-link"
            >
              Instagram
            </a>
          </li>
          <li>
            <a href="mailto:wwd@lasvegasfortransit.org" class="body-link">Email us</a>
          </li>
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="body-link">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={lvbt.joinUrl} data-print-url={lvbt.joinUrl} class="body-link">Join LVBT</a>
          </li>
          <li>
            <a
              href="https://weekwithoutdriving.org/"
              data-print-url="https://weekwithoutdriving.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="body-link"
            >
              weekwithoutdriving.org
            </a>
          </li>
        </ul>
      </div>
    </footer>
    {
      /* Behaviour lives under public/scripts so it satisfies the CSP
        `script-src 'self'` in public/_headers; an inline block would be
        rejected in production and leave every reveal element hidden. */
    }
    <script is:inline src="/scripts/reveal-on-scroll.js" defer></script>
    <script is:inline src="/scripts/site-nav.js" defer></script>
    <script is:inline src="/scripts/copy-anchor.js" defer></script>
    <script is:inline src="/scripts/print-links.js" defer></script>
  </body>
</html>
