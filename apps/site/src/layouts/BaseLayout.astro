---
import '../styles/global.css';
// Must import after global.css: print.css's non-!important declarations win
// same-specificity screen rules by source order (see its header comment).
import '../styles/print.css';
import { lvbt, site } from '../lib/site';
import { Icon } from 'astro-icon/components';
import { footerLinks, isCurrent, mainNav } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og-wwd.png',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
{
  /* `reveal-ready` is rendered server-side so the `.reveal-ready .reveal`
    cascade in global.css applies before any reveal element paints. The
    <noscript> override restores graceful degradation for visitors without
    JS: reveals snap to visible instead of getting stuck hidden. */
}
<html lang="en" class="reveal-ready">
  <head>
    <meta charset="UTF-8" />
    <noscript>
      <style>
        .reveal-ready .reveal,
        .reveal-ready .reveal-stat,
        .reveal-ready .reveal-quote {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
          transition: none !important;
        }
      </style>
    </noscript>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {/* Light and dark follow the device setting; there is no toggle. */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf4e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17130f" media="(prefers-color-scheme: dark)" />
    <link
      rel="preload"
      href="/fonts/atkinson-next-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Installing the site: the manifest names it and its icons. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />
    <meta name="apple-mobile-web-app-title" content="WWD Las Vegas" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col" data-canvas="paper">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="min-h-dvh flex flex-col">
      <header data-site-header class="site-header">
        <div class="container-page site-header__row">
          <a href="/" class="wordmark">
            <span class="wordmark__name">Week Without Driving</span>
            <span class="wordmark__meta">Las Vegas · Oct 1–8, 2026</span>
          </a>
          <nav aria-label="Main" class="site-topnav">
            <ul>
              {
                mainNav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent(item.href, path) ? 'page' : undefined}
                      class="site-topnav__link"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="site-header__actions">
            <a href="/sign-up" class="site-cta" data-signup-link>
              <span class="site-cta__long" data-signup-label>Sign up to win</span>
              <span class="site-cta__short" data-signup-label>Sign up</span>
            </a>
            <a
              href="#site-menu"
              class="site-menu-button"
              data-menu-open
              aria-haspopup="dialog"
              aria-label="Open the menu"
            >
              <Icon name="mdi:menu" class="size-7" aria-hidden="true" />
            </a>
          </div>
        </div>
      </header>
      <main id="main" class="flex-1">
        <slot />
      </main>
    </div>
    <dialog id="site-menu" class="site-menu" aria-label="Menu" data-menu>
      <div class="site-menu__head">
        <span class="wordmark" aria-hidden="true">
          <span class="wordmark__name">Week Without Driving</span>
          <span class="wordmark__meta">Las Vegas · Oct 1–8, 2026</span>
        </span>
        <button type="button" class="site-menu__close" data-menu-close aria-label="Close the menu">
          <Icon name="mdi:close" class="size-7" aria-hidden="true" />
        </button>
      </div>
      <a href="/sign-up" class="site-menu__cta" data-signup-link>
        <span data-signup-label>Sign up to win</span>
        <Icon name="mdi:arrow-right" class="size-6" aria-hidden="true" />
      </a>
      <ul class="site-menu__list">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-menu__link"
                aria-current={isCurrent(item.href, path) ? 'page' : undefined}
              >
                <Icon name={item.icon} class="site-menu__icon" aria-hidden="true" />
                <span>
                  <span class="site-menu__label">{item.label}</span>
                  <span class="site-menu__help">{item.help}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="site-menu__credit">
        An initiative by <a href={lvbt.url} class="body-link">{lvbt.name}</a>
      </p>
    </dialog>
    <footer
      id="site-footer"
      class="site-footer container-page border-t border-outline-variant/15 py-10"
    >
      <div class="flex flex-wrap items-start justify-between gap-x-12 gap-y-6">
        <p class="max-w-md text-sm leading-relaxed text-on-surface-variant">
          An initiative by{' '}
          <a href={lvbt.url} data-print-url={lvbt.url} class="body-link font-semibold"
            >{lvbt.name}</a
          >, a 501(c)(3) nonprofit. The national campaign is organized by{' '}
          <a
            href="https://weekwithoutdriving.org/"
            data-print-url="https://weekwithoutdriving.org/"
            target="_blank"
            rel="noopener noreferrer"
            class="body-link">America Walks</a
          >.
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          {/* Shown by /scripts/app.js where installing is possible. */}
          <li>
            <button type="button" class="install-button body-link" data-install-button hidden>
              <Icon name="mdi:cellphone-arrow-down" class="size-5" aria-hidden="true" />
              Add to home screen
            </button>
          </li>
          <li>
            <a
              href={lvbt.instagramUrl}
              data-print-url={lvbt.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="body-link"
            >
              Instagram
            </a>
          </li>
          <li>
            <a href="mailto:wwd@lasvegasfortransit.org" class="body-link">Email us</a>
          </li>
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="body-link">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={lvbt.joinUrl} data-print-url={lvbt.joinUrl} class="body-link">Join LVBT</a>
          </li>
          <li>
            <a
              href="https://weekwithoutdriving.org/"
              data-print-url="https://weekwithoutdriving.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="body-link"
            >
              weekwithoutdriving.org
            </a>
          </li>
        </ul>
      </div>
    </footer>
    {
      /* The instructions for adding the site to the home screen. /scripts/app.js
      opens it with the iPhone steps (data-install-ios) or the steps for
      other phone browsers (data-install-general). */
    }
    <dialog class="install-sheet" data-install-sheet aria-labelledby="install-ios-title">
      <div class="install-sheet__body">
        <div class="install-sheet__head">
          <h2 id="install-ios-title" class="install-sheet__title" tabindex="-1" data-install-ios>
            Add WWD Las Vegas to your Home Screen
          </h2>
          <h2
            id="install-general-title"
            class="install-sheet__title"
            tabindex="-1"
            data-install-general
          >
            Add WWD Las Vegas to your home screen
          </h2>
          <button type="button" class="install-sheet__close" data-install-close aria-label="Close">
            <Icon name="mdi:close" class="size-7" aria-hidden="true" />
          </button>
        </div>
        <p class="install-sheet__line">
          Open the guides, Bingo and My week with one tap. The guides and Bingo work even with no
          signal.
        </p>
        <ol class="install-sheet__steps" data-install-ios>
          <li>
            Tap the Share button. It’s a square with an arrow pointing up. If you don’t see it, tap
            ··· first.
          </li>
          <li>Scroll down and tap Add to Home Screen.</li>
          <li>Tap Add. The WWD Las Vegas icon appears on your Home Screen.</li>
        </ol>
        <ol class="install-sheet__steps" data-install-general>
          <li>
            Open your browser’s menu or Share button. The menu is usually three dots or three lines.
          </li>
          <li>
            Tap Add to Home Screen or Install app. In Samsung Internet, tap Add page to, then Home
            screen.
          </li>
          <li>Tap Add or Install. The WWD Las Vegas icon appears on your home screen.</li>
        </ol>
        <p class="install-sheet__note" data-install-general>
          Opened this page from Instagram, Facebook or another app? First open the app’s menu and
          choose to open the page in your browser. Then follow these steps.
        </p>
        <button type="button" class="btn btn--primary install-sheet__done" data-install-close>
          Got it
        </button>
      </div>
    </dialog>
    {/* The update bar: /scripts/app.js fills it when a new version is ready. */}
    <div class="update-bar" role="status" aria-live="polite" data-update-bar></div>
    {
      /* Behaviour lives under public/scripts so it satisfies the CSP
        `script-src 'self'` in public/_headers; an inline block would be
        rejected in production and leave every reveal element hidden. */
    }
    <script is:inline src="/scripts/reveal-on-scroll.js" defer></script>
    <script is:inline src="/scripts/site-nav.js" defer></script>
    <script is:inline src="/scripts/copy-anchor.js" defer></script>
    <script is:inline src="/scripts/print-links.js" defer></script>
    <script is:inline src="/scripts/app.js" defer></script>
  </body>
</html>
