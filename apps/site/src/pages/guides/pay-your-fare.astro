---
// "Pay your bus fare" (build-brief.md section 5.4). Content lives in
// src/content/guides/pay-your-fare.md; this file only wires it into the
// shared GuideLayout.
//
// Unverified RTC facts: this guide deliberately does not state pass
// prices, the Deuce pass price, ticket vending machine or sales office
// locations, whether cash fare needs exact change, or reduced-fare
// eligibility rules as fact, because nobody has checked them against
// RTC's current fares page for this rewrite. Each price/rule mention
// instead points to "Check current fares at rtcsnv.com". Before launch,
// check https://www.rtcsnv.com/ways-to-travel/fares-passes/ and fill
// those specifics into the Markdown file.
import { getEntry } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getNextGuide, getSortedGuides } from '../../lib/guides';

const guide = await getEntry('guides', 'pay-your-fare');
if (!guide) {
  throw new Error('Guide "pay-your-fare" is missing from src/content/guides.');
}
const guides = await getSortedGuides();
const nextGuide = getNextGuide(guides, guide.id);
---

<GuideLayout guide={guide} nextGuide={nextGuide} />
