---
// "Pay your bus fare". Content lives in src/content/guides/pay-your-fare.md;
// this file only wires it into the shared GuideLayout. The Markdown file's
// closing comment says which fares were checked against RTC's fares page,
// when, and what is still left to confirm.
import { getEntry } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getNextGuide, getSortedGuides } from '../../lib/guides';

const guide = await getEntry('guides', 'pay-your-fare');
if (!guide) {
  throw new Error('Guide "pay-your-fare" is missing from src/content/guides.');
}
const guides = await getSortedGuides();
const nextGuide = getNextGuide(guides, guide.id);
---

<GuideLayout guide={guide} nextGuide={nextGuide} />
