---
// The Guides index (build-brief.md section 5.4): a heading, one sentence
// of introduction, the six guide cards in a fixed order, and a link out
// to "Places to go" on the Go page. Card order and text come from each
// guide's own file under src/content/guides, so this page never needs to
// change when a guide's copy does.
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedGuides } from '../../lib/guides';

const guides = await getSortedGuides();
const description =
  'A little help for your next trip. Pick a guide for the part you’re figuring out, from boarding the bus to finding a shady walk.';
---

<BaseLayout title="Rider guides · Week Without Driving Las Vegas" description={description}>
  <section class="container-page page-top" aria-labelledby="guides-heading">
    <h1 id="guides-heading" class="page-title">Rider guides</h1>
    <p class="page-lede">{description}</p>

    <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((guide) => (
          <li class="reveal">
            <a href={`/guides/${guide.id}`} class="guide-link group">
              <Icon name={guide.data.icon} class="guide-link__icon" aria-hidden="true" />
              <h2 class="guide-link__title">{guide.data.title}</h2>
              <p class="guide-link__summary">{guide.data.cardSummary}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-12 border-t border-outline-variant/15 pt-8">
      <a href="/go#places-to-go" class="body-link font-semibold">
        Where to go: step-by-step trips to seven places &#8594;
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .guide-link {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    height: 100%;
    padding: 1.25rem;
    color: var(--color-on-surface);
    background: var(--color-surface-container);
    border: 1px solid transparent;
    border-radius: 1rem;
    text-decoration: none;
    transition:
      border-color 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }
  .guide-link:hover,
  .guide-link:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .guide-link :global(.guide-link__icon) {
    grid-row: 1 / span 2;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.55rem;
    color: var(--color-primary-ink);
    background: var(--color-primary-soft);
    border-radius: 0.8rem;
  }
  .guide-link__title {
    font-size: 1.2rem;
    line-height: 1.25;
  }
  .guide-link:hover .guide-link__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .guide-link__summary {
    grid-column: 2;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  @media (min-width: 48rem) {
    .guide-link {
      grid-template-columns: 1fr;
      align-content: start;
      row-gap: 0.75rem;
      padding: 1.5rem;
    }
    .guide-link :global(.guide-link__icon) {
      grid-row: auto;
      margin-bottom: 0.25rem;
    }
    .guide-link__summary {
      grid-column: auto;
    }
    .guide-link__title {
      font-size: 1.35rem;
    }
  }
</style>
