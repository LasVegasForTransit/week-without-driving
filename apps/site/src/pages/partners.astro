---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { partners, contactEmail, joinMailto } from '../lib/partners';

// Partners, /partners: the organizations taking part, and how another
// group can join. Every partner comes from the roster in
// src/data/partners.ts; with none yet, the roster is left out entirely and
// the page opens with "Bring your organization".
//
// After the week ends (12:00 am October 9, 2026, Las Vegas time, by the
// phone's clock), /scripts/partners.js changes the roster heading to "Took
// part in 2026" and swaps "Bring your organization" for a note about next
// year. Without JavaScript the page keeps its during-the-week text.

const title = 'Partners · Week Without Driving Las Vegas';
const description =
  'Organizations across the Las Vegas Valley taking part in Week Without Driving, and how your group can join.';

const weWantToHear = [
  'Disability and senior advocates',
  'Student groups and school clubs',
  'Neighborhood and community groups',
  'Environmental and justice groups',
  'Employers and businesses',
  'Public agencies, including the RTC',
];

const whatPartnersDo = [
  'Share the week with your members, staff or neighbors.',
  'Take a trip together, by bus, walking or rolling, biking, or getting a ride.',
  "Co-host a group walk, roll or ride during the week. We'll help plan the route.",
  'Hand out flyers or paper bingo cards at your meetings and events.',
];
---

<BaseLayout title={title} description={description}>
  <section class="container-page page-header pb-16">
    <h1 class="page-title">Partners</h1>

    {
      partners.length > 0 && (
        <div>
          <p class="page-lede">
            Groups across the Las Vegas Valley are bringing Week Without Driving to their members,
            neighbors, students and staff.
          </p>
          <h2 class="section-title mt-10" data-partners-roster-heading>
            Taking part in 2026
          </h2>
          <ul class="partner-roster">
            {partners.map((partner) => (
              <li>
                <h3 class="partner-roster__name">
                  {partner.url ? (
                    <a href={partner.url} class="body-link">
                      {partner.name}
                    </a>
                  ) : (
                    partner.name
                  )}
                </h3>
                <p class="partner-roster__type">{partner.type}</p>
                <p class="partner-roster__sentence">{partner.sentence}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="section mt-12" data-partners-ended hidden>
      <p class="section-intro">
        Week Without Driving 2026 has ended. Want to take part next year? Email <a
          href={`mailto:${contactEmail}`}
          data-print-url={contactEmail}
          class="body-link font-semibold">{contactEmail}</a
        > and we'll let you know when planning starts.
      </p>
    </div>

    <div class="section mt-12" data-partners-join>
      <h2 class="section-title">Bring your organization</h2>
      <p class="section-intro">
        Week Without Driving is for everyone who gets around Las Vegas without driving, and for the
        groups that stand with them. Partnering is free, and any size of group can join, from a
        block club to a big employer.
      </p>

      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <h3 class="text-title-lg">We'd love to hear from:</h3>
          <ul class="prose-doc mt-3">
            {weWantToHear.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-title-lg">What partners do. Pick any of these. There's no minimum.</h3>
          <ul class="prose-doc mt-3">
            {whatPartnersDo.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <p class="mt-10 max-w-2xl leading-relaxed text-pretty">
        You get your group's name on this page, your own link and QR code, banners and flyers to
        print, and an email after the week telling you how many people signed up through your link.
      </p>

      <div class="mt-10 max-w-2xl overflow-hidden rounded-2xl bg-surface-container p-6 md:p-8">
        <h3 class="text-title-lg">How to join</h3>
        <p class="mt-3 leading-relaxed text-pretty">
          Email {contactEmail} with your group's name, a link to your website or social media page if
          you have one, which kind of group you are, and one sentence on how you'll take part. We reply
          within 3 days and add you to this page.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href={joinMailto}
            data-print-url={contactEmail}
            class="press inline-flex min-h-11 items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
          >
            <Icon name="mdi:email-outline" class="size-5" aria-hidden="true" />
            Email us to join
          </a>
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">{contactEmail}</span>
            {/* Shown by /scripts/partners.js; the address stays visible as text without it. */}
            <button
              type="button"
              class="press inline-flex min-h-11 min-w-11 items-center gap-1.5 border border-outline px-3 py-2 text-sm font-semibold"
              data-copy-text={contactEmail}
              aria-describedby="join-copy-status"
              hidden
            >
              <Icon name="mdi:content-copy" class="size-4" aria-hidden="true" />
              <span data-copy-label>Copy email address</span>
            </button>
          </div>
        </div>
        <p id="join-copy-status" class="mt-2 text-sm font-semibold" role="status"></p>
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/partners.js" defer></script>
</BaseLayout>

<style>
  .partner-roster {
    display: grid;
    gap: 2rem 2.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .partner-roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .partner-roster__name {
    font-size: var(--text-title-lg);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .partner-roster__type {
    margin-top: 0.25rem;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }
  .partner-roster__sentence {
    margin-top: 0.25rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  [data-partners-ended][hidden],
  [data-partners-join][hidden] {
    display: none;
  }
</style>
