---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerKit from '../components/PartnerKit.astro';
import { Icon } from 'astro-icon/components';
import { partners, contactEmail, joinMailto } from '../lib/partners';

// Partners, /partners: the organizations taking part, how another group
// can join, and the partner kit. Every partner comes from the roster in
// src/data/partners.ts; with none yet, the roster is left out entirely and
// the page opens with "Bring your organization".
//
// After the week ends (12:00 am October 9, 2026, Las Vegas time, by the
// phone's clock), /scripts/partners.js swaps "Bring your organization" for
// a note about next year. Without JavaScript the page keeps its
// during-the-week text.

const title = 'Partners · Week Without Driving Las Vegas';
const description = 'Meet the groups taking part and find materials to share.';

const weWantToHear = [
  'Disability and senior advocates',
  'Student groups and school clubs',
  'Neighborhood and community groups',
  'Environmental and justice groups',
  'Employers and businesses',
  'Public agencies',
];

const whatPartnersDo = [
  'Share the week with your members, staff or neighbors.',
  'Take a trip together, by bus, walking or rolling, biking, or getting a ride.',
  'Co-host a group walk, roll or ride during the week.',
  'Hand out flyers or paper bingo cards at your meetings and events.',
];
---

<BaseLayout title={title} description={description}>
  <div class="container-page page-header partners-page pb-16">
    <div class="partners-hero">
      <h1 class="page-title">Partners</h1>
      <p class="partners-hero__lede">
        Meet local partners and find materials to share Week Without Driving.
      </p>
      <div class="partners-hero__actions">
        <a href="#partner-kit" class="partners-hero__primary">Get materials</a>
        <a href={joinMailto} class="partners-hero__secondary">Become a partner</a>
      </div>
    </div>

    {
      partners.length > 0 && (
        <section class="partner-roster-section" aria-label="Partner organizations">
          <ul class="partner-roster">
            {partners.map((partner) => (
              <li id={`partner-${partner.slug}`}>
                <a
                  class="partner-roster__card"
                  href={partner.url}
                  aria-labelledby={`partner-name-${partner.slug}`}
                  data-external-icon="false"
                >
                  <h2 id={`partner-name-${partner.slug}`} class="partner-roster__name">
                    {partner.name}
                    {partner.url && (
                      <Icon name="mdi:open-in-new" class="size-5" aria-hidden="true" />
                    )}
                  </h2>
                  <div class="partner-roster__mark">
                    {partner.logo && (
                      <img class="partner-roster__logo" src={partner.logo} alt="" loading="lazy" />
                    )}
                  </div>
                  <p class="partner-roster__type">{partner.type}</p>
                  <p class="partner-roster__sentence">{partner.sentence}</p>
                </a>
              </li>
            ))}
          </ul>
          <p class="partner-roster__mark-note">
            RTC and its logo are trademarks of the Regional Transportation Commission of Southern
            Nevada.
          </p>
        </section>
      )
    }

    <div class="section mt-12" data-partners-ended hidden>
      <p class="section-intro">
        Week Without Driving 2026 has ended. Want to take part next year? Email <a
          href={`mailto:${contactEmail}`}
          data-print-url={contactEmail}
          class="body-link font-semibold">{contactEmail}</a
        > and we'll let you know when planning starts.
      </p>
    </div>

    <div class="section mt-12 partners-join" data-partners-join>
      <h2 class="section-title">Bring your organization</h2>
      <p class="section-intro">Organizations of any size can join. There is no fee.</p>

      <div class="partners-join__grid">
        <div class="partners-join__card">
          <h3 class="text-title-lg">Who can join</h3>
          <ul class="partners-join__list">
            {weWantToHear.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="partners-join__card">
          <h3 class="text-title-lg">Ways to take part</h3>
          <ul class="partners-join__list">
            {whatPartnersDo.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="partners-join__contact">
        <h3 class="text-title-lg">How to join</h3>
        <p class="partners-join__instructions">
          Include your group's name, type, a website or social link if you have one, and how you'll
          take part.
        </p>
        <div class="partners-join__actions">
          <a
            href={joinMailto}
            data-print-url={contactEmail}
            class="press inline-flex min-h-11 items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
          >
            <Icon name="mdi:email-outline" class="size-5" aria-hidden="true" />
            Email us to join
          </a>
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">{contactEmail}</span>
            {/* Shown by /scripts/partners.js; the address stays visible as text without it. */}
            <button
              type="button"
              class="press inline-flex min-h-11 min-w-11 items-center gap-1.5 border border-outline px-3 py-2 text-sm font-semibold"
              data-copy-text={contactEmail}
              aria-describedby="join-copy-status"
              hidden
            >
              <Icon name="mdi:content-copy" class="size-4" aria-hidden="true" />
              <span data-copy-label>Copy email address</span>
            </button>
          </div>
        </div>
        <p id="join-copy-status" class="mt-2 text-sm font-semibold" role="status"></p>
      </div>
    </div>

    <PartnerKit />
  </div>

  <script is:inline src="/scripts/partners.js" defer></script>
  <script is:inline src="/scripts/partner-kit.js" defer></script>
</BaseLayout>

<style>
  .partners-page {
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
  }
  .partners-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-top: 0.5rem solid var(--color-primary-warm);
    border-radius: 0.75rem;
    background: var(--color-slab);
    color: var(--color-on-slab);
  }
  .partners-hero .page-title {
    max-width: 12ch;
  }
  .partners-hero__lede {
    grid-column: 1;
    max-width: 42rem;
    margin-top: 1rem;
    font-size: var(--text-body-lg);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .partners-hero__actions {
    display: flex;
    flex-wrap: wrap;
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    gap: 0.75rem;
  }
  .partners-hero__primary,
  .partners-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    font-weight: 700;
    text-decoration: none;
  }
  .partners-hero__primary,
  .partners-hero__secondary {
    border-radius: 0.5rem;
  }
  .partners-hero__primary {
    background: var(--color-primary-warm);
    color: var(--color-on-primary-warm);
  }
  .partners-hero__secondary {
    border: 2px solid currentcolor;
    color: var(--color-on-slab);
  }
  .partners-hero__primary:hover,
  .partners-hero__primary:focus-visible,
  .partners-hero__secondary:hover,
  .partners-hero__secondary:focus-visible {
    outline: 3px solid var(--color-on-slab);
    outline-offset: 3px;
  }
  .partners-join {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: 1.5rem;
    border-top: 0.375rem solid var(--color-primary-warm);
    background: var(--color-surface-container);
    border-radius: 0.75rem;
  }
  .partners-join > .section-intro {
    margin-top: 0.75rem;
  }
  .partners-join__grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .partners-join__card {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--color-outline);
    background: var(--color-surface);
    border-radius: 0.75rem;
  }
  .partners-join__list {
    margin-top: 1rem;
    padding-left: 1.4rem;
    list-style: disc;
    line-height: 1.5;
  }
  .partners-join__list li + li {
    margin-top: 0.55rem;
  }
  .partners-join__contact {
    margin-top: 1rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--color-outline);
    background: var(--color-surface);
    border-radius: 0.75rem;
  }
  .partners-join__instructions {
    max-width: 56rem;
    margin-top: 0.75rem;
    line-height: 1.55;
  }
  .partners-join__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .partner-roster-section {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .partner-roster {
    display: grid;
    gap: 1rem;
    margin-top: 0;
    padding: 0;
    list-style: none;
  }
  .partner-roster > li {
    min-width: 0;
  }
  .partner-roster__card {
    display: block;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    color: inherit;
    background: var(--color-surface-container);
    border-radius: 0.75rem;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }
  .partner-roster__card[href]:hover {
    background: color-mix(in srgb, var(--color-surface-container) 88%, var(--color-primary-warm));
    box-shadow: 0 0.5rem 1.5rem rgb(20 8 14 / 0.12);
  }
  .partner-roster__card[href]:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }
  @media (min-width: 48rem) {
    .partner-roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .partners-join__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .partner-roster__name {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-title-lg);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .partner-roster__name svg {
    flex: none;
  }
  .partner-roster__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    margin-top: 1rem;
  }
  .partner-roster__logo {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 6rem;
    object-fit: contain;
    object-position: center;
  }
  .partner-roster__type {
    margin-top: 1rem;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }
  .partner-roster__sentence {
    margin-top: 0.25rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .partner-roster__mark-note {
    margin-top: 1.5rem;
    font-size: var(--text-body-sm);
    color: var(--color-on-surface-variant);
  }
  @media (max-width: 47.999rem) {
    .partners-page {
      padding-top: 0;
    }
    .partners-hero {
      display: block;
      margin-inline: calc(-1 * var(--page-pad));
      padding-inline: var(--page-pad);
      border-radius: 0;
    }
    .partners-hero__actions {
      margin-top: 1.5rem;
    }
    .partners-join__card,
    .partners-join__contact {
      padding: 1.25rem 0 0;
      border: 0;
      border-top: 1px solid var(--color-outline);
      border-radius: 0;
      background: transparent;
    }
  }
  [data-partners-ended][hidden],
  [data-partners-join][hidden] {
    display: none;
  }
</style>
