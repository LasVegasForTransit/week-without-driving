---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { lvbt } from '../lib/site';
import { wwdResources } from '../lib/wwd';

// Resources: the national campaign's own material plus Las Vegas
// specifics, followed by "After the week". The link lists are sourced
// entirely from src/lib/wwd.ts so a new resource is a data change there,
// not a copy-edit here.

const title = 'Resources · Week Without Driving Las Vegas';
const description =
  'Local travel tools and national campaign resources for participants and organizers.';

const afterTheWeek = [
  {
    title: 'Tell us about your week',
    icon: 'mdi:message-text-outline',
    href: 'mailto:wwd@lasvegasfortransit.org',
    action: 'Share your story',
    body: 'What worked? What got in the way? Send us a story or photo from your trips. We ask permission before sharing it.',
  },
  {
    title: 'Plan another trip',
    icon: 'mdi:routes',
    href: '/go',
    action: 'Plan a trip',
    body: 'Find a nearby bus stop or a step-by-step outing. Check RTC for current routes, fares and stop closures before you travel.',
  },
  {
    title: 'Stay with LVBT',
    icon: 'mdi:hand-heart-outline',
    href: lvbt.joinUrl,
    action: 'Join LVBT',
    body: 'Las Vegans for Better Transit works year-round for better buses and safer streets in the valley.',
  },
];
---

<BaseLayout title={title} description={description}>
  {/* RESOURCES — the national campaign's material and local tools */}
  <section class="container-page page-top" aria-labelledby="resources-heading">
    <div>
      <h1 id="resources-heading" class="page-title">Resources</h1>
      <p class="page-lede">
        Local travel tools and national campaign resources for participants and organizers.
      </p>
    </div>
    <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
      {
        (
          [
            ['participants', 'For participants'],
            ['organizations', 'For organizations'],
          ] as const
        ).map(([audience, heading]) => (
          <div class="reveal">
            <h2 class="resource-heading text-title-lg">{heading}</h2>
            <ul class="resource-cards">
              {wwdResources
                .filter((r) => r.audience === audience)
                .map((r) => (
                  <li>
                    <a
                      href={r.url}
                      data-print-url={r.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="resource-card group"
                      data-external-icon="false"
                    >
                      <span class="block font-semibold transition-colors group-hover:text-primary-ink group-focus-visible:text-primary-ink">
                        {r.title}
                      </span>
                      <span class="mt-1 block text-body-sm leading-relaxed text-on-surface-variant text-pretty">
                        {r.blurb}
                      </span>
                      <span class="resource-card__destination">
                        {r.linkLabel}
                        <Icon name="mdi:open-in-new" class="size-3.5" aria-hidden="true" />
                      </span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {/* AFTER THE WEEK */}
  <section class="container-page section" aria-labelledby="after">
    <div class="reveal max-w-3xl">
      <h2 id="after" class="text-headline-lg">After the week</h2>
      <p class="lede mt-4">
        Put what you noticed into practice, on your next trip or in your community.
      </p>
    </div>
    <div class="reveal-stagger mt-10 grid gap-8 md:grid-cols-3">
      {
        afterTheWeek.map((item) => (
          <div class="reveal resource-next">
            <Icon name={item.icon} class="resource-next__icon" aria-hidden="true" />
            <h3 class="text-title-lg">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-on-surface-variant text-pretty">{item.body}</p>
            <a href={item.href} class="resource-next__action body-link">
              {item.action} <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>
    <p class="reveal mt-10 leading-relaxed">
      For the local campaign’s background and goals,{' '}
      <a
        href={lvbt.projectPageUrl}
        data-print-url={lvbt.projectPageUrl}
        class="body-link font-semibold"
      >
        read LVBT’s project page &#8594;
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .resource-heading {
    margin-bottom: 1rem;
  }
  .resource-cards {
    display: grid;
    gap: 0.75rem;
  }
  .resource-card {
    display: block;
    height: 100%;
    padding: 1.25rem;
    color: var(--color-on-surface);
    background: var(--color-surface-container);
    border: 1px solid transparent;
    border-radius: 1rem;
    text-decoration: none;
  }
  .resource-card:hover,
  .resource-card:focus-visible {
    border-color: var(--color-primary);
  }
  .resource-card__destination {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-ink);
    overflow-wrap: anywhere;
  }
  .resource-card__destination :global(svg) {
    flex: none;
  }
  .resource-next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .resource-next :global(.resource-next__icon) {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.55rem;
    margin-bottom: 1rem;
    color: var(--color-primary-ink);
    background: var(--color-primary-soft);
    border-radius: 0.8rem;
  }
  .resource-next__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 600;
  }
</style>
