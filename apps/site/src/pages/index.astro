---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import PhotoSlot from '../components/PhotoSlot.astro';
import { photos } from '../lib/photos';
import { lvbt, site } from '../lib/site';
import { wwd } from '../lib/wwd';
import { days, proclamations } from '../lib/campaign';
import { partners } from '../lib/partners';
import KeepGoingCard from '../components/KeepGoingCard.astro';
import { STAY_INVOLVED } from '../lib/newsletter';

const dateRange = `October 1 to 8, ${wwd.year}`;
const canonical = `${site.url}/`;

const description = site.description;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SocialEvent',
  '@id': `${canonical}#event`,
  name: `Week Without Driving ${wwd.year} in Las Vegas`,
  description: `Week Without Driving brought Las Vegans together to get around without driving, ${dateRange}.`,
  startDate: wwd.startDate,
  endDate: wwd.endDate,
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Las Vegas Valley',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Las Vegas',
      addressRegion: 'NV',
      addressCountry: 'US',
    },
  },
  isAccessibleForFree: true,
  organizer: {
    '@type': 'Organization',
    '@id': `${lvbt.url}/#organization`,
    name: lvbt.name,
    url: lvbt.url,
  },
  url: canonical,
  mainEntityOfPage: canonical,
};

// Sections for content LVBT confirms over time (daily hosts, partners,
// proclamations) show only once there is something real to show.
const hasHosts = days.some((d) => d.host !== null);
const issued = proclamations.filter((p) => p.url !== null);

const leaderMailto = `mailto:wwd@lasvegasfortransit.org?subject=${encodeURIComponent(
  'Week Without Driving: elected leaders and agencies',
)}`;
---

<BaseLayout title={`${site.name} · See you in 2027`} description={description}>
  <StructuredData slot="head" data={eventSchema} />
  {/* Old one-page links like /#giveaway: runs before the page shows, so it can't wait. */}
  <script is:inline slot="head" src="/scripts/old-links.js"></script>

  {/* HERO: what it is, when, and one button. */}
  <section class="home-hero" aria-labelledby="hero-heading">
    <PhotoSlot
      class="home-hero__photo"
      shows="Las Vegans of all ages waiting together at a bus stop"
      photo={photos.deuceView}
      quiet
      eager
    />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="container-page home-hero__content">
      <p class="home-hero__when">
        <Icon name="mdi:calendar-blank" class="size-5" aria-hidden="true" />
        2026 wrapped up · Las Vegas
      </p>
      <h1 id="hero-heading" class="home-hero__title">Thanks for a great Week Without Driving.</h1>
      <p class="home-hero__sub">
        Our 2026 week has wrapped up. Thank you to everyone who took the bus, walked, rolled, biked
        or shared a ride. We’ll see you in 2027!
      </p>
      <div class="home-hero__actions">
        <a href="#stay-involved" class="btn btn--primary btn--big" data-stay-involved-link
          >Stay involved with LVBT</a
        >
        <a href="/guides" class="btn btn--ghost">Read the rider guides</a>
      </div>
    </div>
  </section>

  {/* WHY: one number, then who it stands for. */}
  <section class="home-why" aria-labelledby="why-heading">
    <div class="container-page home-why__grid">
      <h2 id="why-heading" class="home-why__stat">
        <span class="home-why__big">1 in 3</span>
        <span class="home-why__label">people in the U.S. don’t drive.</span>
      </h2>
      <div class="home-why__body">
        <p>
          They’re kids and grandparents. They’re people with disabilities, and neighbors who can’t
          afford a car.
        </p>
        <p><strong>The week is over. The need for better ways to get around isn’t.</strong></p>
        <a
          href="https://weekwithoutdriving.org/resource/"
          class="home-link"
          target="_blank"
          rel="noopener noreferrer">Where the 1 in 3 figure comes from</a
        >
        <a href={`${lvbt.url}/about`} class="home-link">Why we do this</a>
      </div>
    </div>
  </section>

  {/* EVERY DAY: who hosts our Instagram each day, once hosts are confirmed. */}
  {
    hasHosts && (
      <section class="home-days" aria-labelledby="days-heading">
        <div class="container-page">
          <h2 id="days-heading" class="home-h2">
            A look back at the week
          </h2>
          <p class="home-intro">
            During the week, Las Vegans shared how they got around on our Instagram.
          </p>
          <ol class="home-days__list">
            {days.map((d) => (
              <li class="home-day">
                <p class="home-day__num">Day {d.number}</p>
                <p class="home-day__date">
                  <span>{d.weekday}</span>
                  {d.monthDay}
                </p>
                {d.host && <p class="home-day__host">{d.host}</p>}
              </li>
            ))}
          </ol>
          <a href={lvbt.instagramUrl} target="_blank" rel="noopener noreferrer" class="home-link">
            Follow @lasvegasfortransit
          </a>
        </div>
      </section>
    )
  }

  {/* PARTNERS */}
  <section class="home-section home-partners" aria-labelledby="partners-heading">
    <div class="container-page">
      <h2 id="partners-heading" class="home-h2">Partners</h2>
      <p class="home-intro">
        Thank you to the organizations that joined us for Week Without Driving 2026.
      </p>
      {
        partners.length > 0 && (
          <ul
            class:list={['logo-wall', { 'logo-wall--compact': partners.length <= 2 }]}
            aria-label="Partner organizations"
          >
            {partners.map((p) => (
              <li class="logo-wall__tile">
                <a href={`/partners#partner-${p.slug}`}>
                  {p.logo ? <img src={p.logo} alt={p.name} loading="lazy" /> : p.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="home-partners__action">
        <a href="/partners" class="btn btn--primary">Meet our partners</a>
      </div>
    </div>
  </section>

  {/* LEADERS: proclamations from our cities and the county. */}
  <section class="home-leaders" aria-labelledby="leaders-heading">
    <div class="container-page">
      <h2 id="leaders-heading" class="home-h2">
        {issued.length > 0 ? 'Local leaders' : 'Leaders take the challenge too'}
      </h2>
      <p class="home-intro">
        {
          issued.length > 0
            ? 'Cities and the county that recognized October 1–8, 2026 as Week Without Driving.'
            : 'Elected leaders across the country spend the week without driving to see their city the way their constituents do.'
        }
      </p>
      {
        issued.length > 0 && (
          <ul class="home-seals">
            {issued.map((p) => (
              <li class="home-seal">
                <span class="home-seal__mark" aria-hidden="true">
                  <Icon name="mdi:bank-outline" class="size-7" />
                </span>
                <p class="home-seal__gov">{p.government}</p>
                <a href={p.url ?? '#'} class="home-link">
                  Read the proclamation
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="home-leader-ask">
        <blockquote>
          <p>
            “I’m learning so much about how to better represent my constituents who don’t drive.”
          </p>
          <footer>Analise Ortiz, Arizona State Senator, on her Week Without Driving</footer>
        </blockquote>
        <div>
          <p class="home-leader-ask__q">Are you an elected leader or a public agency?</p>
          <a href={leaderMailto} class="home-link">Talk with us about 2027</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-farewell" aria-labelledby="farewell-heading">
    <div class="container-page">
      <div class="home-farewell__panel">
        <div class="home-farewell__intro">
          <p class="home-farewell__note">Thank you, Las Vegas.</p>
          <h2 id="farewell-heading" class="home-farewell__title">See you in <span>2027.</span></h2>
          <a href="/go" class="home-farewell__trip"
            >Plan your next trip <span aria-hidden="true">↗</span></a
          >
        </div>
        <KeepGoingCard
          id="stay-involved"
          heading={STAY_INVOLVED.heading}
          text={STAY_INVOLVED.text}
          source="home"
        />
        <p class="home-farewell__contact">
          Questions? <a href="mailto:wwd@lasvegasfortransit.org">wwd@lasvegasfortransit.org</a>
        </p>
      </div>
    </div>
  </section>
  <script is:inline type="module" src="/modules/keep-going.js"></script>
</BaseLayout>

<style>
  .btn--ghost {
    color: #fff;
    border: 2px solid rgb(255 255 255 / 0.85);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: #fff;
    color: #111;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-weight: 700;
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-link::after {
    content: '→';
  }

  /* Hero */
  /* The hero is always a dark photo under a dark shade, in both themes, so
     its text and ghost button are fixed white. */
  .home-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(80svh, 42rem);
    color: #fff;
    background: #152b36;
  }
  .home-hero :global(.home-hero__photo) {
    position: absolute;
    inset: 0;
    background: #152b36;
  }
  /* The photo is taken from the Deuce's top deck: show the Strip ahead,
     not the bus's ceiling. */
  .home-hero :global(.home-hero__photo img) {
    object-position: center 60%;
  }
  .home-hero :global(.home-hero__photo[data-photo-unavailable] img),
  .home-hero :global(.home-hero__photo[data-photo-unavailable] .photo__credit) {
    display: none;
  }
  .home-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 12 14 / 0.9) 0%,
      rgb(10 12 14 / 0.6) 50%,
      rgb(10 12 14 / 0.1) 85%
    );
  }
  .home-hero__content {
    position: relative;
    width: 100%;
    padding-block: 2.5rem 3rem;
  }
  .home-hero__when {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    font-weight: 700;
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
    border-radius: 999px;
  }
  .home-hero__title {
    margin-top: 1rem;
    max-width: 18ch;
    font-size: clamp(2.6rem, 8vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .home-hero__sub {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: clamp(1.1rem, 3.8vw, 1.3rem);
    line-height: 1.45;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Shared section rhythm */
  .home-section {
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }
  .home-h2 {
    font-size: clamp(1.9rem, 6vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .home-intro {
    margin-top: 0.75rem;
    max-width: 36rem;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .home-split {
    display: grid;
    gap: 1.25rem;
  }

  /* Why */
  .home-why {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    color: var(--color-on-slab);
    background: var(--color-slab);
  }
  .home-why__grid {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  .home-why__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .home-why__big {
    font-size: clamp(5rem, 22vw, 10rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-on-slab-accent);
  }
  .home-why__label {
    font-size: clamp(1.6rem, 5.5vw, 2.4rem);
    line-height: 1.1;
  }
  .home-why__body {
    max-width: 32rem;
    font-size: clamp(1.1rem, 3.8vw, 1.3rem);
    line-height: 1.55;
  }
  .home-why__body p + p {
    margin-top: 1rem;
  }
  .home-why .home-link {
    color: var(--color-on-slab);
  }

  /* Every day */
  .home-days {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    background: var(--color-surface-container);
  }
  .home-days__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(10.5rem, 1fr);
    gap: 0.75rem;
    margin-block: 2rem 0.5rem;
    padding-bottom: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .home-day {
    scroll-snap-align: start;
    padding: 1rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    border-top: 5px solid var(--color-primary);
  }
  .home-day__num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-ink);
  }
  .home-day__date {
    display: flex;
    flex-direction: column;
    margin-top: 0.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.05;
  }
  .home-day__date span {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-on-surface-variant);
  }
  .home-day__host {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  /* Partner wall */
  .home-partners {
    background: var(--color-surface-container);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .home-partners__action {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    .home-partners > .container-page {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1.5rem;
    }
    .home-partners .home-h2,
    .home-partners .home-intro {
      grid-column: 1;
    }
    .home-partners__action {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      margin-top: 0;
    }
    .logo-wall {
      grid-column: 1 / -1;
    }
  }
  .logo-wall {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0.25rem 0 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
  }
  .logo-wall__tile {
    flex: 0 0 clamp(12rem, 32vw, 17rem);
    min-height: 8rem;
    font-weight: 700;
    text-align: center;
    background: var(--color-surface);
    border-radius: 0.75rem;
    scroll-snap-align: start;
  }
  .logo-wall--compact {
    justify-content: center;
    overflow: visible;
  }
  .logo-wall--compact .logo-wall__tile {
    flex: 1 1 0;
    max-width: 22rem;
  }
  .logo-wall__tile > a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    padding: 1.25rem;
    color: inherit;
    border-radius: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .logo-wall__tile img {
    display: block;
    width: 100%;
    max-height: 5.5rem;
    object-fit: contain;
  }
  .logo-wall__tile > a:focus-visible {
    outline: 3px solid var(--color-primary-warm);
    outline-offset: 3px;
  }
  @media (max-width: 40rem) {
    .home-partners__action .btn {
      width: 100%;
    }
    .logo-wall {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
      gap: 0.75rem;
    }
    .logo-wall__tile {
      min-width: 0;
      font-size: 0.875rem;
    }
    .logo-wall__tile > a {
      padding: 0.75rem;
    }
  }
  /* Leaders */
  .home-leaders {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 12%, transparent);
  }
  .home-seals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .home-seal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.1rem;
    border: 2px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
    border-radius: 0.75rem;
  }
  .home-seal__mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--color-primary-ink);
    background: var(--color-primary-soft);
    border-radius: 50%;
  }
  .home-seal__gov {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .home-seal .home-link {
    margin-top: 0;
  }
  .home-leader-ask {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .home-leader-ask blockquote p {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.3rem, 4.5vw, 1.7rem);
    line-height: 1.3;
  }
  .home-leader-ask footer {
    margin-top: 0.6rem;
    color: var(--color-on-surface-variant);
  }
  .home-leader-ask__q {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .home-leader-ask .home-link {
    margin-top: 0.4rem;
  }

  .home-farewell {
    padding-block: 1rem clamp(2.5rem, 6vw, 5rem);
  }
  .home-farewell__panel {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    color: var(--color-on-slab);
    background: var(--color-slab);
    border-radius: 1.5rem;
  }
  .home-farewell__note {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-on-slab-variant);
  }
  .home-farewell__title {
    scroll-margin-top: 6rem;
    max-width: 12ch;
    font-size: clamp(2.75rem, 9vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .home-farewell__title span {
    color: var(--color-on-slab-accent);
  }
  .home-farewell__trip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    margin-top: 1rem;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .home-farewell__contact {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-slab) 22%, transparent);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-on-slab-variant);
    overflow-wrap: anywhere;
  }
  .home-farewell__contact a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 48rem) {
    .home-farewell__panel {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 6vw, 5rem);
    }
    .home-farewell__contact {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 47.99rem) {
    .home-section,
    .home-leaders,
    .home-why {
      padding-block: 2.75rem;
    }
    .home-hero__content {
      padding-block: 2.5rem;
    }
    .home-hero__title {
      font-size: clamp(2.5rem, 9.5vw, 4.5rem);
      line-height: 1.05;
    }
    .home-hero__sub {
      font-size: 1.0625rem;
      line-height: 1.6;
    }
    .home-hero__actions {
      gap: 0.625rem;
    }
    .home-hero__actions .btn {
      min-height: 52px;
      padding-inline: 1.25rem;
      font-size: 1rem;
    }
    .home-intro {
      font-size: 1.0625rem;
    }
  }

  @media (min-width: 48rem) {
    .home-seals {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .home-leader-ask {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
      column-gap: 3rem;
    }
  }
  @media (min-width: 64rem) {
    .home-hero {
      min-height: 40rem;
    }
    .home-why__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
    }
    .home-split {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .home-days__list {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-flow: row;
      overflow: visible;
    }
  }
</style>
