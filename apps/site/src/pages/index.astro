---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import PhotoSlot from '../components/PhotoSlot.astro';
import { photos } from '../lib/photos';
import { lvbt, site } from '../lib/site';
import { wwd } from '../lib/wwd';
import { days, prizes, proclamations } from '../lib/campaign';
import { partners } from '../lib/partners';

// The Home page, for someone who has five seconds: what the week is, when
// it is, and one button. Below that, the three steps, why it matters, the
// prizes, the daily Instagram hosts, the partner wall and the local
// proclamations. Slots for content LVBT hasn't confirmed yet (photos,
// hosts, partners, proclamations) are marked "to come" and fill from
// src/lib/campaign.ts and src/lib/partners.ts.

const dateRange = `October 1 to 8, ${wwd.year}`;
const canonical = `${site.url}/`;

const description = `Try getting around Las Vegas without driving, ${dateRange}. Anyone can take part. Sign up to win a one-month RTC bus pass.`;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SocialEvent',
  '@id': `${canonical}#event`,
  name: `Week Without Driving ${wwd.year} in Las Vegas`,
  description,
  startDate: wwd.startDate,
  endDate: wwd.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Las Vegas Valley',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Las Vegas',
      addressRegion: 'NV',
      addressCountry: 'US',
    },
  },
  isAccessibleForFree: true,
  organizer: {
    '@type': 'Organization',
    '@id': `${lvbt.url}/#organization`,
    name: lvbt.name,
    url: lvbt.url,
  },
  superEvent: {
    '@type': 'Event',
    name: `Week Without Driving ${wwd.year}`,
    url: wwd.nationalUrl,
    startDate: wwd.startDate,
    endDate: wwd.endDate,
  },
  url: canonical,
  mainEntityOfPage: canonical,
};

// The three steps, drawn as stops on a bus line because they happen in
// this order.
const steps = [
  {
    icon: 'mdi:account-plus-outline',
    title: 'Sign up',
    body: 'It takes a minute. All you need is a phone number or an email.',
    cta: 'Sign up to win',
    href: '/sign-up',
  },
  {
    icon: 'mdi:bus',
    title: 'Make the trip',
    body: 'Take the bus, walk, roll, bike or get a ride. We’ll help you plan it.',
    cta: 'Find a bus near you',
    href: '/go',
  },
  {
    icon: 'mdi:calendar-check-outline',
    title: 'Check in each day',
    body: 'Tap Check in on My week, October 1–8. Each day you check in is one entry to win.',
    cta: 'See the prizes',
    href: '/giveaway',
  },
] as const;

// The partner wall shows every confirmed partner, then open tiles up to a
// full row of eight, so there is always a visible place to join.
const WALL_SIZE = 8;
const openTiles = Math.max(WALL_SIZE - partners.length, 2);

const leaderMailto = `mailto:wwd@lasvegasfortransit.org?subject=${encodeURIComponent(
  'Week Without Driving: elected leaders and agencies',
)}`;
---

<BaseLayout title={`${site.name} · ${dateRange}`} description={description}>
  <StructuredData slot="head" data={eventSchema} />

  {/* HERO: what it is, when, and one button. */}
  <section class="home-hero" aria-labelledby="hero-heading">
    <PhotoSlot
      class="home-hero__photo"
      shows="Las Vegans of all ages waiting together at a bus stop"
      photo={photos.deuceView}
      quiet
      eager
    />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="container-page home-hero__content">
      <p class="home-hero__when">
        <Icon name="mdi:calendar-blank" class="size-5" aria-hidden="true" />
        October 1–8, {wwd.year} · Las Vegas
      </p>
      <h1 id="hero-heading" class="home-hero__title">Try a week without driving.</h1>
      <p class="home-hero__sub">
        Take the bus, walk, bike or get a ride. Anyone can take part. Sign up with us to win a free
        month of bus rides.
      </p>
      <div class="home-hero__actions">
        <a href="/sign-up" class="btn btn--primary btn--big" data-signup-link>
          <span data-signup-label>Sign up to win</span>
        </a>
        <a href="#how" class="btn btn--ghost">How it works</a>
      </div>
    </div>
  </section>

  {/* HOW IT WORKS: three stops on one line. */}
  <section id="how" class="home-section scroll-mt-20" aria-labelledby="how-heading">
    <div class="container-page">
      <h2 id="how-heading" class="home-h2">How it works</h2>
      <ol class="route">
        {
          steps.map((s, i) => (
            <li class="route__stop">
              <span class="route__dot" aria-hidden="true">
                <Icon name={s.icon} class="route__icon" />
              </span>
              <div class="route__text">
                <p class="route__num">Step {i + 1}</p>
                <h3 class="route__title">{s.title}</h3>
                <p class="route__body">{s.body}</p>
                <a href={s.href} class="home-link">
                  {s.cta}
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* WHY: one number, then who it stands for. */}
  <section class="home-why" aria-labelledby="why-heading">
    <div class="container-page home-why__grid">
      <h2 id="why-heading" class="home-why__stat">
        <span class="home-why__big">1 in 3</span>
        <span class="home-why__label">people in the U.S. don’t drive.</span>
      </h2>
      <div class="home-why__body">
        <p>
          They’re kids and grandparents. They’re people with disabilities, and neighbors who can’t
          afford a car.
        </p>
        <p><strong>For one week, get around Las Vegas the way they do.</strong></p>
        <a href={`${lvbt.url}/about`} class="home-link">Why we do this</a>
      </div>
    </div>
  </section>

  {/* PRIZES */}
  <section class="home-section" aria-labelledby="prizes-heading">
    <div class="container-page home-prizes">
      <div>
        <h2 id="prizes-heading" class="home-h2">Check in every day. Win prizes.</h2>
        <p class="home-intro">
          Sign up, then check in each day from October 1 to 8. Each check-in is one entry, up to{
            ' '
          }
          {wwd.maxEntries}. No purchase or post necessary.
        </p>
        <div class="home-actions">
          <a href="/sign-up" class="btn btn--primary" data-signup-link>
            <span data-signup-label>Sign up to win</span>
          </a>
          <a href="/giveaway" class="btn btn--outline">How to win</a>
        </div>
      </div>
      <ul class="home-prizes__list">
        {
          prizes.map((p) => (
            <li class="home-prize">
              <PhotoSlot
                class="home-prize__photo"
                shows={p.photo}
                photo={p.image}
                sizes="(min-width: 64rem) 25vw, 50vw"
              />
              <h3 class="home-prize__name">{p.name}</h3>
              <p class="home-prize__body">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* EVERY DAY: who hosts our Instagram each day of the week. */}
  <section class="home-days" aria-labelledby="days-heading">
    <div class="container-page">
      <h2 id="days-heading" class="home-h2">Follow along every day</h2>
      <p class="home-intro">
        Each day, a different Las Vegan takes over our Instagram and shows how they got around.
      </p>
      <ol class="home-days__list">
        {
          days.map((d) => (
            <li class="home-day">
              <p class="home-day__num">Day {d.number}</p>
              <p class="home-day__date">
                <span>{d.weekday}</span>
                {d.monthDay}
              </p>
              <p class="home-day__host">{d.host ?? <span class="to-come">Host to come</span>}</p>
            </li>
          ))
        }
      </ol>
      <a href={lvbt.instagramUrl} target="_blank" rel="noopener noreferrer" class="home-link">
        Follow @lasvegasfortransit
      </a>
    </div>
  </section>

  {/* PARTNERS: the groups bringing the week to their people. */}
  <section class="home-section" aria-labelledby="partners-heading">
    <div class="container-page">
      <div class="home-split">
        <div>
          <h2 id="partners-heading" class="home-h2">Groups taking part</h2>
          <p class="home-intro">
            Workplaces, schools, churches, clubs and neighborhood groups are bringing the week to
            their people. We give you flyers, posts and a link for your members.
          </p>
        </div>
        <a href="/partners" class="btn btn--primary self-start">Bring your group</a>
      </div>
      <ul class="logo-wall" aria-label="Partner organizations">
        {
          partners.map((p) => (
            <li class="logo-wall__tile">
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.name}
                </a>
              ) : (
                p.name
              )}
            </li>
          ))
        }
        {
          Array.from({ length: openTiles }, () => (
            <li class="logo-wall__tile logo-wall__tile--open">
              <a href="/partners">
                <Icon name="mdi:plus" class="size-6" aria-hidden="true" />
                Your group here
              </a>
            </li>
          ))
        }
      </ul>
      <p class="home-national">
        Part of the national{' '}
        <a href={wwd.nationalUrl} target="_blank" rel="noopener noreferrer" class="body-link"
          >Week Without Driving</a
        >, led by America Walks and the Nondrivers Alliance.
      </p>
    </div>
  </section>

  {/* LEADERS: proclamations from our cities and the county. */}
  <section class="home-leaders" aria-labelledby="leaders-heading">
    <div class="container-page">
      <h2 id="leaders-heading" class="home-h2">Local leaders</h2>
      <p class="home-intro">
        Cities and the county recognizing October 1–8 as Week Without Driving.
      </p>
      <ul class="home-seals">
        {
          proclamations.map((p) => (
            <li class="home-seal">
              <span class="home-seal__mark" aria-hidden="true">
                <Icon name="mdi:bank-outline" class="size-7" />
              </span>
              <p class="home-seal__gov">{p.government}</p>
              {p.url ? (
                <a href={p.url} class="home-link">
                  Read the proclamation
                </a>
              ) : (
                <p class="to-come">To come</p>
              )}
            </li>
          ))
        }
      </ul>
      <div class="home-leader-ask">
        <blockquote>
          <p>
            “I’m learning so much about how to better represent my constituents who don’t drive.”
          </p>
          <footer>Analise Ortiz, Arizona State Senator, on her Week Without Driving</footer>
        </blockquote>
        <div>
          <p class="home-leader-ask__q">Are you an elected leader or a public agency?</p>
          <a href={leaderMailto} class="home-link">Take the challenge with your staff</a>
        </div>
      </div>
    </div>
  </section>

  {/* LAST CALL */}
  <section class="home-final" aria-labelledby="final-heading">
    <div class="container-page home-final__inner">
      <h2 id="final-heading" class="home-final__title">Try it this October.</h2>
      <a href="/sign-up" class="btn btn--light btn--big" data-signup-link>
        <span data-signup-label>Sign up to win</span>
      </a>
      <p class="home-final__help">
        Questions? Email <a href="mailto:wwd@lasvegasfortransit.org">wwd@lasvegasfortransit.org</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .btn--ghost {
    color: #fff;
    border: 2px solid rgb(255 255 255 / 0.85);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: #fff;
    color: #111;
  }
  .btn--light {
    color: var(--color-primary);
    background: var(--color-on-primary);
  }
  .btn--light:hover,
  .btn--light:focus-visible {
    color: var(--color-on-primary-container);
    background: var(--color-primary-container);
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-weight: 800;
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-link::after {
    content: '→';
  }

  /* Hero */
  /* The hero is always a dark photo under a dark shade, in both themes, so
     its text and ghost button are fixed white. */
  .home-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(80svh, 42rem);
    color: #fff;
  }
  .home-hero :global(.home-hero__photo) {
    position: absolute;
    inset: 0;
  }
  /* The photo is taken from the Deuce's top deck: show the Strip ahead,
     not the bus's ceiling. */
  .home-hero :global(.home-hero__photo img) {
    object-position: center 60%;
  }
  .home-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 12 14 / 0.9) 0%,
      rgb(10 12 14 / 0.6) 50%,
      rgb(10 12 14 / 0.1) 85%
    );
  }
  .home-hero__content {
    position: relative;
    width: 100%;
    padding-block: 2.5rem 3rem;
  }
  .home-hero__when {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    font-weight: 800;
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
    border-radius: 999px;
  }
  .home-hero__title {
    margin-top: 1rem;
    max-width: 14ch;
    font-size: clamp(2.6rem, 10vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .home-hero__sub {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: clamp(1.1rem, 3.8vw, 1.3rem);
    line-height: 1.45;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Shared section rhythm */
  .home-section {
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }
  .home-h2 {
    font-size: clamp(1.9rem, 6vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .home-intro {
    margin-top: 0.75rem;
    max-width: 36rem;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .home-split {
    display: grid;
    gap: 1.25rem;
  }

  /* How it works: three stops on a route line. */
  .route {
    --dot: 4rem;
    position: relative;
    display: grid;
    gap: 2rem;
    margin-top: 2.25rem;
  }
  .route::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2);
    bottom: calc(var(--dot) / 2);
    left: calc(var(--dot) / 2 - 3px);
    width: 6px;
    background: var(--color-primary);
    border-radius: 3px;
  }
  .route__stop {
    position: relative;
    display: grid;
    grid-template-columns: var(--dot) 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .route__dot {
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    color: var(--color-primary-ink);
    background: var(--color-surface);
    border: 6px solid var(--color-primary);
    border-radius: 50%;
  }
  .route__dot :global(.route__icon) {
    width: 1.9rem;
    height: 1.9rem;
  }
  .route__num {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-ink);
  }
  .route__title {
    margin-top: 0.15rem;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
  }
  .route__body {
    margin-top: 0.35rem;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .route__text .home-link {
    margin-top: 0.6rem;
  }

  /* Why */
  .home-why {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    color: var(--color-on-slab);
    background: var(--color-slab);
  }
  .home-why__grid {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  .home-why__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .home-why__big {
    font-size: clamp(5rem, 22vw, 10rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-on-slab-accent);
  }
  .home-why__label {
    font-size: clamp(1.6rem, 5.5vw, 2.4rem);
    line-height: 1.1;
  }
  .home-why__body {
    max-width: 32rem;
    font-size: clamp(1.1rem, 3.8vw, 1.3rem);
    line-height: 1.55;
  }
  .home-why__body p + p {
    margin-top: 1rem;
  }
  .home-why .home-link {
    color: var(--color-on-slab);
  }

  /* Prizes */
  .home-prizes {
    display: grid;
    gap: 2rem;
  }
  .home-prizes__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .home-prize :global(.home-prize__photo) {
    aspect-ratio: 1;
    border-radius: 0.75rem;
  }
  .home-prize__name {
    margin-top: 0.75rem;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .home-prize__body {
    margin-top: 0.25rem;
    color: var(--color-on-surface-variant);
  }

  /* Every day */
  .home-days {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    background: var(--color-surface-container);
  }
  .home-days__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(10.5rem, 1fr);
    gap: 0.75rem;
    margin-block: 2rem 0.5rem;
    padding-bottom: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .home-day {
    scroll-snap-align: start;
    padding: 1rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    border-top: 5px solid var(--color-primary);
  }
  .home-day__num {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-ink);
  }
  .home-day__date {
    display: flex;
    flex-direction: column;
    margin-top: 0.25rem;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.05;
  }
  .home-day__date span {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-on-surface-variant);
  }
  .home-day__host {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  /* Partner wall */
  .logo-wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .logo-wall__tile {
    display: grid;
    min-height: 6.5rem;
    font-weight: 800;
    text-align: center;
    background: var(--color-surface-container);
    border-radius: 0.75rem;
  }
  .logo-wall__tile > a,
  .logo-wall__tile:not(:has(a)) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }
  .logo-wall__tile--open {
    color: var(--color-on-surface-variant);
    background: transparent;
    border: 2px dashed color-mix(in srgb, var(--color-on-surface) 30%, transparent);
  }
  .logo-wall__tile--open:hover {
    color: var(--color-primary-ink);
    border-color: var(--color-primary);
  }
  /* Phones get one short column of open tiles, not a wall of them. */
  @media (max-width: 47.99rem) {
    .logo-wall__tile--open:nth-child(n + 5) {
      display: none;
    }
  }
  .home-national {
    margin-top: 1.5rem;
    color: var(--color-on-surface-variant);
  }

  /* Leaders */
  .home-leaders {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 12%, transparent);
  }
  .home-seals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .home-seal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.1rem;
    border: 2px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
    border-radius: 0.75rem;
  }
  .home-seal__mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--color-primary-ink);
    background: var(--color-primary-soft);
    border-radius: 50%;
  }
  .home-seal__gov {
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .home-seal .home-link {
    margin-top: 0;
  }
  .home-leader-ask {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .home-leader-ask blockquote p {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.3rem, 4.5vw, 1.7rem);
    line-height: 1.3;
  }
  .home-leader-ask footer {
    margin-top: 0.6rem;
    color: var(--color-on-surface-variant);
  }
  .home-leader-ask__q {
    font-size: 1.15rem;
    font-weight: 800;
  }
  .home-leader-ask .home-link {
    margin-top: 0.4rem;
  }

  /* Last call */
  .home-final {
    padding-block: clamp(3.5rem, 9vw, 5.5rem);
    color: var(--color-on-primary);
    background: var(--color-primary);
  }
  .home-final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .home-final__title {
