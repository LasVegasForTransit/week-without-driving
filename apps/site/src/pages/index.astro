---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import { lvbt, site } from '../lib/site';
import { wwd } from '../lib/wwd';

// The Home page: a short, warm welcome that speaks first to people who
// already get around without a car, then to people trying it for the
// first time. Full experience and copy: features/site/f-welcome.md.
// Everything the old one-page site explained at length now lives on the
// page that owns it (Take Part, Guides, Go, Bingo, Giveaway, Resources,
// Partners); Home only welcomes, orients, and points onward.

const dateRange = `October 1 to 8, ${wwd.year}`;
const canonical = `${site.url}/`;

const description = `However you get around, ${site.name} is for you, ${dateRange}. Pledge, plan a trip, and play transit bingo.`;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SocialEvent',
  '@id': `${canonical}#event`,
  name: `Week Without Driving ${wwd.year} in Las Vegas`,
  description,
  startDate: wwd.startDate,
  endDate: wwd.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Las Vegas Valley',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Las Vegas',
      addressRegion: 'NV',
      addressCountry: 'US',
    },
  },
  isAccessibleForFree: true,
  organizer: {
    '@type': 'Organization',
    '@id': `${lvbt.url}/#organization`,
    name: lvbt.name,
    url: lvbt.url,
  },
  superEvent: {
    '@type': 'Event',
    name: `Week Without Driving ${wwd.year}`,
    url: wwd.nationalUrl,
    startDate: wwd.startDate,
    endDate: wwd.endDate,
  },
  url: canonical,
  mainEntityOfPage: canonical,
};

// The hero's three sourced facts. Copy fixed by features/site/f-welcome.md.
// `source` is for maintainers and is not rendered.
const facts: Array<{ value: string; label: string; source: string; accent?: boolean }> = [
  {
    value: '1 in 3',
    label: 'people in the U.S. don’t drive',
    source: 'America Walks, weekwithoutdriving.org',
  },
  {
    value: '57.9M',
    label: 'bus trips a year on RTC',
    source: 'RTC ridership reports (key-facts.md)',
  },
  {
    value: '42%',
    label: 'of RTC bus service faces cuts by 2028',
    source: 'RTC letter to the Nevada Legislature, March 2026 (key-facts.md)',
    accent: true,
  },
];

// "Explore the week" cards, in the fixed order from f-welcome.md. Card text
// is copied exactly from the Feature's Copy table.
const exploreCards = [
  {
    href: '/take-part',
    icon: 'mdi:hand-heart-outline',
    title: 'Take Part',
    body: 'Pick One Trip, One Day or One Week, and see how the week works.',
  },
  {
    href: '/guides',
    icon: 'mdi:book-open-variant-outline',
    title: 'Guides',
    body: 'How to pay your fare, ride with a wheelchair or stroller, stay cool, and more.',
  },
  {
    href: '/go',
    icon: 'mdi:map-marker-path',
    title: 'Go',
    body: 'Places to go across the valley, and the bus stops nearest you.',
  },
  {
    href: '/bingo',
    icon: 'mdi:grid',
    title: 'Bingo',
    body: 'Small things to try all week, some without leaving home.',
  },
  {
    href: '/giveaway',
    icon: 'mdi:gift-outline',
    title: 'Giveaway',
    body: 'Enter once a day on Instagram, or with your email address or phone number, for a chance to win a one-month RTC bus pass. No purchase or post necessary.',
  },
] as const;
---

<BaseLayout title={`${site.name} · ${dateRange}`} description={description}>
  <StructuredData slot="head" data={eventSchema} />

  {/* HERO: the campaign as a Las Vegas marquee, then one line and one action. */}
  <section class="hero pb-12 md:pb-16" aria-labelledby="hero-heading">
    <div class="container-page pt-6 md:pt-10">
      <div class="marquee" aria-hidden="true">
        <p class="marquee__small">Las Vegas</p>
        <p class="marquee__big">Week Without Driving</p>
        <p class="marquee__dates">Oct 1–8 · 2026</p>
      </div>

      <div class="hero__grid">
        <div>
          <h1 id="hero-heading" class="hero__headline">
            However you get around Las&nbsp;Vegas, this week is for you.
          </h1>
          <p class="hero__line">
            Take the bus, walk, roll, bike, or get a ride. Every trip counts.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="/take-part#pledge" class="hero__cta press">
              Pick your pledge
              <Icon name="mdi:arrow-right" class="size-5" aria-hidden="true" />
            </a>
            <a href="/take-part#how-it-works" class="body-link font-semibold">How it works</a>
          </div>
        </div>
        <div class="hero__facts">
          <dl class="wwd-route">
            {
              facts.map((f) => (
                <div class="wwd-stop">
                  <dt
                    class:list={[
                      'text-display-sm font-extrabold leading-none tnum',
                      f.accent && 'text-primary',
                    ]}
                  >
                    {f.value}
                  </dt>
                  <dd class="mt-2 max-w-[22rem] text-body-md leading-snug text-on-surface-variant text-pretty">
                    {f.label}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <ol
        class="week-route"
        aria-label="The week runs eight days, Thursday October 1 to Thursday October 8"
      >
        <li class="week-route__stop week-route__stop--end">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Thu</span>
          <span class="week-route__num">1</span>
        </li>
        <li class="week-route__stop">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Fri</span>
          <span class="week-route__num">2</span>
        </li>
        <li class="week-route__stop">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Sat</span>
          <span class="week-route__num">3</span>
        </li>
        <li class="week-route__stop">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Sun</span>
          <span class="week-route__num">4</span>
        </li>
        <li class="week-route__stop">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Mon</span>
          <span class="week-route__num">5</span>
        </li>
        <li class="week-route__stop">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Tue</span>
          <span class="week-route__num">6</span>
        </li>
        <li class="week-route__stop">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Wed</span>
          <span class="week-route__num">7</span>
        </li>
        <li class="week-route__stop week-route__stop--end">
          <span class="week-route__dot"></span>
          <span class="week-route__day">Thu</span>
          <span class="week-route__num">8</span>
        </li>
      </ol>
      <p class="mt-3 text-sm text-on-surface-variant">
        Part of the national{' '}
        <a
          href={wwd.nationalUrl}
          data-print-url={wwd.nationalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="body-link">Week Without Driving</a
        >.
      </p>
    </div>
  </section>

  {/* WHY — who this week is for */}
  <section
    class="container-page border-t border-outline-variant/15 py-16 md:py-24"
    aria-labelledby="why"
  >
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <div class="reveal">
        <h2 id="why" class="text-headline-lg">
          For many Las Vegans, getting around without a car is everyday life.
        </h2>
        <div class="mt-6 max-w-2xl space-y-4 leading-relaxed text-pretty">
          <p>
            Kids too young to drive. Neighbors who can’t afford a car. People whose disability means
            they don’t drive. Older adults who gave up the keys. People who choose not to. Every
            day, they cross a city built for cars by bus, walking or rolling, biking, or getting a
            ride.
          </p>
          <p>
            If that’s you, you already know what this week is about. Pledge so your everyday trips
            count, and tell us what makes them hard.
          </p>
          <p>
            If you usually drive, try it for one trip, one day or the whole week. It isn’t about
            suffering or proving a point. It’s about noticing what getting around asks of the people
            who do it every day: a bus that pulls away a minute before you reach the stop, a
            sidewalk that ends at a wall, a stop with no shade.
          </p>
          <p>
            If you have to drive, you haven’t failed. Notice what made driving necessary: that’s
            what this week is about.
          </p>
        </div>
      </div>
      <aside
        class="reveal border-t-2 border-outline pt-6 md:border-t-0 md:border-l md:border-outline-variant/20 md:pl-10 md:pt-0"
      >
        <p class="text-title-sm text-on-surface-variant">When</p>
        <p class="mt-2 text-lg font-semibold">{dateRange}</p>
        <p class="mt-6 text-title-sm text-on-surface-variant">Where</p>
        <p class="mt-2 text-lg font-semibold">
          Anywhere in the Las&nbsp;Vegas Valley, from North Las&nbsp;Vegas to Henderson and from
          Summerlin to East Las&nbsp;Vegas
        </p>
        <p class="mt-6 text-title-sm text-on-surface-variant">Who</p>
        <p class="mt-2 text-lg font-semibold">
          Everyone, whether you drive every day or haven’t driven in years
        </p>
        <p class="mt-6 text-title-sm text-on-surface-variant">Cost</p>
        <p class="mt-2 text-lg font-semibold">Free. No account needed.</p>
        <p class="mt-6 text-title-sm text-on-surface-variant">National organizer</p>
        <p class="mt-2 text-lg font-semibold">
          <a
            href={wwd.nationalUrl}
            data-print-url={wwd.nationalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="body-link"
          >
            {wwd.nationalOrganizer}
          </a>
        </p>
      </aside>
    </div>
  </section>

  {/* EXPLORE THE WEEK */}
  <section
    class="container-page border-t border-outline-variant/15 py-16 md:py-24"
    aria-labelledby="explore-heading"
  >
    <h2 id="explore-heading" class="reveal text-headline-lg">Explore the week</h2>
    <ul class="reveal-stagger mt-10 grid gap-4 md:grid-cols-2">
      {
        exploreCards.map((card) => (
          <li class="reveal flex flex-col gap-2">
            <a
              href={card.href}
              class="group flex h-full flex-col gap-3 border border-outline bg-surface-container p-6 no-underline transition-colors hover:border-primary focus-visible:border-primary"
            >
              <Icon name={card.icon} class="size-8 text-primary-ink" aria-hidden="true" />
              <span class="text-title-lg text-on-surface group-hover:text-primary-ink group-focus-visible:text-primary-ink">
                {card.title}
              </span>
              <span class="text-body-sm leading-relaxed text-on-surface-variant text-pretty">
                {card.body}
              </span>
            </a>
            {card.href === '/giveaway' && (
              <a href="/giveaway/rules" class="body-link self-start text-sm font-semibold">
                See the Official Rules
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  {/* THE CLOSE */}
  <section data-print-callout class="bg-slab text-on-slab">
    <div class="container-page py-16 md:py-24">
      <div class="reveal max-w-2xl">
        <h2 class="text-display-sm">Take part, October 1 to 8.</h2>
        <p class="mt-6 text-body-lg leading-relaxed text-on-slab/85 text-pretty">
          Pick One Trip, One Day or One Week. Every pledge counts the same.
        </p>
        <div class="mt-8">
          <a
            href="/take-part#pledge"
            class="press inline-flex items-center gap-2 bg-primary px-7 py-4 font-bold text-on-primary no-underline hover:bg-surface hover:text-on-surface focus-visible:bg-surface focus-visible:text-on-surface"
          >
            Pick your pledge
            <Icon name="mdi:arrow-right" class="size-4" aria-hidden="true" />
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm font-semibold">
          <li>
            <a href="mailto:wwd@lasvegasfortransit.org" class="body-link"
              >Questions? Email wwd@lasvegasfortransit.org</a
            >
          </li>
          <li>
            <a
              href={lvbt.instagramUrl}
              data-print-url={lvbt.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="body-link">Follow @lasvegasfortransit on Instagram</a
            >
          </li>
          <li>
            <a href={lvbt.joinUrl} data-print-url={lvbt.joinUrl} class="body-link"
              >Join Las Vegans for Better Transit</a
            >
          </li>
        </ul>
      </div>
      <blockquote
        class="reveal-quote mt-12 max-w-2xl border-l-[6px] border-primary py-2 pl-6 text-headline-md font-medium leading-snug text-balance md:pl-10"
      >
        The bus that comes every half hour is not an inconvenience for a week. For the people who
        ride it every day, it is the schedule.
      </blockquote>
    </div>
  </section>
</BaseLayout>

<style>
  /* The hero's route strip. Desktop: one Ember line across the width with a
     stop dot at each number. Narrow screens: the line runs down the left
     and the dots sit beside each number, so it still reads as one route. */
  .wwd-route {
    --stop: 1.5rem;
    --line: 0.3125rem;
    position: relative;
    display: grid;
    gap: 2rem;
  }
  .wwd-stop {
    position: relative;
  }
  .wwd-stop::before {
    content: '';
    position: absolute;
    width: var(--stop);
    height: var(--stop);
    box-sizing: border-box;
    border-radius: 9999px;
    background: var(--color-surface);
    border: var(--line) solid var(--color-primary);
  }
  .wwd-stop:last-child::before {
    background: var(--color-primary);
  }

  @media (max-width: 47.99rem) {
    .wwd-route {
      padding-left: calc(var(--stop) + 1rem);
    }
    .wwd-route::before {
      content: '';
      position: absolute;
      left: calc(var(--stop) / 2 - var(--line) / 2);
      top: 0;
      bottom: 0;
      width: var(--line);
      background: var(--color-primary);
    }
    .wwd-stop::before {
      left: calc(-1 * (var(--stop) + 1rem));
      top: 0.35rem;
    }
  }

  @media (min-width: 48rem) {
    .wwd-route {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
      padding-top: calc(var(--stop) + 1.25rem);
    }
    .wwd-route::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--stop) / 2 - var(--line) / 2);
      height: var(--line);
      background: var(--color-primary);
    }
    .wwd-stop::before {
      left: 0;
      top: calc(-1 * (var(--stop) + 1.25rem));
    }
  }

  /* ---- Hero: a Las Vegas marquee sign, one headline, one action. ---- */
  .marquee {
    position: relative;
    padding: 1.4rem 1rem 1.2rem;
    text-align: center;
    color: #fff4d6;
    background: radial-gradient(90% 120% at 50% 0%, #2a1a14 0%, transparent 70%), #120d0b;
    border-radius: 1.25rem;
    box-shadow: 0 24px 50px -24px rgb(18 13 11 / 0.7);
    overflow: hidden;
  }
  .marquee::before {
    content: '';
    position: absolute;
    inset: 0.5rem;
    border: 5px dotted #ffd98a;
    border-radius: 0.9rem;
    filter: drop-shadow(0 0 3px #ffc658) drop-shadow(0 0 8px rgb(255 198 88 / 0.6));
    animation: marquee-chase 1.6s steps(2) infinite;
  }
  @keyframes marquee-chase {
    50% {
      border-color: #fff1c9;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee::before {
      animation: none;
    }
  }
  .marquee__small,
  .marquee__big,
  .marquee__dates {
    position: relative;
    font-family: 'Bungee Subset', 'Public Sans Variable', sans-serif;
    text-transform: uppercase;
  }
  .marquee__small {
    font-size: clamp(0.8rem, 3.4vw, 1.1rem);
    letter-spacing: 0.3em;
    color: #ff8a5c;
    text-shadow: 0 0 10px rgb(255 106 60 / 0.7);
  }
  .marquee__big {
    margin-top: 0.35rem;
    font-size: clamp(2.2rem, 11.5vw, 5.6rem);
    line-height: 0.95;
    color: #fff4d6;
    text-shadow:
      0 3px 0 #e5471a,
      0 6px 0 #8f2708,
      0 0 22px rgb(255 190 110 / 0.35);
    text-wrap: balance;
  }
  .marquee__dates {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.35rem 0.9rem;
    font-size: clamp(0.95rem, 4.2vw, 1.35rem);
    color: #120d0b;
    background: #ffd98a;
    border-radius: 999px;
    box-shadow: 0 0 16px rgb(255 217 138 / 0.55);
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1.35fr 1fr;
      align-items: end;
      margin-top: 2.5rem;
    }
  }
  .hero__facts {
    order: 2;
  }
  .hero__headline {
    margin-top: 0;
    max-width: 20ch;
    font-size: clamp(2rem, 7.5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero__line {
    margin-top: 0.9rem;
    max-width: 34ch;
    font-size: clamp(1.15rem, 4.4vw, 1.4rem);
    line-height: 1.4;
    color: var(--color-on-surface-variant);
    text-wrap: pretty;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 56px;
    padding: 0 1.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 24px -10px rgb(229 71 26 / 0.75);
  }
  .hero__cta:hover,
  .hero__cta:focus-visible {
    background: var(--color-on-surface);
    color: var(--color-surface);
  }

  /* The week as a bus line: eight stops, Thursday to Thursday. */
  .week-route {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin-top: 2.6rem;
    padding: 0;
    list-style: none;
  }
  .week-route::before {
    content: '';
    position: absolute;
    left: calc(100% / 16);
    right: calc(100% / 16);
    top: 0.55rem;
    height: 6px;
    border-radius: 3px;
    background: var(--color-primary);
  }
  .week-route__stop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .week-route__dot {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: 4px solid var(--color-primary);
  }
  .week-route__stop--end .week-route__dot {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: -0.2rem;
    background: var(--color-primary);
    border-color: var(--color-on-surface);
  }
  .week-route__day {
    margin-top: 0.3rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }
  .week-route__num {
    font-family: 'Bungee Subset', 'Public Sans Variable', sans-serif;
    font-size: clamp(1.1rem, 5vw, 1.6rem);
    line-height: 1;
  }
</style>
