---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import PhotoSlot from '../components/PhotoSlot.astro';
import { lvbt, site } from '../lib/site';
import { wwd } from '../lib/wwd';

// The Home page: a short, warm welcome that speaks first to people who
// already get around without a car, then to people trying it for the
// first time. Full experience and copy: features/site/f-welcome.md.
// Everything the old one-page site explained at length now lives on the
// page that owns it (Take Part, Guides, Go, Bingo, Giveaway, Resources,
// Partners); Home only welcomes, orients, and points onward.

const dateRange = `October 1 to 8, ${wwd.year}`;
const canonical = `${site.url}/`;

const description = `However you get around, ${site.name} is for you, ${dateRange}. Pledge, plan a trip, and play transit bingo.`;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SocialEvent',
  '@id': `${canonical}#event`,
  name: `Week Without Driving ${wwd.year} in Las Vegas`,
  description,
  startDate: wwd.startDate,
  endDate: wwd.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Las Vegas Valley',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Las Vegas',
      addressRegion: 'NV',
      addressCountry: 'US',
    },
  },
  isAccessibleForFree: true,
  organizer: {
    '@type': 'Organization',
    '@id': `${lvbt.url}/#organization`,
    name: lvbt.name,
    url: lvbt.url,
  },
  superEvent: {
    '@type': 'Event',
    name: `Week Without Driving ${wwd.year}`,
    url: wwd.nationalUrl,
    startDate: wwd.startDate,
    endDate: wwd.endDate,
  },
  url: canonical,
  mainEntityOfPage: canonical,
};

// How to take part, after the national campaign's four ways to join.
const ways = [
  {
    title: 'Take the bus, walk, roll or bike.',
    body: 'Try another way to get where you need to go, for one trip or the whole week.',
    photo: 'A rider boarding an RTC bus in East Las Vegas',
  },
  {
    title: 'Ask for a ride.',
    body: 'Ride with a friend, a neighbor or a coworker. Notice what it’s like to count on someone else.',
    photo: 'Two neighbors sharing a ride to the grocery store',
  },
  {
    title: 'Notice what’s hard.',
    body: 'A stop with no shade. A sidewalk that ends. A bus that comes every hour. Tell us about it.',
    photo: 'A bus stop with no shade on a hot afternoon',
  },
  {
    title: 'If you have to drive, you haven’t failed.',
    body: 'Some trips need a car. Think about what someone who can’t drive would do instead.',
    photo: 'A parent with a stroller crossing a wide Las Vegas street',
  },
] as const;

// Leaders who took the challenge elsewhere, quoted from the national campaign.
const voices = [
  {
    quote:
      'This week was a reminder that mobility is a human right. And it’s also a reminder that so many people in our region are excluded from this right, simply because driving for them is not an option.',
    who: 'Girmay Zahilay',
    role: 'King County Executive, Washington',
  },
  {
    quote: 'I’m learning so much about how to better represent my constituents who don’t drive.',
    who: 'Analise Ortiz',
    role: 'Arizona State Senator',
  },
  {
    quote:
      'Traveling to Southeast DC on Day 4 required multiple connections across various modes and still took an hour. I’m leaving the challenge with an even deeper appreciation for the transit options available to me, and a renewed sense of commitment to expanding District residents’ access to transit.',
    who: 'Charles Allen',
    role: 'Councilmember, Washington, DC',
  },
] as const;

// Participate your way: one door for each kind of participant.
const audiences = [
  {
    icon: 'mdi:account-heart-outline',
    title: 'Las Vegans',
    body: 'Pledge one trip, one day or the whole week. Get guides, a bingo card and a daily reminder.',
    cta: 'Take the pledge',
    href: '/take-part#pledge',
  },
  {
    icon: 'mdi:office-building-outline',
    title: 'Workplaces, schools and groups',
    body: 'Invite your coworkers, classmates or members. We’ll send a kit with flyers and a link that counts your group’s pledges.',
    cta: 'Bring your organization',
    href: '/partners',
  },
  {
    icon: 'mdi:bank-outline',
    title: 'Elected leaders and agencies',
    body: 'Take the challenge with your staff and see your district the way your constituents who don’t drive see it. We’ll help you plan the week.',
    cta: 'Plan your week with us',
    href: 'mailto:wwd@lasvegasfortransit.org?subject=Week%20Without%20Driving%3A%20elected%20leaders%20and%20agencies',
  },
] as const;
---

<BaseLayout title={`${site.name} · ${dateRange}`} description={description}>
  <StructuredData slot="head" data={eventSchema} />

  {/* HERO: a real photo of Las Vegans, and a question to sit with. */}
  <section class="home-hero" aria-labelledby="hero-heading">
    <PhotoSlot
      class="home-hero__photo"
      shows="Las Vegans of all ages waiting together at a bus stop"
      quiet
    />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="container-page home-hero__content">
      <p class="home-hero__eyebrow">
        <span>Week Without Driving Las Vegas</span>
        <span>October 1 to 8, {wwd.year}</span>
      </p>
      <h1 id="hero-heading" class="home-hero__title">
        What would your week look like without a car?
      </h1>
      <div class="home-hero__actions">
        <a href="/take-part#pledge" class="btn btn--primary">Take the pledge</a>
        <a href="#why" class="btn btn--ghost">Learn more</a>
      </div>
    </div>
  </section>

  {/* VISION: who doesn't drive, and the Las Vegas we're working toward. */}
  <section id="why" class="home-vision scroll-mt-20" aria-labelledby="vision-heading">
    <div class="container-page home-vision__grid">
      <h2 id="vision-heading" class="home-vision__lead">
        One in three people in the U.S. don’t drive.
      </h2>
      <div class="home-vision__body">
        <p>
          In Las Vegas, they’re our kids, our grandparents, and neighbors working the late shift.
          Every day they cross a valley built for cars, by bus, on foot, in a wheelchair, on a bike,
          or with a ride from someone who can.
        </p>
        <p>
          Las Vegans for Better Transit is working toward a valley where everyone can get where they
          need to go. Week Without Driving is how we see it together, for eight days in October.
        </p>
        <a href={`${lvbt.url}/about`} class="home-link">About Las Vegans for Better Transit</a>
      </div>
    </div>
  </section>

  {/* HOW TO TAKE PART */}
  <section class="home-section" aria-labelledby="ways-heading">
    <div class="container-page">
      <h2 id="ways-heading" class="home-h2">How to take part</h2>
      <ul class="home-ways">
        {
          ways.map((w) => (
            <li class="home-way">
              <PhotoSlot class="home-way__photo" shows={w.photo} />
              <h3 class="home-way__title">{w.title}</h3>
              <p class="home-way__body">{w.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="home-actions">
        <a href="/take-part#pledge" class="btn btn--primary">Take the pledge</a>
        <a href="/guides" class="btn btn--outline">Read the rider guides</a>
      </div>
    </div>
  </section>

  {/* VOICES */}
  <section class="home-voices" aria-labelledby="voices-heading">
    <div class="container-page">
      <h2 id="voices-heading" class="home-h2">What leaders learned</h2>
      <p class="home-intro">
        Elected leaders across the country have taken the challenge. Here’s what they said.
      </p>
      <ul class="home-quotes">
        {
          voices.map((v) => (
            <li class="home-quote">
              <blockquote>
                <p>“{v.quote}”</p>
              </blockquote>
              <p class="home-quote__who">
                <strong>{v.who}</strong>
                <span>{v.role}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="home-source">
        Quotes from the national{' '}
        <a href={wwd.nationalUrl} target="_blank" rel="noopener noreferrer" class="body-link"
          >Week Without Driving</a
        >.
      </p>
    </div>
  </section>

  {/* PARTICIPATE YOUR WAY */}
  <section class="home-section" aria-labelledby="audiences-heading">
    <div class="container-page">
      <h2 id="audiences-heading" class="home-h2">Take part your way</h2>
      <ul class="home-audiences">
        {
          audiences.map((a) => (
            <li class="home-audience">
              <Icon name={a.icon} class="home-audience__icon" aria-hidden="true" />
              <h3 class="home-audience__title">{a.title}</h3>
              <p class="home-audience__body">{a.body}</p>
              <a href={a.href} class="home-link">
                {a.cta}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* PARTNERS */}
  <section class="home-partners" aria-labelledby="partners-heading">
    <div class="container-page home-partners__grid">
      <div>
        <h2 id="partners-heading" class="home-h2">Part of a national movement</h2>
        <p class="home-intro">
          Week Without Driving runs in hundreds of towns and cities every October. The national
          campaign is led by America Walks and the Nondrivers Alliance.
        </p>
      </div>
      <ul class="home-partners__list" aria-label="National partners">
        <li>America Walks</li>
        <li>Nondrivers Alliance</li>
        <li class="home-partners__you"><a href="/partners">Your organization here</a></li>
      </ul>
    </div>
  </section>

  {/* STAY INVOLVED */}
  <section class="home-stay" aria-labelledby="stay-heading">
    <div class="container-page home-stay__grid">
      <div>
        <h2 id="stay-heading" class="home-h2">Keep going after the week</h2>
        <p class="home-intro">
          Get transit news and easy ways to help in Las Vegas from Las Vegans for Better Transit.
        </p>
      </div>
      <div class="home-stay__actions">
        <a href="/take-part#pledge" class="btn btn--primary">Take the pledge</a>
        <a href={lvbt.joinUrl} class="btn btn--outline">Join LVBT</a>
        <a href={lvbt.instagramUrl} target="_blank" rel="noopener noreferrer" class="home-link"
          >Follow @lasvegasfortransit</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 1.5rem;
    font-weight: 800;
    font-size: 1.05rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .btn--primary {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }
  .btn--primary:hover,
  .btn--primary:focus-visible {
    background: var(--color-on-surface);
    color: var(--color-surface);
  }
  .btn--ghost {
    color: #fff;
    border: 2px solid rgb(255 255 255 / 0.85);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: #fff;
    color: #111;
  }
  .btn--outline {
    color: var(--color-on-surface);
    border: 2px solid var(--color-on-surface);
  }
  .btn--outline:hover,
  .btn--outline:focus-visible {
    background: var(--color-on-surface);
    color: var(--color-surface);
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-weight: 800;
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-link::after {
    content: '→';
  }

  /* Hero */
  .home-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 44rem);
    color: #fff;
  }
  .home-hero :global(.home-hero__photo) {
    position: absolute;
    inset: 0;
  }
  .home-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 12 14 / 0.88) 0%,
      rgb(10 12 14 / 0.55) 45%,
      rgb(10 12 14 / 0.05) 80%
    );
  }
  .home-hero__content {
    position: relative;
    width: 100%;
    padding-block: 2.5rem 2.75rem;
  }
  .home-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .home-hero__title {
    margin-top: 0.75rem;
    max-width: 16ch;
    font-size: clamp(2.35rem, 9vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Vision */
  .home-vision {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
    color: var(--color-on-slab);
    background: var(--color-slab);
  }
  .home-vision__grid {
    display: grid;
    gap: 1.5rem;
  }
  .home-vision__lead {
    max-width: 18ch;
    font-size: clamp(1.9rem, 6.5vw, 3.25rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .home-vision__body {
    max-width: 38rem;
    font-size: clamp(1.1rem, 3.8vw, 1.3rem);
    line-height: 1.55;
  }
  .home-vision__body p + p {
    margin-top: 1rem;
  }
  .home-vision .home-link {
    color: var(--color-on-slab);
  }

  /* Shared section rhythm */
  .home-section {
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }
  .home-h2 {
    font-size: clamp(1.8rem, 6vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .home-intro {
    margin-top: 0.75rem;
    max-width: 36rem;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Ways to take part */
  .home-ways {
    display: grid;
    gap: 1.75rem;
    margin-top: 2rem;
  }
  .home-way :global(.home-way__photo) {
    aspect-ratio: 4 / 3;
    border-radius: 0.75rem;
  }
  .home-way__title {
    margin-top: 0.9rem;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .home-way__body {
    margin-top: 0.4rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }

  /* Voices */
  .home-voices {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    background: var(--color-surface-container);
  }
  .home-quotes {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .home-quote {
    padding: 1.5rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    border-top: 4px solid var(--color-primary);
  }
  .home-quote blockquote p {
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .home-quote__who {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .home-quote__who span {
    color: var(--color-on-surface-variant);
  }
  .home-source {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--color-on-surface-variant);
  }

  /* Audiences */
  .home-audiences {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .home-audience {
    padding: 1.5rem;
    border: 2px solid color-mix(in srgb, var(--color-on-surface) 15%, transparent);
    border-radius: 0.75rem;
  }
  .home-audience__icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-primary);
  }
  .home-audience__title {
    margin-top: 0.75rem;
    font-size: 1.3rem;
    font-weight: 800;
  }
  .home-audience__body {
    margin-top: 0.4rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }

  /* Partners */
  .home-partners {
    padding-block: clamp(3rem, 8vw, 5rem);
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 12%, transparent);
  }
  .home-partners__grid {
    display: grid;
    gap: 1.5rem;
  }
  .home-partners__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
  }
  .home-partners__list li {
    display: grid;
    place-items: center;
    min-height: 5rem;
    padding: 1rem;
    font-weight: 800;
    font-size: 1.05rem;
    text-align: center;
    background: var(--color-surface-container);
    border-radius: 0.75rem;
  }
  .home-partners__you {
    background: transparent !important;
    border: 2px dashed color-mix(in srgb, var(--color-on-surface) 30%, transparent);
  }
  .home-partners__you a {
    color: var(--color-link);
  }

  /* Stay involved */
  .home-stay {
    padding-block: clamp(3.5rem, 9vw, 6rem);
    background: var(--color-primary-soft);
  }
  .home-stay__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .home-stay__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .home-stay__actions .home-link {
    margin-top: 0;
  }

  @media (min-width: 48rem) {
    .home-ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-audiences,
    .home-quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .home-ways {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .home-vision__grid,
    .home-partners__grid,
    .home-stay__grid {
      grid-template-columns: 1fr 1.2fr;
      column-gap: 4rem;
    }
    .home-hero {
      min-height: 40rem;
    }
  }
</style>
