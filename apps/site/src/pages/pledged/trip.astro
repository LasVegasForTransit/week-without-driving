---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParticipantKit from '../../components/ParticipantKit.astro';
import { pledgeTierById } from '../../lib/pledge';

const tier = pledgeTierById('trip')!;
---

<BaseLayout
  title={`You’re in for ${tier.name} · Week Without Driving Las Vegas`}
  description="Your One Trip participant kit: next steps, daily reminders, and how to share your pledge."
  noindex
>
  <ParticipantKit tier={tier} />
</BaseLayout>
