---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Steps from '../components/Steps.astro';
import WinBand from '../components/WinBand.astro';
import { winSteps } from '../lib/campaign';
import { photos } from '../lib/photos';

// How it works. Anyone can take part in Week Without Driving without
// signing up; signing up is only for LVBT's Las Vegas giveaway. The "Take
// part your way" cards follow the national campaign's four ways to join.

const title = 'How it works · Week Without Driving Las Vegas';
const description =
  'Anyone can take part in Week Without Driving, October 1 to 8. Sign up with us to win prizes.';

const ways = [
  {
    title: 'Take the bus, walk, roll or bike.',
    body: 'Try another way to get where you need to go, for one trip or the whole week.',
    photo: 'A rider boarding an RTC bus in East Las Vegas',
    image: photos.rtcBusStreet,
  },
  {
    title: 'Ask for a ride.',
    body: 'Ride with a friend, a neighbor or a coworker. Notice what it’s like to count on someone else.',
    photo: 'Two neighbors sharing a ride to the grocery store',
    icon: 'mdi:account-multiple-outline',
  },
  {
    title: 'Notice what’s hard.',
    body: 'A stop with no shade. A sidewalk that ends. A bus that comes every hour. Tell us about it.',
    photo: 'A bus stop with no shade on a hot afternoon',
    icon: 'mdi:weather-sunny-alert',
  },
  {
    title: 'If you have to drive, you haven’t failed.',
    body: 'Some trips need a car. Think about what someone who can’t drive would do instead.',
    photo: 'A parent with a stroller crossing a wide Las Vegas street',
    icon: 'mdi:car-outline',
  },
] as const;

const fields = [
  {
    field: 'First name',
    why: 'So we know who to congratulate.',
  },
  {
    field: 'Email address or phone number',
    why: 'One or the other. To reach you if you win, and to send your “Open my week” link.',
  },
  {
    field: 'ZIP code',
    why: 'To confirm you live in Southern Nevada, and to show where people took part.',
  },
  {
    field: 'Instagram handle (optional)',
    why: 'So we can count the trips you post that tag @lasvegasfortransit.',
  },
  {
    field: 'Age',
    why: 'The giveaway is open to people 13 and older. If you’re 13 to 17, a parent or guardian agrees to the Official Rules for you.',
  },
  {
    field: 'The trips you share',
    why: 'The link or screenshot of your post, how you got around, and what was hard if you tell us. It’s how we count trips without driving and show the RTC what to fix.',
  },
  {
    field: 'LVBT newsletter (optional, never checked for you)',
    why: 'Only if you want transit news and easy ways to help from LVBT.',
  },
] as const;
---

<BaseLayout title={title} description={description}>
  <PageHeader
    title="How it works"
    lede="Anyone can take part in Week Without Driving, October 1–8. You don’t need to sign up. Sign up with us to win prizes."
  />

  {/* TAKE PART YOUR WAY */}
  <section class="container-page section" aria-labelledby="ways-heading">
    <h2 id="ways-heading" class="section-title">Take part your way</h2>
    <p class="section-intro">However you get around, it counts. Pick what fits your trip.</p>
    <ul class="section-body grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        ways.map((way) => (
          <li class="take-part-way">
            <PhotoSlot
              class="take-part-way__photo"
              shows={way.photo}
              photo={'image' in way ? way.image : undefined}
              icon={'icon' in way ? way.icon : 'mdi:bus'}
              sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
            />
            <div class="take-part-way__text">
              <h3 class="take-part-way__title">{way.title}</h3>
              <p class="take-part-way__body">{way.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* WIN PRIZES: the same three steps as the Win prizes page. */}
  <section
    id="how-it-works"
    class="container-page section scroll-mt-24"
    aria-labelledby="win-heading"
  >
    <h2 id="win-heading" class="section-title">Win prizes</h2>
    <p class="section-intro">
      Signing up is free. Do these three things for a chance to win a one-month RTC bus pass and an
      LVBT sticker pack.
    </p>
    <Steps steps={winSteps} class="section-body" />
  </section>

  {/* WHAT WE ASK FOR, AND WHY */}
  <section class="container-page section" aria-labelledby="ask-heading">
    <h2 id="ask-heading" class="section-title">What we ask for, and why</h2>
    <p class="section-intro">
      We delete all of it on November 30, 2026. Signing up means agreeing to the <a
        href="/giveaway/rules"
        class="body-link">Official Rules</a
      >. Read our <a href="/privacy" class="body-link">Privacy page</a>.
    </p>
    <dl class="ask-list section-body">
      {
        fields.map((row) => (
          <div class="ask-list__row">
            <dt>{row.field}</dt>
            <dd>{row.why}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* FAQ */}
  <section class="container-page section" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="section-title">Questions</h2>
    <div class="faq section-body">
      <details class="faq-item">
        <summary class="faq-item__summary">Do I have to sign up to take part?</summary>
        <p class="faq-item__body">
          No. Anyone can take part in Week Without Driving without signing up. The guides, the bus
          finder and bingo are open to everyone. Sign up only if you want a chance to win prizes.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">Does it cost anything?</summary>
        <p class="faq-item__body">
          No. Taking part is free, and so is entering. You enter by sharing your trips, or by mail
          if you don’t use social media.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">What if I have to drive?</summary>
        <p class="faq-item__body">
          Some trips need a car. You haven’t failed. Notice what made driving necessary, and try
          another way for your next trip.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">What if I don’t use Instagram?</summary>
        <p class="faq-item__body">
          Post your trip on any public social media account with #WeekWithoutDriving, and paste the
          link on My week. No social media at all? You can enter by mail.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">How do I get back to My week on another phone?</summary>
        <p class="faq-item__body">
          Use the link we sent you, or <a href="/my-week/link" class="body-link">ask for it again</a
          >.
        </p>
      </details>
    </div>
  </section>

  <WinBand />
</BaseLayout>

<style>
  .take-part-way {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .take-part-way :global(.take-part-way__photo) {
    aspect-ratio: 4 / 3;
  }
  .take-part-way__text {
    padding: 1.1rem 1.25rem 1.35rem;
  }
  .take-part-way__title {
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .take-part-way__body {
    margin-top: 0.4rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  /* On phones each way is a compact row, photo beside the words, so the
     four of them don't make a long scroll. */
  @media (max-width: 39.99rem) {
    .take-part-way {
      flex-direction: row;
    }
    .take-part-way :global(.take-part-way__photo) {
      flex: none;
      width: 7.5rem;
      aspect-ratio: auto;
    }
    .take-part-way :global(.photo__credit) {
      display: none;
    }
    .take-part-way__text {
      padding: 0.9rem 1rem 1rem;
    }
    .take-part-way__title {
      font-size: 1.1rem;
    }
  }

  /* Stacked on phones, two columns on wider screens, never scrolling sideways. */
  .ask-list {
    max-width: 48rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
  }
  .ask-list__row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
  }
  .ask-list dt {
    font-weight: 800;
  }
  .ask-list dd {
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  @media (min-width: 48rem) {
    .ask-list__row {
      grid-template-columns: 14rem 1fr;
    }
  }

  .faq {
    max-width: 44rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
  }
  .faq-item {
    padding-block: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
  }
  .faq-item__summary {
    cursor: pointer;
    padding-block: 0.25rem;
    font-weight: 800;
    font-size: 1.1rem;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .faq-item__summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .faq-item__body {
    margin-top: 0.5rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
  }
</style>
