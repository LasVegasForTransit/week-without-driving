---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { photos } from '../lib/photos';

// How it works. Anyone can take part in Week Without Driving without
// signing up; signing up is only for LVBT's Las Vegas giveaway. The "Take
// part your way" cards follow the national campaign's four ways to join.

const title = 'How it works · Week Without Driving Las Vegas';
const description =
  'Anyone can take part in Week Without Driving, October 1 to 8. Sign up with us to win prizes.';

const ways = [
  {
    title: 'Take the bus, walk, roll or bike.',
    body: 'Try another way to get where you need to go, for one trip or the whole week.',
    photo: 'A rider boarding an RTC bus in East Las Vegas',
    image: photos.rtcBusStreet,
  },
  {
    title: 'Ask for a ride.',
    body: 'Ride with a friend, a neighbor or a coworker. Notice what it’s like to count on someone else.',
    photo: 'Two neighbors sharing a ride to the grocery store',
  },
  {
    title: 'Notice what’s hard.',
    body: 'A stop with no shade. A sidewalk that ends. A bus that comes every hour. Tell us about it.',
    photo: 'A bus stop with no shade on a hot afternoon',
  },
  {
    title: 'If you have to drive, you haven’t failed.',
    body: 'Some trips need a car. Think about what someone who can’t drive would do instead.',
    photo: 'A parent with a stroller crossing a wide Las Vegas street',
  },
] as const;

// Same three steps as the Win prizes page (/giveaway): keep the copy in
// sync if either one changes.
const steps = [
  {
    title: 'Sign up.',
    body: 'It takes a minute: your first name, a phone number or email, and your ZIP code.',
  },
  {
    title: 'Check in each day.',
    body: 'From October 1 to 8, tap Check in for today on My week. Each day is one entry, up to 8.',
  },
  {
    title: 'Win.',
    body: 'We draw a winner by October 15, 2026 and contact them the way they signed up. No purchase or post necessary.',
  },
] as const;

const fields = [
  {
    field: 'First name',
    why: 'So we know who to congratulate.',
  },
  {
    field: 'Email address or phone number',
    why: 'One or the other. To reach you if you win, and to send your “Open my week” link.',
  },
  {
    field: 'ZIP code',
    why: 'To confirm you live in Southern Nevada, and to show where people took part.',
  },
  {
    field: 'Instagram handle (optional)',
    why: 'So a tag of @lasvegasfortransit counts as that day’s check-in.',
  },
  {
    field: 'Age',
    why: 'The giveaway is open to people 13 and older. If you’re 13 to 17, a parent or guardian agrees to the Official Rules for you.',
  },
  {
    field: 'LVBT newsletter (optional, never checked for you)',
    why: 'Only if you want transit news and easy ways to help from LVBT.',
  },
] as const;
---

<BaseLayout title={title} description={description}>
  <section class="container-page pt-12 pb-8 md:pt-16">
    <h1 class="text-display-sm">How it works</h1>
    <p class="lede mt-4 max-w-2xl">
      Anyone can take part in Week Without Driving, October 1–8. You don’t need to sign up. Sign up
      with us to win prizes.
    </p>
  </section>

  {/* TAKE PART YOUR WAY */}
  <section
    class="container-page border-t border-outline-variant/15 py-12 md:py-16"
    aria-labelledby="ways-heading"
  >
    <h2 id="ways-heading" class="text-headline-lg">Take part your way</h2>
    <p class="lede mt-3 max-w-2xl">However you get around, it counts. Pick what fits your trip.</p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        ways.map((way) => (
          <li class="take-part-way border border-outline-variant/20 bg-surface-container">
            <PhotoSlot
              class="take-part-way__photo"
              shows={way.photo}
              photo={'image' in way ? way.image : undefined}
              sizes="(min-width: 64rem) 25vw, (min-width: 48rem) 50vw, 100vw"
            />
            <div class="p-5">
              <h3 class="text-title-lg">{way.title}</h3>
              <p class="mt-2 leading-relaxed text-on-surface-variant text-pretty">{way.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* WIN PRIZES: three steps to sign up and win. */}
  <section
    id="how-it-works"
    class="container-page scroll-mt-24 border-t border-outline-variant/15 py-12 md:py-16"
    aria-labelledby="win-heading"
  >
    <h2 id="win-heading" class="text-headline-lg">Win prizes</h2>
    <p class="lede mt-3 max-w-2xl">
      Taking part is free, and so is signing up. Do these three things for a chance to win a
      one-month RTC bus pass and an LVBT sticker pack.
    </p>
    <ol class="mt-8 grid gap-5 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="relative flex gap-5 overflow-hidden border border-outline-variant/20 bg-surface-container p-6 pl-8 md:flex-col md:gap-3">
            <span
              class="absolute inset-y-0 left-0 w-2 bg-primary md:inset-x-0 md:inset-y-auto md:h-2 md:w-auto"
              aria-hidden="true"
            />
            <span
              class="flex size-9 shrink-0 items-center justify-center bg-primary font-black text-on-primary tnum"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div>
              <h3 class="text-title-lg">
                <span class="sr-only">Step {index + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-2 leading-relaxed text-on-surface-variant text-pretty">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="mt-8">
      <a
        href="/sign-up"
        data-signup-link
        class="press inline-flex items-center gap-2 bg-primary px-8 py-4 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
      >
        <span data-signup-label>Sign up to win</span>
      </a>
    </div>
  </section>

  {/* WHAT WE ASK FOR, AND WHY */}
  <section
    class="container-page border-t border-outline-variant/15 py-12 md:py-16"
    aria-labelledby="ask-heading"
  >
    <h2 id="ask-heading" class="text-headline-lg">What we ask for, and why</h2>
    <p class="lede mt-3 max-w-2xl">Signing up means agreeing to the Official Rules.</p>
    <dl class="ask-list mt-8 max-w-3xl">
      {
        fields.map((row) => (
          <div class="ask-list__row">
            <dt>{row.field}</dt>
            <dd>{row.why}</dd>
          </div>
        ))
      }
    </dl>
    <p class="prose-doc mt-6 max-w-2xl">
      We delete this information on November 30, 2026. The newsletter belongs to LVBT and isn’t
      deleted then. Read our <a href="/privacy" class="body-link">Privacy page</a>.
    </p>
  </section>

  {/* FAQ */}
  <section
    class="container-page border-t border-outline-variant/15 py-12 md:py-16"
    aria-labelledby="faq-heading"
  >
    <h2 id="faq-heading" class="text-headline-lg">Questions</h2>
    <div
      class="mt-8 max-w-2xl divide-y divide-outline-variant/20 border-y border-outline-variant/20"
    >
      <details class="faq-item">
        <summary class="faq-item__summary">Do I have to sign up to take part?</summary>
        <p class="faq-item__body">
          No. Anyone can take part in Week Without Driving without signing up. The guides, the bus
          finder and bingo are open to everyone. Sign up only if you want a chance to win prizes.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">Does it cost anything?</summary>
        <p class="faq-item__body">
          No. Taking part is free, and checking in for the giveaway is free too. No purchase or post
          is necessary.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">What if I have to drive?</summary>
        <p class="faq-item__body">
          Some trips need a car. You haven’t failed — notice what made driving necessary, and try
          another way for your next trip.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">What if I don’t use Instagram?</summary>
        <p class="faq-item__body">
          You don’t need it. Sign up with an email address or phone number instead, and check in on
          My week each day.
        </p>
      </details>
      <details class="faq-item">
        <summary class="faq-item__summary">How do I get back to My week on another phone?</summary>
        <p class="faq-item__body">
          Use the link we sent you, or go to <a href="/my-week/link" class="body-link"
            >/my-week/link</a
          > and we’ll send it again.
        </p>
      </details>
    </div>
  </section>

  <section class="container-page border-t border-outline-variant/15 py-12 md:py-16 text-center">
    <a
      href="/sign-up"
      data-signup-link
      class="press inline-flex items-center gap-2 bg-primary px-8 py-4 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
    >
      <span data-signup-label>Sign up to win</span>
    </a>
  </section>
</BaseLayout>

<style>
  .take-part-way {
    display: flex;
    flex-direction: column;
  }
  .take-part-way :global(.take-part-way__photo) {
    aspect-ratio: 4 / 3;
  }

  /* Stacked on phones, two columns on wider screens, never scrolling sideways. */
  .ask-list {
    border-top: 1px solid var(--color-outline-variant);
  }
  .ask-list__row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .ask-list dt {
    font-weight: 800;
  }
  .ask-list dd {
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  @media (min-width: 48rem) {
    .ask-list__row {
      grid-template-columns: 14rem 1fr;
    }
  }

  .faq-item {
    padding-block: 1rem;
  }
  .faq-item__summary {
    cursor: pointer;
    padding-block: 0.25rem;
    font-weight: 700;
    font-size: var(--text-title-md);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .faq-item__summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .faq-item__body {
    margin-top: 0.5rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
  }
</style>
