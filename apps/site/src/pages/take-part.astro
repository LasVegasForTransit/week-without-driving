---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pledgeTiers } from '../lib/pledge';

// Take Part: "How the week works" (from the site welcome draft's Take Part
// section) and the pledge picker (the pledge Epic's "Let visitors pledge at
// the level they choose in two taps"). The picker's demo behaviour — cookie
// + redirect, no network call — lives in /scripts/pledge-form.js so it
// still satisfies the site's `script-src 'self'` Content Security Policy.

const steps = [
  {
    title: 'Pick your pledge.',
    body: 'Choose One Trip, One Day or One Week below and tap I’m in. Every pledge counts the same.',
  },
  {
    title: 'Plan a trip.',
    body: 'Our guides show how to pay your fare, ride with a wheelchair, walker or stroller, and stay cool in the heat. Go shows places to go and the bus stops near you.',
  },
  {
    title: 'Get there without driving.',
    body: 'Go by bus, walking or rolling, biking, or getting a ride. Rides from friends or family, RTC Paratransit and working from home all count. If you have to drive, you haven’t failed. Notice what made driving necessary.',
  },
  {
    title: 'Notice what’s hard, and tell someone.',
    body: 'What was easy? What was hard? Tell a friend, write it down, or share it online with #WeekWithoutDriving. It’s up to you.',
  },
];
---

<BaseLayout
  title="How it works · Week Without Driving Las Vegas"
  description="Pick One Trip, One Day or One Week, see how the week works, and pledge in two taps."
>
  <section class="container-page pt-12 pb-8 md:pt-16">
    <h1 class="text-display-sm">How it works</h1>
    <p class="lede mt-4 max-w-2xl">
      Pick one trip, one day or the whole week. However you get around, it counts.
    </p>
  </section>

  {/* HOW THE WEEK WORKS */}
  <section
    id="how-it-works"
    class="container-page scroll-mt-24 border-t border-outline-variant/15 py-12 md:py-16"
    aria-labelledby="how-it-works-heading"
  >
    <h2 id="how-it-works-heading" class="text-headline-lg">The four steps</h2>
    <p class="lede mt-3">Go at your own pace. You don’t need an account.</p>
    <ol class="mt-8 grid gap-5 md:grid-cols-2">
      {
        steps.map((step, index) => (
          <li class="relative flex gap-5 overflow-hidden border border-outline-variant/20 bg-surface-container p-6 pl-8">
            <span class="absolute inset-y-0 left-0 w-2 bg-primary" aria-hidden="true" />
            <span
              class="flex size-9 shrink-0 items-center justify-center bg-primary font-black text-on-primary tnum"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div>
              <h3 class="text-title-lg">
                <span class="sr-only">Step {index + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-2 leading-relaxed text-on-surface-variant text-pretty">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-3xl leading-relaxed text-pretty">
      Want a chance to win a one-month RTC bus pass?{' '}
      <a href="/giveaway" class="body-link font-semibold">Enter the giveaway</a> once a day, October 1
      to 8: tag @lasvegasfortransit on Instagram, upload a screenshot, or enter with your email address
      or phone number. No purchase or post necessary.{' '}
      <a href="/giveaway/rules" class="body-link font-semibold">See the Official Rules</a>.
    </p>
  </section>

  {/* PICK YOUR PLEDGE */}
  <section
    id="pledge"
    class="container-page scroll-mt-24 border-t border-outline-variant/15 py-12 md:py-16"
    aria-labelledby="pledge-heading"
  >
    <h2 id="pledge-heading" class="text-headline-lg">Pick your pledge</h2>
    <p class="lede mt-3 max-w-2xl">
      Every pledge counts the same. Already get around without a car? Pledge too. Your everyday
      trips are what this week is about.
    </p>

    {
      /* Returning-pledger state (remembered-pledge). Hidden until the pledge
       cookie is found, so first-time visitors never see it flash. */
    }
    <div data-pledge-returning hidden class="mt-8 border border-outline bg-surface-container p-5">
      <p class="leading-relaxed">
        <span data-returning-message>You’re pledged for One Day.</span> To change it, pick another tier
        and tap I’m in.
      </p>
      <p class="mt-2">
        <a data-returning-kit-link href="/pledged/day" class="body-link font-semibold"
          >View your kit</a
        >
      </p>
      <p class="mt-3 text-sm text-on-surface-variant">
        Pledging for someone else?{' '}
        <a href="/take-part" data-start-new-pledge class="body-link font-semibold"
          >Start a new pledge</a
        >
      </p>
    </div>

    {/* Ended state, shown from 12:00 am October 9, 2026 Las Vegas time. */}
    <div data-pledge-ended hidden class="mt-8 border border-outline bg-surface-container p-6">
      <p class="text-title-lg">
        Week Without Driving 2026 has ended. Thanks to everyone who took part.
      </p>
      <p class="mt-4">
        <a
          data-ended-kit-link
          href="/pledged/day"
          hidden
          class="press inline-flex items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
          >View your kit</a
        >
      </p>
    </div>

    <form data-pledge-form class="mt-8 max-w-2xl" novalidate>
      <div
        role="radiogroup"
        aria-labelledby="pledge-heading"
        class="grid gap-4 md:grid-cols-3"
        data-tier-group
      >
        {
          pledgeTiers.map((tier) => (
            <label class="tier-card" data-tier-card>
              <input type="radio" name="tier" value={tier.id} class="tier-card__input" />
              <span class="tier-card__check" aria-hidden="true" />
              <span class="tier-card__name">{tier.name}</span>
              <span class="tier-card__description">{tier.description}</span>
            </label>
          ))
        }
      </div>
      <p data-tier-error class="mt-3 text-sm font-semibold text-primary-ink" aria-live="polite"></p>

      <div class="mt-8 max-w-md">
        <label for="pledge-email" class="text-title-sm font-bold">Email (optional)</label>
        <input
          id="pledge-email"
          name="email"
          type="email"
          autocomplete="email"
          class="field mt-2 w-full"
        />
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
          We use your email only to send your kit, and we delete it on November 30, 2026. Read our
          {' '}<a href="/privacy" class="body-link">Privacy page</a>.
        </p>

        <label class="check-row mt-4">
          <input type="checkbox" name="kitEmail" data-kit-email-box />
          <span>Email me a copy of my participant kit</span>
        </label>

        <label class="check-row mt-3">
          <input type="checkbox" name="newsletter" />
          <span
            >Also send me LVBT’s newsletter: transit news and easy ways to help in Las Vegas</span
          >
        </label>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
          The newsletter comes from LVBT, not this campaign, so your subscription isn’t deleted on
          November 30. You can unsubscribe at any time. See our{' '}
          <a href="/privacy" class="body-link">Privacy page</a>.
        </p>

        <p data-email-error class="mt-3 text-sm font-semibold text-primary-ink" aria-live="polite">
        </p>
      </div>

      <div class="mt-8 flex flex-col items-start gap-3">
        <button
          type="submit"
          data-pledge-submit
          class="press inline-flex items-center gap-2 bg-primary px-8 py-4 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
        >
          I’m in
        </button>
        <p data-pledge-status class="text-sm font-semibold text-primary-ink" aria-live="polite"></p>
      </div>

      <noscript>
        <style>
          [data-pledge-submit] {
            display: none;
          }
        </style>
        <p class="mt-4 text-sm font-semibold text-primary-ink">
          Pledging needs JavaScript turned on in your browser.
        </p>
      </noscript>
    </form>
  </section>

  <script is:inline src="/scripts/pledge-form.js" defer></script>
</BaseLayout>

<style>
  /* The three tier cards as a radio group. Native <input type="radio"> for
     free keyboard/screen-reader semantics; the card itself is the label so
     the whole area is one 44px+ tap target. Checked state is drawn from
     :has() rather than JS, so it works even before pledge-form.js runs. */
  .tier-card {
    position: relative;
    display: flex;
    min-height: 44px;
    cursor: pointer;
    flex-direction: column;
    gap: 0.375rem;
    border: 1px solid var(--color-outline-variant);
    background: var(--color-surface-container);
    padding: 1.25rem 1.25rem 1.25rem 3.25rem;
    transition:
      border-color 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }
  .tier-card:hover {
    border-color: var(--color-primary);
  }
  .tier-card:has(.tier-card__input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-container);
  }
  .tier-card:has(.tier-card__input:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .tier-card__input {
    position: absolute;
    /* Visually hidden but still in the tab order and readable by screen
       readers (not display:none / visibility:hidden). */
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tier-card__check {
    position: absolute;
    top: 1.1rem;
    left: 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--color-outline);
    border-radius: 9999px;
  }
  .tier-card:has(.tier-card__input:checked) .tier-card__check {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow: inset 0 0 0 3px var(--color-primary-container);
  }
  .tier-card__name {
    font-weight: 700;
    font-size: var(--text-title-lg);
  }
  .tier-card__description {
    color: var(--color-on-surface-variant);
    line-height: 1.4;
  }

  .field {
    display: block;
    min-height: 44px;
    border: 1px solid var(--color-outline-variant);
    background: var(--color-surface);
    padding: 0.625rem 0.875rem;
  }
  .field:focus-visible {
    box-shadow: inset 0 -4px 0 var(--color-primary);
  }

  .check-row {
    display: flex;
    min-height: 44px;
    cursor: pointer;
    align-items: center;
    gap: 0.75rem;
    line-height: 1.4;
  }
  .check-row input {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    accent-color: var(--color-primary);
  }
</style>
