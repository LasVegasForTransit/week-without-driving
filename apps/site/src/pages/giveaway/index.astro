---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import Steps from '../../components/Steps.astro';
import { prizes, winSteps } from '../../lib/campaign';
import { wwd } from '../../lib/wwd';

// Win prizes, /giveaway. Each day a participant shares a trip they took
// without driving is one entry: a public post, submitted on My week or
// tagging @lasvegasfortransit, or a screenshot of the post from a private
// account. The free way to enter, for people without social media, is by
// mail. Signing up happens once, at /sign-up; this
// page explains the giveaway and points there.

const title = 'Win prizes · Week Without Driving Las Vegas';
const description =
  'Each day you share a trip without driving, October 1 to 8, is a chance to win a one-month RTC bus pass and an LVBT sticker pack.';
---

<BaseLayout {title} {description}>
  <PageHeader
    title="Win prizes"
    lede={`Each day from October 1 to 8 that you share a trip without driving is one entry, up to ${wwd.maxEntries}. No social media? You can enter by mail.`}
  >
    <div class="giveaway-cta">
      <a href="/sign-up" class="btn btn--primary btn--big" data-signup-link>
        <span data-signup-label>Sign up to win</span>
      </a>
    </div>
  </PageHeader>

  {/* PRIZES */}
  <section class="container-page section" aria-labelledby="prizes-heading">
    <h2 id="prizes-heading" class="section-title">The prizes</h2>
    <ul class="section-body giveaway-prizes">
      {
        prizes.map((prize) => (
          <li class="giveaway-prize">
            <PhotoSlot
              class="giveaway-prize__photo"
              shows={prize.photo}
              photo={prize.image}
              icon={prize.icon}
              sizes="(min-width: 48rem) 36rem, 100vw"
            />
            <div class="giveaway-prize__text">
              <h3 class="giveaway-prize__name">{prize.name}</h3>
              <p class="giveaway-prize__body">{prize.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* HOW TO ENTER */}
  <section class="container-page section scroll-mt-24" aria-labelledby="enter-heading">
    <h2 id="enter-heading" class="section-title">How to enter</h2>
    <Steps steps={winSteps} class="section-body" />
    <p class="section-intro giveaway-note">
      Post on Instagram and tag @lasvegasfortransit, and we count it for you. Posting somewhere
      else, or from a private account? Paste the link, or a screenshot, on My week. We check every
      post before the draw.
    </p>
  </section>

  {/* ENTER BY MAIL: the free way to enter, for people without social media. */}
  <section id="by-mail" class="container-page section scroll-mt-24" aria-labelledby="mail-heading">
    <h2 id="mail-heading" class="section-title">No social media? Enter by mail.</h2>
    <p class="section-intro">
      For each day you take a trip without driving, October 1 to 8, mail us a handwritten postcard
      or letter. Each one is one entry for that day, the same as a shared trip.
    </p>
    {/* data-seen-event: these steps coming into view is counted (app.js). */}
    <ol class="section-body giveaway-mail" data-seen-event="mail_in_viewed">
      <li>Write your first name, and the phone number or email you signed up with.</li>
      <li>Write the date of your trip, and how you got around without driving.</li>
      <li>
        Mail it the same day. It must be postmarked October 1 to 8 and reach us by October 13.
      </li>
    </ol>
    <div class="giveaway-address">
      <p class="font-bold">Mail it to</p>
      <p>Las Vegans for Better Transit, Week Without Driving Giveaway</p>
      <p class="mt-2">
        Email <a href="mailto:wwd@lasvegasfortransit.org" class="body-link"
          >wwd@lasvegasfortransit.org</a
        > for the mailing address.
      </p>
    </div>
  </section>

  {/* THE SHORT VERSION OF THE RULES */}
  <section class="container-page section" aria-labelledby="rules-heading">
    <h2 id="rules-heading" class="section-title">The short version of the rules</h2>
    <ul class="section-body giveaway-rules">
      <li>The giveaway is open to people who live in Southern Nevada and are 13 or older.</li>
      <li>If you’re 13 to 17, a parent or guardian agrees to the Official Rules for you.</li>
      <li>
        You get one entry for each day, October 1 to 8, that you share a trip you took without
        driving, for up to 8 entries.
      </li>
      <li>No purchase is necessary. You can also enter by mail, below.</li>
      <li>We draw a winner at random by October 15, 2026. Each entry is one chance.</li>
      <li>The winner has 7 days to reply before we draw someone else.</li>
    </ul>
    <a href="/giveaway/rules" class="arrow-link giveaway-rules__link">Read the Official Rules</a>
  </section>
</BaseLayout>

<style>
  .giveaway-cta {
    margin-top: 1.5rem;
  }
  .giveaway-prizes {
    display: grid;
    gap: 1.25rem;
  }
  .giveaway-prize {
    overflow: hidden;
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .giveaway-prize :global(.giveaway-prize__photo) {
    aspect-ratio: 16 / 9;
  }
  .giveaway-prize__text {
    padding: 1.1rem 1.25rem 1.35rem;
  }
  .giveaway-prize__name {
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .giveaway-prize__body {
    margin-top: 0.35rem;
    color: var(--color-on-surface-variant);
  }
  .giveaway-note {
    margin-top: 2rem;
  }
  .giveaway-rules {
    display: grid;
    gap: 0.6rem;
    max-width: 40rem;
    padding-left: 1.25rem;
    font-size: 1.1rem;
    line-height: 1.5;
    list-style: disc;
  }
  .giveaway-mail {
    display: grid;
    gap: 0.6rem;
    max-width: 40rem;
    padding-left: 1.4rem;
    font-size: 1.1rem;
    line-height: 1.5;
    list-style: decimal;
  }
  .giveaway-address {
    max-width: 30rem;
    margin-top: 1.5rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .giveaway-rules__link {
    margin-top: 1.25rem;
  }
  @media (min-width: 48rem) {
    .giveaway-prizes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
