---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import Steps from '../../components/Steps.astro';
import { mysteryPrize, prizes, winSteps } from '../../lib/campaign';
import { wwd } from '../../lib/wwd';

// The giveaway: one eligible trip description per day on My week, with an
// optional post, screenshot or registered Instagram tag.

const title = 'Win a bus pass · Week Without Driving Las Vegas';
const description =
  'Describe a trip without driving each day, October 1 to 8, for a chance to win a 30-day RTC bus pass.';
---

<BaseLayout {title} {description}>
  <PageHeader
    title="Win a bus pass"
    lede={`Each day from October 1 to 8 that you describe a trip without driving is one entry, up to ${wwd.maxEntries}. No post or purchase is needed.`}
  >
    <div class="giveaway-cta">
      <a href="/sign-up" class="btn btn--primary btn--big" data-signup-link>
        <span data-signup-label>Sign up to win</span>
      </a>
    </div>
  </PageHeader>

  {/* PRIZE */}
  <section class="container-page section" aria-labelledby="prizes-heading">
    <h2 id="prizes-heading" class="section-title">Prizes</h2>
    <ul class="section-body giveaway-prizes">
      {
        [...prizes, mysteryPrize].map((prize) => (
          <li class="giveaway-prize">
            <PhotoSlot
              class="giveaway-prize__photo"
              shows={prize.photo}
              photo={prize.image}
              icon={prize.icon}
              sizes="(min-width: 48rem) 36rem, 100vw"
            />
            <div class="giveaway-prize__text">
              <h3 class="giveaway-prize__name">{prize.name}</h3>
              <p class="giveaway-prize__body">{prize.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* HOW TO ENTER */}
  <section class="container-page section scroll-mt-24" aria-labelledby="enter-heading">
    <h2 id="enter-heading" class="section-title">How to enter</h2>
    <Steps steps={winSteps} class="section-body" />
    <p class="section-intro giveaway-note">
      A post is optional. If you share one, you can add its link or screenshot on My week. If you
      registered your Instagram handle and tag @lasvegasfortransit, we can count that trip for you.
      Every entry is reviewed before the draw.
    </p>
  </section>

  {/* THE SHORT VERSION OF THE RULES */}
  <section class="container-page section" aria-labelledby="rules-heading">
    <h2 id="rules-heading" class="section-title">The short version of the rules</h2>
    <ul class="section-body giveaway-rules">
      <li>
        The giveaway is open to residents of Clark, Esmeralda, Lincoln and Nye counties who are 13
        or older.
      </li>
      <li>If you’re 13 to 17, a parent or guardian agrees to the Official Rules for you.</li>
      <li>
        You get one entry for each day, October 1 to 8, that you describe a trip you took without
        driving, for up to 8 entries.
      </li>
      <li>No purchase or social media post is necessary.</li>
      <li>By October 15, 2026, LVBT will draw one winner at random and email the winner.</li>
      <li>The winner must reply to that email within 7 days.</li>
    </ul>
    <a href="/giveaway/rules" class="arrow-link giveaway-rules__link">Read the Official Rules</a>
  </section>
</BaseLayout>

<style>
  .giveaway-cta {
    margin-top: 1.5rem;
  }
  .giveaway-prizes {
    display: grid;
    gap: 1.25rem;
  }
  .giveaway-prize {
    overflow: hidden;
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .giveaway-prize :global(.giveaway-prize__photo) {
    aspect-ratio: 16 / 9;
  }
  .giveaway-prize__text {
    padding: 1.1rem 1.25rem 1.35rem;
  }
  .giveaway-prize__name {
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .giveaway-prize__body {
    margin-top: 0.35rem;
    color: var(--color-on-surface-variant);
  }
  .giveaway-note {
    margin-top: 2rem;
  }
  .giveaway-rules {
    display: grid;
    gap: 0.6rem;
    max-width: 40rem;
    padding-left: 1.25rem;
    font-size: 1.1rem;
    line-height: 1.5;
    list-style: disc;
  }
  .giveaway-rules__link {
    margin-top: 1.25rem;
  }
  @media (min-width: 48rem) {
    .giveaway-prizes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
