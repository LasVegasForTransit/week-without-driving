---
import BaseLayout from '../layouts/BaseLayout.astro';
import WinBand from '../components/WinBand.astro';
import { destinations, finderPlaces } from '../lib/destinations';
import { parseInlineLinks } from '../lib/inline-links';
import { buildMapLinks } from '../lib/map-links';

// The Go page: "Find a bus" shows the bus stops nearest the visitor, or
// nearest a place they pick without sharing their location, and "Places to
// go" gives step-by-step directions to seven places across the valley. The
// places, steps and map points live in src/lib/destinations.ts, with when
// and where their facts were checked.
//
// The finder runs in the browser (public/scripts/nearest-routes.js, with
// public/scripts/map-links.js for its map buttons) against
// public/data/stops.json and public/data/routes.json, which
// scripts/build-stops.mjs makes from RTC's GTFS feed. Nothing here calls an
// API or sends the visitor's location anywhere.
//
// "Places to go" is plain HTML made at build time, so it shows with
// JavaScript off and is saved for offline use with the page. Its map
// buttons come from buildMapLinks, which stops the build if a point is not
// a real latitude and longitude.

const description =
  'Find the bus stops nearest you, or a chosen place, and get plain directions to seven places across the Las Vegas Valley.';

function slugify(label: string): string {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const mapButtonClass =
  'press inline-flex min-h-11 items-center gap-2 border border-outline px-5 py-2.5 font-semibold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface';
---

<BaseLayout title="Find a bus · Week Without Driving Las Vegas" description={description}>
  {/* FIND A BUS — the nearest-route finder, straight under the title */}
  <section
    id="find-routes"
    class="container-page page-top scroll-mt-24"
    aria-labelledby="find-routes-heading"
  >
    <h1 id="find-routes-heading" class="page-title">Find a bus</h1>
    <p class="page-lede">
      See the five bus stops closest to you and the routes that stop there. Or pick a place you
      already know.
    </p>

    <div data-finder class="mt-8 max-w-2xl">
      <noscript>
        <p class="border border-outline bg-surface-container p-5 leading-relaxed">
          Finding stops needs JavaScript turned on in your browser.
        </p>
      </noscript>

      {
        /* Shown by nearest-routes.js, which loads the stop data the first
        time someone asks for stops (see its `ensureData()`). Keeps the
        controls off the page entirely with JavaScript off, matching the
        noscript message above. */
      }
      <div data-finder-app hidden>
        <div class="flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-use-location
            class="press inline-flex min-h-11 items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
          >
            Use my location
          </button>
          <div class="flex flex-wrap items-center gap-2">
            <label for="place-select" class="font-semibold">Or pick a place:</label>
            <select
              id="place-select"
              data-place-select
              class="min-h-11 w-full max-w-full border border-outline bg-surface px-3 py-2 font-semibold sm:w-auto"
            >
              <option value="">Choose a place</option>
              {
                finderPlaces.map((place) => (
                  <option value={slugify(place.label)} data-lat={place.lat} data-lng={place.lng}>
                    {place.label}
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">
          Your location stays on your phone. It is never sent to us or saved.
        </p>

        <p data-finder-status role="status" aria-live="polite" hidden class="mt-6 font-semibold">
        </p>
        <p data-finder-announce class="sr-only" role="status" aria-live="polite"></p>

        <h3 data-results-heading hidden class="text-title-lg mt-8"></h3>
        <ol data-results-list hidden class="mt-4 space-y-4"></ol>

        <div
          data-finder-notes
          hidden
          class="mt-6 space-y-3 text-sm leading-relaxed text-on-surface-variant"
        >
          <p>Distances are in a straight line. The walk or roll is usually a little longer.</p>
          <p>
            RTC's stop data doesn't say whether a stop has a curb ramp, a bench or shade. If one of
            these stops is hard to reach, tell us with a{' '}
            <a href="/guides/sidewalk-audit" class="body-link">sidewalk audit</a>.
          </p>
          <p data-data-credit class="text-xs"></p>
        </div>
      </div>

      <p
        data-finder-nodata
        hidden
        class="border border-outline bg-surface-container p-5 leading-relaxed"
      >
        Stop data isn't saved on this phone yet. Open this page once with a connection, and it will
        work offline after that.
      </p>
    </div>
  </section>

  {/* PLACES TO GO — the seven destination guides */}
  <section
    id="places-to-go"
    class="scroll-mt-24 bg-surface-container"
    aria-labelledby="places-to-go-heading"
  >
    <div class="container-page border-t border-outline-variant/15 py-16 md:py-24">
      <h2 id="places-to-go-heading" class="text-headline-lg">Places to go</h2>

      <div class="mt-12 space-y-16">
        {
          destinations.map((destination) => (
            <article id={destination.anchor} class="scroll-mt-24 border-t-2 border-outline pt-8">
              <h3 class="text-headline-md">{destination.heading}</h3>
              <p class="mt-3 max-w-2xl leading-relaxed text-pretty">{destination.intro}</p>

              <h4 class="mt-6 text-title-md">How to get there</h4>
              <ol class="mt-3 max-w-2xl list-decimal space-y-3 pl-5 leading-relaxed text-pretty">
                {destination.steps.map((step) => (
                  <li>
                    {parseInlineLinks(step).map((segment) =>
                      segment.href ? (
                        <a href={segment.href} class="body-link">
                          {segment.text}
                        </a>
                      ) : (
                        segment.text
                      ),
                    )}
                  </li>
                ))}
              </ol>

              <div class="mt-6 space-y-4">
                {destination.buttonRows.map((row) => {
                  const links = buildMapLinks(row.lat, row.lng, row.placeName);
                  return (
                    <div>
                      {row.rowLabel && (
                        <p class="mb-2 text-sm font-bold text-on-surface-variant">{row.rowLabel}</p>
                      )}
                      <div class="flex flex-wrap gap-2">
                        <a
                          href={links.google}
                          aria-label={links.labels.google}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={mapButtonClass}
                        >
                          Google Maps
                        </a>
                        <a
                          href={links.apple}
                          aria-label={links.labels.apple}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={mapButtonClass}
                        >
                          Apple Maps
                        </a>
                        <a
                          href={links.transit}
                          aria-label={links.labels.transit}
                          class={mapButtonClass}
                        >
                          Transit app
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
              <p class="mt-3 text-sm text-on-surface-variant">
                The Transit app button needs the Transit app installed.
              </p>

              {destination.note && (
                <div class="mt-6 border-l-4 border-primary bg-surface py-3 pl-5">
                  <p class="font-bold">{destination.note.heading}</p>
                  <p class="mt-1 leading-relaxed text-pretty">{destination.note.text}</p>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/map-links.js" defer></script>
  <script is:inline src="/scripts/nearest-routes.js" defer></script>
  <WinBand />
</BaseLayout>
