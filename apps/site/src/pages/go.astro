---
import BaseLayout from '../layouts/BaseLayout.astro';
import WinBand from '../components/WinBand.astro';
import { buildMapLinks } from '../lib/map-links';

// The Go page: find the bus stops nearest you (or a chosen place, without
// sharing your location), and step-by-step directions to seven places
// across the valley. Copy and behavior are written to the Docket Features
// "Show the bus stops and routes nearest the visitor"
// (01M35FM4H2WSKN1MJWHCCY34EX), "Show stops near a chosen place without
// sharing location" (01M35FM4MJHBSK3TVZHDVKRMBA) and "Give step-by-step
// directions to places across the valley" (01M35FM3YFPZYDX8X5TZJAW0ZZ), and
// to the Engineering Tasks "Build the nearest-route finder"
// (01M357CW9ZM9FKQK1SGM6FMV78) and "Write and build the destination
// guides" (01M357CVPTSTRNXF8SJJB1HW3C). Every visible string below is taken
// from those documents' Copy tables and Specification sections verbatim,
// except the page's own one-line introduction, which those documents do
// not specify.
//
// The finder itself (src/lib/map-links.ts's build-time twin is
// public/scripts/map-links.js) runs from public/scripts/nearest-routes.js
// against public/data/stops.json and public/data/routes.json, generated
// from RTC's GTFS feed by scripts/build-stops.mjs. Nothing here calls an
// API or sends the visitor's location anywhere; see that script's header
// comment for how the data files are built and kept under the 300 KB
// (gzip) budget.

const description =
  'Find the bus stops nearest you, or a chosen place, and get plain directions to seven places across the Las Vegas Valley.';

// The seven places a visitor can choose instead of sharing their location.
// Alphabetical, per the Feature "Show stops near a chosen place without
// sharing location". Coordinates match that Feature and the Engineering
// Task's place table exactly.
const places = [
  { label: 'Craig Ranch Park, North Las Vegas', lat: 36.2403, lng: -115.154 },
  { label: 'Downtown Las Vegas', lat: 36.17048, lng: -115.14353 },
  { label: 'East Las Vegas Library', lat: 36.1729, lng: -115.1105 },
  { label: 'Henderson Water Street', lat: 36.03001, lng: -114.97951 },
  { label: 'Summerlin Centre', lat: 36.14977, lng: -115.33355 },
  { label: 'The Strip at Flamingo', lat: 36.1162, lng: -115.1745 },
  { label: 'UNLV', lat: 36.10605, lng: -115.1387 },
] as const;

function slugify(label: string): string {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

interface ButtonRow {
  rowLabel?: string;
  lat: number;
  lng: number;
  placeName: string;
}

interface Destination {
  anchor: string;
  heading: string;
  intro: string;
  // Step text is fixed, LVBT-authored copy, not visitor input; a few steps
  // contain a trusted inline link (to a guide) so they're rendered with
  // set:html.
  steps: string[];
  buttonRows: ButtonRow[];
  note?: { heading: string; text: string };
}

const destinations: Destination[] = [
  {
    anchor: 'downtown',
    heading: 'Downtown Las Vegas and the Arts District',
    intro:
      'Fremont Street and the Arts District (also called 18b) sit side by side downtown, about a 15-minute walk or roll apart.',
    steps: [
      "From elsewhere in the valley, take any route that ends at Bonneville Transit Center, downtown's main RTC bus station. These include the RED LINE, BHX, CX and routes 105, 106, 108, 113, 206, 207, 208, 214 and 215.",
      'From the Strip, take the Deuce north. It runs along Las Vegas Boulevard 24 hours a day and ends downtown. The Deuce has its own fare; see <a href="/guides/pay-your-fare" class="body-link">Pay your bus fare</a>.',
      'For the Arts District, get off the Deuce at Casino Center at Coolidge, in the middle of the district, or walk or roll about 10 minutes south from Bonneville Transit Center. For Fremont Street, stay on the Deuce past Bonneville Transit Center and get off at 4th Street at Fremont Street Experience, or walk or roll about 10 minutes north from Bonneville Transit Center. Route 108 also runs through the Arts District on Main Street and Commerce Street.',
    ],
    buttonRows: [
      { rowLabel: 'Fremont Street', lat: 36.17048, lng: -115.14353, placeName: 'Fremont Street' },
      { rowLabel: 'Arts District', lat: 36.15953, lng: -115.15128, placeName: 'the Arts District' },
    ],
  },
  {
    anchor: 'east-las-vegas-library',
    heading: 'East Las Vegas Library',
    intro: 'A public library at 2851 E Bonanza Rd in East Las Vegas.',
    steps: [
      'Take Route 215 (Bonanza) along Bonanza Road. Going east, get off at Bonanza after 28th. Going west, get off at Bonanza after Wardelle. Both stops are within 0.1 mile of the library, a short walk or roll.',
      "Route 215 starts at Bonneville Transit Center, downtown's main RTC bus station. If you're on Route 110 (Eastern), change to Route 215 at Eastern Avenue and Bonanza Road.",
      'To head home, catch Route 215 from the stop across the street, going the other way. The library is a cool place to rest while you wait.',
    ],
    buttonRows: [{ lat: 36.1729, lng: -115.1105, placeName: 'East Las Vegas Library' }],
  },
  {
    anchor: 'craig-ranch-park',
    heading: 'Craig Ranch Regional Park, North Las Vegas',
    intro:
      'A large city park on Craig Road in North Las Vegas, with paths, playgrounds and an amphitheater.',
    steps: [
      'Take Route 219 (Craig Rd) along Craig Road and get off at Craig after Revere. There is a stop on each side of the road, and the park is about 0.1 mile away, a short walk or roll.',
      'From downtown, take Route 105 (Martin L. King) north from Bonneville Transit Center. Get off at Camino Al Norte after Craig and change to Route 219 going east.',
      'To head home, take the same routes going the other way, from the stops across the street.',
    ],
    buttonRows: [{ lat: 36.243, lng: -115.154, placeName: 'Craig Ranch Regional Park' }],
  },
  {
    anchor: 'water-street-henderson',
    heading: 'Water Street District, Henderson',
    intro: 'Downtown Henderson, with shops and places to eat along Water Street.',
    steps: [
      'Take the BHX (Boulder Highway Express), which runs between Bonneville Transit Center downtown and Henderson along Boulder Highway. Only some BHX buses stop near Water Street: take a bus marked BHX-A and get off at Basic after Water. From there, walk or roll about 0.2 mile to Water Street.',
      'From elsewhere in the valley, change to the BHX at Bonneville Transit Center or at any BHX stop on Boulder Highway.',
      'To head home, catch the BHX at Basic after Texas, going west.',
    ],
    buttonRows: [{ lat: 36.0306, lng: -114.982, placeName: 'Water Street District' }],
  },
  {
    anchor: 'unlv',
    heading: 'UNLV campus',
    intro:
      'The University of Nevada, Las Vegas (UNLV) campus is on Maryland Parkway between Flamingo Road and Tropicana Avenue.',
    steps: [
      "Take the RED LINE, RTC's rapid bus along Maryland Parkway, and get off at University Road. Going north, the stop is Maryland after University Rd. Going south, it is Maryland before University Rd.",
      'Or take Route 201 (Tropicana) and get off at Tropicana after Maryland, at the south end of campus.',
      'From Maryland Parkway and University Road, walk or roll west into campus. The Student Union is about 3 minutes away.',
    ],
    buttonRows: [{ lat: 36.10605, lng: -115.1387, placeName: 'the UNLV campus' }],
  },
  {
    anchor: 'sunset-park',
    heading: 'Sunset Park',
    intro:
      'A large county park with shady picnic areas, a lake and paths, at Eastern Avenue and Sunset Road.',
    steps: [
      "Take Route 110 (Eastern). Going north, get off at Eastern at Sunset Park. Going south, get off at Eastern after Pama. Both stops are on the park's west side.",
      "Or take Route 212 (Sunset) along Sunset Road and get off at Eastern Avenue, at the park's northwest corner.",
      'To head home, catch the same route from the stop across the street, going the other way. Bring water, because the park\'s paths are long and some are in full sun. <a href="/guides/heat" class="body-link">Walk or roll in the heat</a> has more tips.',
    ],
    buttonRows: [{ lat: 36.06431, lng: -115.11359, placeName: 'Sunset Park' }],
  },
  {
    anchor: 'allegiant-stadium',
    heading: 'Allegiant Stadium on Raiders game day',
    intro:
      'The Raiders play the Kansas City Chiefs at Allegiant Stadium on Sunday, October 4, at 1:25 pm, during the week.',
    steps: [
      "Take RTC's Game Day Express, RTC's special event bus service to stadium games. On Raiders home game days it runs from six casinos: Red Rock (Summerlin), Santa Fe Station (Centennial Hills), Aliante (North Las Vegas), Sam's Town (East Las Vegas), Green Valley Ranch (Henderson) and M Resort (southwest Henderson). It costs $2 each way or $4 round trip: buy it in rideRTC up to seven days ahead, or tap a debit card, credit card or phone wallet when you board.",
      'For a 1:25 pm kickoff, buses start at about 9:30 am and leave about every 30 minutes. The last bus leaves one hour before kickoff. Buses drop you at the southeast corner of the stadium on Dean Martin Drive, next to Gate 11.',
      "After the game, buses leave from the same corner for up to 40 minutes after it ends. If you're heading to the Strip instead, walk or roll east over the Hacienda Avenue bridge to Las Vegas Boulevard, about 20 minutes, and catch the Deuce at Mandalay Bay.",
    ],
    buttonRows: [{ lat: 36.09074, lng: -115.18333, placeName: 'Allegiant Stadium' }],
    note: {
      heading: 'Getting there by wheelchair or walker',
      text: "The Hacienda Avenue bridge in step 3 is long and slopes up and down. If that's hard for you, take the Game Day Express back from the stadium instead.",
    },
  },
];
---

<BaseLayout title="Find a bus · Week Without Driving Las Vegas" description={description}>
  {/* FIND A BUS — the nearest-route finder, straight under the title */}
  <section
    id="find-routes"
    class="container-page page-top scroll-mt-24"
    aria-labelledby="find-routes-heading"
  >
    <h1 id="find-routes-heading" class="page-title">Find a bus</h1>
    <p class="page-lede">
      See the five bus stops closest to you and the routes that stop there. Or pick a place you
      already know.
    </p>

    <div data-finder class="mt-8 max-w-2xl">
      <noscript>
        <p class="border border-outline bg-surface-container p-5 leading-relaxed">
          Finding stops needs JavaScript turned on in your browser.
        </p>
      </noscript>

      {
        /* Shown by nearest-routes.js, which loads the stop data the first
        time someone asks for stops (see its `ensureData()`). Keeps the
        controls off the page entirely with JavaScript off, matching the
        noscript message above. */
      }
      <div data-finder-app hidden>
        <div class="flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-use-location
            class="press inline-flex min-h-11 items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
          >
            Use my location
          </button>
          <div class="flex flex-wrap items-center gap-2">
            <label for="place-select" class="font-semibold">Or pick a place:</label>
            <select
              id="place-select"
              data-place-select
              class="min-h-11 w-full max-w-full border border-outline bg-surface px-3 py-2 font-semibold sm:w-auto"
            >
              <option value="">Choose a place</option>
              {
                places.map((place) => (
                  <option value={slugify(place.label)} data-lat={place.lat} data-lng={place.lng}>
                    {place.label}
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">
          Your location stays on your phone. It is never sent to us or saved.
        </p>

        <p data-finder-status role="status" aria-live="polite" hidden class="mt-6 font-semibold">
        </p>
        <p data-finder-announce class="sr-only" role="status" aria-live="polite"></p>

        <h3 data-results-heading hidden class="text-title-lg mt-8"></h3>
        <ol data-results-list hidden class="mt-4 space-y-4"></ol>

        <div
          data-finder-notes
          hidden
          class="mt-6 space-y-3 text-sm leading-relaxed text-on-surface-variant"
        >
          <p>Distances are in a straight line. The walk or roll is usually a little longer.</p>
          <p>
            RTC's stop data doesn't say whether a stop has a curb ramp, a bench or shade. If one of
            these stops is hard to reach, tell us with a{' '}
            <a href="/guides/sidewalk-audit" class="body-link">sidewalk audit</a>.
          </p>
          <p data-data-credit class="text-xs"></p>
        </div>
      </div>

      <p
        data-finder-nodata
        hidden
        class="border border-outline bg-surface-container p-5 leading-relaxed"
      >
        Stop data isn't saved on this phone yet. Open this page once with a connection, and it will
        work offline after that.
      </p>
    </div>
  </section>

  {/* PLACES TO GO — the seven destination guides */}
  <section
    id="places-to-go"
    class="scroll-mt-24 bg-surface-container"
    aria-labelledby="places-to-go-heading"
  >
    <div class="container-page border-t border-outline-variant/15 py-16 md:py-24">
      <h2 id="places-to-go-heading" class="text-headline-lg">Places to go</h2>

      <div class="mt-12 space-y-16">
        {
          destinations.map((destination) => (
            <article id={destination.anchor} class="scroll-mt-24 border-t-2 border-outline pt-8">
              <h3 class="text-headline-md">{destination.heading}</h3>
              <p class="mt-3 max-w-2xl leading-relaxed text-pretty">{destination.intro}</p>

              <h4 class="mt-6 text-title-md">How to get there</h4>
              <ol class="mt-3 max-w-2xl list-decimal space-y-3 pl-5 leading-relaxed text-pretty">
                {destination.steps.map((step) => (
                  <li set:html={step} />
                ))}
              </ol>

              <div class="mt-6 space-y-4">
                {destination.buttonRows.map((row) => {
                  const links = buildMapLinks(row.lat, row.lng, row.placeName);
                  return (
                    <div>
                      {row.rowLabel && (
                        <p class="mb-2 text-sm font-bold text-on-surface-variant">{row.rowLabel}</p>
                      )}
                      <div class="flex flex-wrap gap-2">
                        <a
                          href={links.google}
                          aria-label={links.labels.google}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="press inline-flex min-h-11 items-center gap-2 border border-outline px-5 py-2.5 font-semibold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
                        >
                          Google Maps
                        </a>
                        <a
                          href={links.apple}
                          aria-label={links.labels.apple}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="press inline-flex min-h-11 items-center gap-2 border border-outline px-5 py-2.5 font-semibold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
                        >
                          Apple Maps
                        </a>
                        <a
                          href={links.transit}
                          aria-label={links.labels.transit}
                          class="press inline-flex min-h-11 items-center gap-2 border border-outline px-5 py-2.5 font-semibold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
                        >
                          Transit app
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
              <p class="mt-3 text-sm text-on-surface-variant">
                The Transit app button needs the Transit app installed.
              </p>

              {destination.note && (
                <div class="mt-6 border-l-4 border-primary bg-surface py-3 pl-5">
                  <p class="font-bold">{destination.note.heading}</p>
                  <p class="mt-1 leading-relaxed text-pretty">{destination.note.text}</p>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/map-links.js" defer></script>
  <script is:inline src="/scripts/nearest-routes.js" defer></script>
  <WinBand />
</BaseLayout>
