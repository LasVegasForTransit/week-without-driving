---
import BaseLayout from '../layouts/BaseLayout.astro';
import WinBand from '../components/WinBand.astro';
import { destinations, finderPlaces, routesIn } from '../lib/destinations';
import routeData from '../../public/data/routes.json';
import { parseInlineLinks } from '../lib/inline-links';
import { buildMapLinks } from '../lib/map-links';
import { comparePublished } from '../lib/compare-release';
import { fares, wwd } from '../lib/wwd';
import { Icon } from 'astro-icon/components';

// The Go page. "Where to?" comes first: type a place and it opens transit
// directions in Google Maps, Apple Maps or the Transit app, with a short
// "Before you go" list (public/scripts/where-to.js). It needs no account,
// and the places typed stay in the address of the map app the visitor
// opens. "Find a bus" shows the bus stops nearest the visitor, or
// nearest a place they pick without sharing their location, and "Places to
// go" gives step-by-step directions to seven places across the valley. The
// places, steps and map points live in src/lib/destinations.ts, with when
// and where their facts were checked.
//
// The finder runs in the browser (public/scripts/nearest-routes.js, with
// public/scripts/map-links.js for its map buttons) against
// public/data/stops.json and public/data/routes.json, which
// scripts/build-stops.mjs makes from RTC's GTFS feed. Nothing here calls an
// API or sends the visitor's location anywhere.
//
// "Places to go" is plain HTML made at build time, so it shows with
// JavaScript off and is saved for offline use with the page. Its map
// buttons come from buildMapLinks, which stops the build if a point is not
// a real latitude and longitude.

const description =
  'Get bus directions anywhere in Las Vegas, find nearby bus stops, and choose a place to go.';

function slugify(label: string): string {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

// "Where to?" suggests the seven Places to go. Picking one sends its exact
// point to the map apps and links its step-by-step directions below.
const wherePlaces = destinations.map((destination) => {
  const [point] = destination.buttonRows;
  if (!point) throw new Error(`${destination.anchor} has no map point`);
  return {
    label: destination.heading,
    lat: point.lat,
    lng: point.lng,
    anchor: destination.anchor,
  };
});

// Each place's buses as colored badges, in RTC's own route colors, so a
// rider can spot "215" on a bus sign before reading a sentence. Text on a
// badge is black or white, whichever contrasts more with the color.
const routeColors = new Map(routeData.routes.map((route) => [route.shortName, route.color]));
function luminance(hex: string): number {
  const [r = 0, g = 0, b = 0] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
function badge(route: string) {
  const color = routeColors.get(route) ?? '#6B6E75';
  const light = luminance(color);
  const onBlack = (light + 0.05) / 0.05;
  const onWhite = 1.05 / (light + 0.05);
  return {
    route,
    label: route === 'DEUCE' ? 'Deuce' : route === 'RED LINE' ? 'Red Line' : route,
    color,
    // Pure black, not a softer near-black: RTC's red needs every bit of
    // contrast to reach 4.5:1.
    ink: onBlack >= onWhite ? '#000000' : '#FFFFFF',
  };
}
const MAX_BADGES = 4;
function placeBadges(steps: readonly string[]) {
  const routes = [...new Set(steps.flatMap(routesIn))];
  const shown = routes.length > MAX_BADGES ? routes.slice(0, MAX_BADGES - 1) : routes;
  return { badges: shown.map(badge), more: routes.length - shown.length };
}

const mapButtonClass =
  'press inline-flex min-h-11 items-center gap-2 rounded-full border border-outline px-4 py-2 text-sm font-semibold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface';
---

<BaseLayout title="Plan a trip · Week Without Driving Las Vegas" description={description}>
  <section class="container-page page-top" aria-labelledby="plan-heading">
    <h1 id="plan-heading" class="page-title">Plan a trip</h1>
    <p class="page-lede">Type where you’re going. We’ll open bus directions from where you are.</p>

    {/* WHERE TO: shown by where-to.js. It needs no account and sends nothing to us. */}
    <div class="where mt-8 max-w-2xl" data-where>
      <noscript>
        <p class="where__card leading-relaxed">
          Open <a href="https://www.google.com/maps/dir/?api=1&travelmode=transit" class="body-link"
            >bus directions in Google Maps</a
          > or <a href={wwd.rtcTripPlannerUrl} class="body-link">RTC’s trip planner</a>.
        </p>
      </noscript>
      <form class="where__card" data-where-form hidden>
        <div class="form-field">
          <label for="where-to" class="form-label">Where to?</label>
          <input
            id="where-to"
            name="to"
            class="form-input"
            list="where-places"
            autocomplete="off"
            enterkeyhint="go"
            placeholder="A place or an address"
            required
            data-where-to
          />
          <datalist id="where-places">
            {
              wherePlaces.map((place) => (
                <option
                  value={place.label}
                  data-lat={place.lat}
                  data-lng={place.lng}
                  data-anchor={place.anchor}
                />
              ))
            }
          </datalist>
          <p class="form-error" data-where-error role="alert"></p>
        </div>
        <div class="form-field">
          <label for="where-from" class="form-label"
            >Starting from <span class="form-optional">(optional)</span></label
          >
          <p class="form-help" id="where-from-help">Leave blank to start where you are.</p>
          <input
            id="where-from"
            name="from"
            class="form-input"
            autocomplete="off"
            enterkeyhint="go"
            placeholder="Where you are now"
            aria-describedby="where-from-help"
            data-where-from
          />
        </div>
        <button type="submit" class="btn btn--primary btn--block mt-6"
          >Show me how to get there</button
        >
      </form>

      <div class="where__result" data-where-result hidden>
        <h2 class="where__title" tabindex="-1" data-where-title></h2>
        <p class="mt-2 text-on-surface-variant">
          Open bus directions. They show the route, the stop and when to be there.
        </p>
        <div class="where__apps">
          <a class="btn btn--primary" target="_blank" rel="noopener noreferrer" data-where-google
            >Google Maps</a
          >
          <a class="btn btn--outline" target="_blank" rel="noopener noreferrer" data-where-apple
            >Apple Maps</a
          >
          <a class="btn btn--outline" data-where-transit hidden>Transit app</a>
        </div>
        <p class="mt-3 text-sm text-on-surface-variant">
          Prefer RTC’s own tool? <a href={wwd.rtcTripPlannerUrl} class="body-link"
            >RTC trip planner</a
          >
        </p>
        <p class="mt-4" data-where-guide hidden>
          <a class="arrow-link" data-where-guide-link></a>
        </p>

        <h3 class="where__subtitle">Before you go</h3>
        <ul class="where__tiles">
          <li class="where__tile where__tile--fare">
            <span class="where__price">{fares.singleRide}</span>
            <span>one ride</span>
            <span class="where__price where__price--second">{fares.dayPass}</span>
            <span>24 hours</span>
            <a href="/guides/pay-your-fare" class="body-link where__tile-link">Ways to pay</a>
          </li>
          <li class="where__tile">
            <Icon name="mdi:bus-stop" class="where__icon" aria-hidden="true" />
            <span>First time on the bus?</span>
            <a href="/guides/first-ride" class="body-link where__tile-link">3 easy steps</a>
          </li>
          <li class="where__tile">
            <Icon name="mdi:water-outline" class="where__icon" aria-hidden="true" />
            <span>Bring water. Wait in the shade.</span>
            <a href="/guides/heat" class="body-link where__tile-link">Stay cool</a>
          </li>
          <li class="where__tile">
            <Icon name="mdi:gift-outline" class="where__icon" aria-hidden="true" />
            <span>Tell us about your trip. You could win a bus pass.</span>
            <a href="/sign-up" class="body-link where__tile-link" data-signup-link
              ><span data-signup-label>Sign up to win</span></a
            >
          </li>
        </ul>
        <p class="mt-3 text-sm text-on-surface-variant">
          Drivers don’t have change. Bring the exact amount.
        </p>
        <button type="button" class="btn btn--outline mt-6" data-where-again
          >Plan another trip</button
        >
      </div>
    </div>

    <nav class="where__more" aria-label="More ways to plan">
      {
        comparePublished && (
          <a href="/go/compare" class="where__chip">
            Compare ways to go
          </a>
        )
      }
      <a href="#find-routes" class="where__chip">Stops near you</a>
      <a href="#places-to-go" class="where__chip">Step-by-step trips</a>
    </nav>
  </section>
  {/* FIND A BUS — the nearest-route finder, straight under the title */}
  <section
    id="find-routes"
    class="container-page py-16 scroll-mt-24"
    aria-labelledby="find-routes-heading"
  >
    <h2 id="find-routes-heading" class="text-headline-lg">Find a bus</h2>
    <p class="page-lede">
      See the closest stop for each bus near you, in each direction. Or pick a place you already
      know.
    </p>

    <div data-finder class="mt-8 max-w-2xl">
      <noscript>
        <p class="border border-outline bg-surface-container p-5 leading-relaxed">
          Finding stops needs JavaScript turned on in your browser.
        </p>
      </noscript>

      {
        /* Shown by nearest-routes.js, which loads the stop data the first
        time someone asks for stops (see its `ensureData()`). Keeps the
        controls off the page entirely with JavaScript off, matching the
        noscript message above. */
      }
      <div data-finder-app hidden>
        <div class="flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-use-location
            class="press inline-flex min-h-11 items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
          >
            Use my location
          </button>
          <div class="flex flex-wrap items-center gap-2">
            <label for="place-select" class="font-semibold">Or pick a place:</label>
            <select
              id="place-select"
              data-place-select
              class="min-h-11 w-full max-w-full border border-outline bg-surface px-3 py-2 font-semibold sm:w-auto"
            >
              <option value="">Choose a place</option>
              {
                finderPlaces.map((place) => (
                  <option value={slugify(place.label)} data-lat={place.lat} data-lng={place.lng}>
                    {place.label}
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">
          Your location stays on your phone. It is never sent to us or saved.
        </p>

        <p data-finder-status role="status" aria-live="polite" hidden class="mt-6 font-semibold">
        </p>
        <p data-finder-announce class="sr-only" role="status" aria-live="polite"></p>

        <h3 data-results-heading hidden class="text-title-lg mt-8"></h3>
        <ol data-results-list hidden class="mt-4 space-y-4"></ol>

        <div
          data-finder-notes
          hidden
          class="mt-6 space-y-3 text-sm leading-relaxed text-on-surface-variant"
        >
          <p>Distances are in a straight line. The walk or roll is usually a little longer.</p>
          <p>
            RTC's stop data doesn't say whether a stop has a curb ramp, a bench or shade. If one of
            these stops is hard to reach, tell us with a{' '}
            <a href="/guides/sidewalk-audit" class="body-link">sidewalk audit</a>.
          </p>
          <p>
            This finder uses saved schedule data and does not show temporary stop closures. When you
            have a connection, check{' '}
            <a
              href="https://www.rtcsnv.com/ways-to-travel/schedules-maps/bus-stop-closures/"
              class="body-link">RTC's current stop closures</a
            > before you travel.
          </p>
          <p data-data-credit class="text-xs"></p>
        </div>
      </div>

      <p
        data-finder-nodata
        hidden
        class="border border-outline bg-surface-container p-5 leading-relaxed"
      >
        Stop data isn't saved on this phone yet. Open this page once with a connection, and it will
        work offline after that.
      </p>
    </div>
  </section>

  {/* PLACES TO GO — the seven destination guides */}
  <section
    id="places-to-go"
    class="scroll-mt-24 bg-surface-container"
    aria-labelledby="places-to-go-heading"
  >
    <div class="container-page border-t border-outline-variant/15 py-16 md:py-24">
      <h2 id="places-to-go-heading" class="text-headline-lg">Places to go</h2>
      <p class="page-lede">Seven trips across the valley, step by step. Tap one to open it.</p>

      <div class="places mt-8">
        {
          destinations.map((destination) => (
            <details id={destination.anchor} class="place scroll-mt-24" name="places" data-place>
              <summary class="place__summary">
                <span class="place__text">
                  <h3 class="place__name">{destination.heading}</h3>
                  <span class="place__intro">{destination.intro}</span>
                  {(() => {
                    const { badges, more } = placeBadges(destination.steps);
                    return badges.length > 0 ? (
                      <span class="place__buses">
                        <span class="sr-only">Buses: </span>
                        {badges.map((b) => (
                          <span
                            class="route-badge"
                            style={`--route:${b.color};--route-ink:${b.ink}`}
                          >
                            {b.label}
                          </span>
                        ))}
                        {more > 0 && <span class="place__more">+{more} more</span>}
                      </span>
                    ) : null;
                  })()}
                </span>
                <Icon name="mdi:chevron-down" class="place__chevron" aria-hidden="true" />
              </summary>
              <div class="place__body">
                <h4 class="text-title-md">How to get there</h4>
                <ol class="mt-3 max-w-2xl list-decimal space-y-3 pl-5 leading-relaxed text-pretty">
                  {destination.steps.map((step) => (
                    <li>
                      {parseInlineLinks(step).map((segment) =>
                        segment.href ? (
                          <a href={segment.href} class="body-link">
                            {segment.text}
                          </a>
                        ) : (
                          segment.text
                        ),
                      )}
                    </li>
                  ))}
                </ol>

                <div class="mt-6 space-y-4">
                  {destination.buttonRows.map((row) => {
                    const links = buildMapLinks(row.lat, row.lng, row.placeName);
                    return (
                      <div>
                        {row.rowLabel && (
                          <p class="mb-2 text-sm font-bold text-on-surface-variant">
                            {row.rowLabel}
                          </p>
                        )}
                        <div class="flex flex-wrap gap-2">
                          <a
                            href={links.google}
                            aria-label={links.labels.google}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={mapButtonClass}
                          >
                            Google Maps
                          </a>
                          <a
                            href={links.apple}
                            aria-label={links.labels.apple}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={mapButtonClass}
                          >
                            Apple Maps
                          </a>
                          <a
                            href={links.transit}
                            aria-label={links.labels.transit}
                            class={mapButtonClass}
                          >
                            Transit app
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>
                {destination.note && (
                  <div class="mt-6 border-l-4 border-primary bg-surface py-3 pl-5">
                    <p class="font-bold">{destination.note.heading}</p>
                    <p class="mt-1 leading-relaxed text-pretty">{destination.note.text}</p>
                    {destination.note.details && (
                      <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-pretty">
                        {destination.note.details.map((detail) => (
                          <li>{detail}</li>
                        ))}
                      </ul>
                    )}
                    {destination.note.source && (
                      <p class="mt-3">
                        <a href={destination.note.source.href} class="body-link">
                          {destination.note.source.label}
                        </a>
                      </p>
                    )}
                  </div>
                )}
              </div>
            </details>
          ))
        }
      </div>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-on-surface-variant">
        The Transit app buttons open the Transit app, so they need it installed.
      </p>
      <div class="mt-10 max-w-2xl border-l-4 border-primary bg-surface p-5 leading-relaxed">
        <p class="font-bold">Going to work or school?</p>
        <p class="mt-1">
          <a href="https://www.rtcsnv.com/ways-to-travel/club-ride/" class="body-link"
            >RTC Club Ride</a
          > can help you plan another way there. Its rewards are separate from the LVBT giveaway.
        </p>
      </div>
    </div>
  </section>

  <script is:inline type="module" src="/scripts/where-to.js"></script>
  <script is:inline type="module" src="/scripts/open-place.js"></script>
  <script is:inline type="module" src="/scripts/nearest-routes.js"></script>
  <WinBand />
</BaseLayout>

<style>
  .where__card,
  .where__result {
    padding: clamp(1.25rem, 4vw, 1.75rem);
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .where__title {
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .where__title:focus {
    outline: none;
  }
  .where__apps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .where__apps [hidden] {
    display: none;
  }
  .where__subtitle {
    margin-top: 2rem;
    font-size: 1.25rem;
  }
  .where__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .where__tile {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
    background: var(--color-surface);
    border-radius: 0.9rem;
  }
  .where__tile-link {
    margin-top: auto;
    padding-top: 0.25rem;
  }
  .where__tiles :global(.where__icon) {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.4rem;
    color: var(--color-primary-ink);
    background: var(--color-primary-soft);
    border-radius: 999px;
  }
  .where__price {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
  }
  .where__price--second {
    margin-top: 0.35rem;
  }
  .where__more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.6rem;
    max-width: 42rem;
    margin-top: 1.25rem;
  }
  .where__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-on-surface);
    text-decoration: none;
    border: 2px solid color-mix(in srgb, var(--color-on-surface) 30%, transparent);
    border-radius: 999px;
  }
  .where__chip::after {
    content: '↓';
    margin-left: 0.4rem;
  }
  .where__chip[href^='/']::after {
    content: '→';
  }
  .where__chip:hover,
  .where__chip:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary-ink);
  }
  /* Places to go: one row per place, opened one at a time. */
  .places {
    max-width: 44rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 18%, transparent);
  }
  .place {
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface) 18%, transparent);
  }
  .place__summary {
    /* Clear of the sticky header when scrolled or tabbed to. */
    scroll-margin-top: 6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    padding-block: 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .place__summary::-webkit-details-marker {
    display: none;
  }
  .place__summary:focus-visible {
    outline: 3px solid var(--color-primary-warm);
    outline-offset: 2px;
  }
  .place__text {
    flex: 1;
    min-width: 0;
  }
  .place__name {
    font-size: 1.25rem;
    line-height: 1.2;
    text-wrap: balance;
  }
  .place__intro {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-on-surface-variant);
  }
  .place__buses {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }
  .route-badge {
    display: inline-flex;
    align-items: center;
    min-width: 2.5rem;
    justify-content: center;
    padding: 0.15rem 0.55rem;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--route-ink);
    background: var(--route);
    border-radius: 0.4rem;
  }
  @media (forced-colors: active) {
    .route-badge {
      border: 1px solid CanvasText;
    }
  }
  .place__more {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-on-surface-variant);
  }
  .place :global(.place__chevron) {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-primary-ink);
    transition: transform 150ms ease;
  }
  .place[open] :global(.place__chevron) {
    transform: rotate(180deg);
  }
  .place__body {
    padding-bottom: 1.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .place :global(.place__chevron) {
      transition: none;
    }
  }
</style>
