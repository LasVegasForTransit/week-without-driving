---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { lvbt } from '../lib/site';
import { wwd, wwdResources, WWD_DATE_RANGE } from '../lib/wwd';
import { contactEmail } from '../lib/partners';

// Press page: a one-stop start for reporters covering Week Without Driving
// in Las Vegas. Everything here is real data from src/lib — dates, the
// hashtag, and the links to LVBT and the national campaign — plus honest
// "To come" placeholders for the material LVBT has not supplied yet (the
// press release, name/phone for the media contact, and the download
// files). No quotes, names or stats are invented.

const title = 'Press · Week Without Driving Las Vegas';
const description =
  'Media contact, quick facts, and press materials for Week Without Driving in Las Vegas.';

const mediaMailto = `mailto:${contactEmail}?subject=${encodeURIComponent(
  'Press: Week Without Driving Las Vegas',
)}`;

const mediaAdvisory = wwdResources.find((r) => r.title === '2026 media advisory');

const downloads = [
  {
    name: 'Logo pack',
    icon: 'mdi:image-outline',
    body: 'LVBT and Week Without Driving logos, in PNG and SVG.',
  },
  {
    name: 'Photos from the week',
    icon: 'mdi:image-multiple-outline',
    body: 'Real photos from Las Vegas, added as the week happens.',
  },
  {
    name: 'Campaign graphics',
    icon: 'mdi:palette-outline',
    body: "Social graphics and the campaign's colors.",
  },
];

const storyAngles = [
  "Las Vegans who don't drive, in their own words.",
  'Local leaders taking the challenge for a day or the whole week.',
  'What a first bus trip is like for someone who has never ridden.',
  'What a sidewalk audit finds when you look at a street on foot.',
  'Volunteers organizing a citywide week without a paid staff.',
];
---

<BaseLayout title={title} description={description}>
  <section class="container-page py-16 md:py-24">
    <h1 class="text-display-sm">Press</h1>
    <p class="lede mt-4 max-w-2xl">Covering Week Without Driving in Las Vegas? Start here.</p>

    {/* MEDIA CONTACT */}
    <div
      class="reveal relative mt-10 overflow-hidden border border-outline bg-surface-container p-6 pl-8 md:max-w-2xl md:p-8 md:pl-10"
    >
      <span class="absolute inset-y-0 left-0 w-2 bg-primary" aria-hidden="true"></span>
      <h2 class="text-title-lg">Media contact</h2>
      <p class="mt-3 leading-relaxed text-pretty">
        <a href={mediaMailto} data-print-url={contactEmail} class="body-link font-semibold">
          {contactEmail}
        </a>
      </p>
      <p class="mt-2 leading-relaxed text-pretty">We answer within one business day.</p>
      <p class="mt-4 flex flex-wrap items-center gap-2">
        <span class="font-semibold">Name and phone number:</span>
        <span
          class="inline-flex items-center rounded-full bg-surface px-3 py-1 text-label-sm font-extrabold uppercase text-on-surface-variant"
        >
          To come
        </span>
      </p>
      <div class="mt-6">
        <a
          href={mediaMailto}
          data-print-url={contactEmail}
          class="press inline-flex items-center gap-2 bg-primary px-6 py-3 font-bold text-on-primary no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
        >
          <Icon name="mdi:email-outline" class="size-5" aria-hidden="true" />
          Email the media contact
        </a>
      </div>
    </div>

    {/* PRESS RELEASE */}
    <div class="reveal mt-16 border-t border-outline-variant/15 pt-10 md:mt-24">
      <h2 class="text-headline-lg">Press release</h2>
      <div
        class="mt-6 flex flex-wrap items-start gap-4 border border-outline bg-surface-container p-6 md:max-w-2xl"
      >
        <Icon
          name="mdi:newspaper-variant-outline"
          class="size-8 shrink-0 text-on-surface-variant"
          aria-hidden="true"
        />
        <div>
          <span
            class="inline-flex items-center rounded-full bg-surface px-3 py-1 text-label-sm font-extrabold uppercase text-on-surface-variant"
          >
            To come
          </span>
          <p class="mt-2 leading-relaxed text-pretty">
            Our press release will be posted here before October 1.
          </p>
        </div>
      </div>
      {
        mediaAdvisory && (
          <p class="mt-6 max-w-2xl leading-relaxed text-pretty">
            In the meantime, read the national campaign's{' '}
            <a
              href={mediaAdvisory.url}
              data-print-url={mediaAdvisory.url}
              target="_blank"
              rel="noopener noreferrer"
              class="body-link font-semibold"
            >
              2026 media advisory
            </a>
            .
          </p>
        )
      }
    </div>

    {/* QUICK FACTS */}
    <div class="reveal mt-16 border-t border-outline-variant/15 pt-10 md:mt-24">
      <h2 class="text-headline-lg">Quick facts</h2>
      <dl class="mt-6 divide-y divide-outline-variant/15 border-t border-outline-variant/15">
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">What</dt>
          <dd class="leading-relaxed text-pretty">
            A week to get around without driving: by bus, walking or rolling, biking, or getting a
            ride.
          </dd>
        </div>
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">When</dt>
          <dd class="leading-relaxed text-pretty">
            {WWD_DATE_RANGE}, {wwd.year}
          </dd>
        </div>
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">Where</dt>
          <dd class="leading-relaxed text-pretty">Las Vegas Valley</dd>
        </div>
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">Who runs it locally</dt>
          <dd class="leading-relaxed text-pretty">
            <a href={lvbt.url} data-print-url={lvbt.url} class="body-link font-semibold">
              {lvbt.name}
            </a>{' '}
            (LVBT), a 501(c)(3) nonprofit.
          </dd>
        </div>
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">National campaign</dt>
          <dd class="leading-relaxed text-pretty">
            Organized by {wwd.nationalOrganizer} with the Nondrivers Alliance.{' '}
            <a
              href={wwd.nationalUrl}
              data-print-url={wwd.nationalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="body-link font-semibold"
            >
              weekwithoutdriving.org
            </a>
          </dd>
        </div>
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">How to join</dt>
          <dd class="leading-relaxed text-pretty">
            Pledge at{' '}
            <a href="/take-part" class="body-link font-semibold"> lvwwd.org/take-part </a>
          </dd>
        </div>
        <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-title-sm font-bold">Hashtag</dt>
          <dd class="leading-relaxed text-pretty">{wwd.hashtag}</dd>
        </div>
      </dl>
    </div>

    {/* PHOTOS AND LOGOS */}
    <div class="reveal mt-16 border-t border-outline-variant/15 pt-10 md:mt-24">
      <h2 class="text-headline-lg">Photos and logos</h2>
      <p class="lede mt-4 max-w-2xl">Downloads are on the way. Check back closer to October 1.</p>
      <ul class="reveal-stagger mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          downloads.map((item) => (
            <li class="reveal flex flex-col gap-3 border border-outline bg-surface-container p-6">
              <Icon name={item.icon} class="size-8 text-on-surface-variant" aria-hidden="true" />
              <p class="text-title-md font-bold">{item.name}</p>
              <p class="leading-relaxed text-on-surface-variant text-pretty">{item.body}</p>
              <span class="inline-flex w-fit items-center rounded-full bg-surface px-3 py-1 text-label-sm font-extrabold uppercase text-on-surface-variant">
                To come
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    {/* STORIES */}
    <div class="reveal mt-16 border-t border-outline-variant/15 pt-10 md:mt-24">
      <h2 class="text-headline-lg">Stories we can connect you with</h2>
      <p class="lede mt-4 max-w-2xl">
        Tell us what you're working on, and we'll help find the right person or angle.
      </p>
      <ul class="prose-doc mt-6 list-disc pl-6">
        {storyAngles.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
