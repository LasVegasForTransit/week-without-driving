---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { lvbt } from '../lib/site';
import { wwd, wwdResources, WWD_DATE_RANGE } from '../lib/wwd';
import { contactEmail } from '../lib/partners';

// Press page: a one-stop start for reporters covering Week Without Driving
// in Las Vegas. Everything here is real data from src/lib — dates, the
// hashtag, and the links to LVBT and the national campaign — plus honest
// "To come" placeholders for the material LVBT has not supplied yet (the
// press release, name/phone for the media contact, and the download
// files). No quotes, names or stats are invented.

const title = 'Press · Week Without Driving Las Vegas';
const description =
  'Media contact, quick facts, and press materials for Week Without Driving in Las Vegas.';

const mediaMailto = `mailto:${contactEmail}?subject=${encodeURIComponent(
  'Press: Week Without Driving Las Vegas',
)}`;

const mediaAdvisory = wwdResources.find((r) => r.title === '2026 media advisory');

const downloads = [
  {
    name: 'Logo pack',
    icon: 'mdi:image-outline',
    body: 'LVBT and Week Without Driving logos, in PNG and SVG.',
  },
  {
    name: 'Photos from the week',
    icon: 'mdi:image-multiple-outline',
    body: 'Real photos from Las Vegas, added as the week happens.',
  },
  {
    name: 'Campaign graphics',
    icon: 'mdi:palette-outline',
    body: "Social graphics and the campaign's colors.",
  },
];

const storyAngles = [
  "Las Vegans who don't drive, in their own words.",
  'Local leaders taking the challenge for a day or the whole week.',
  'What a first bus trip is like for someone who has never ridden.',
  'What a sidewalk audit finds when you look at a street on foot.',
  'Volunteers organizing a citywide week without a paid staff.',
];
---

<BaseLayout title={title} description={description}>
  <PageHeader title="Press" lede="Covering Week Without Driving in Las Vegas? Start here." />

  {/* MEDIA CONTACT */}
  <section class="container-page section--flush" aria-labelledby="contact-heading">
    <div class="press-card">
      <h2 id="contact-heading" class="press-card__title">Media contact</h2>
      <p class="mt-2">
        <a href={mediaMailto} data-print-url={contactEmail} class="body-link font-bold">
          {contactEmail}
        </a>
      </p>
      <p class="mt-1 text-on-surface-variant">We answer within one business day.</p>
      <p class="mt-3 flex flex-wrap items-center gap-2">
        <span class="font-bold">Name and phone number:</span>
        <span class="to-come">To come</span>
      </p>
      <a href={mediaMailto} data-print-url={contactEmail} class="btn btn--primary mt-5">
        <Icon name="mdi:email-outline" class="size-5" aria-hidden="true" />
        Email the media contact
      </a>
    </div>
  </section>

  {/* PRESS RELEASE */}
  <section class="container-page section mt-12" aria-labelledby="release-heading">
    <h2 id="release-heading" class="section-title">Press release</h2>
    <div class="press-card section-body">
      <span class="to-come">To come</span>
      <p class="mt-2">Our press release will be posted here before October 1.</p>
    </div>
    {
      mediaAdvisory && (
        <p class="section-intro">
          In the meantime, read the national campaign's{' '}
          <a
            href={mediaAdvisory.url}
            data-print-url={mediaAdvisory.url}
            target="_blank"
            rel="noopener noreferrer"
            class="body-link font-bold"
          >
            2026 media advisory
          </a>
          .
        </p>
      )
    }
  </section>

  {/* QUICK FACTS */}
  <section class="container-page section" aria-labelledby="facts-heading">
    <h2 id="facts-heading" class="section-title">Quick facts</h2>
    <dl class="facts section-body">
      <div>
        <dt>What</dt>
        <dd>
          A week to get around without driving: by bus, walking or rolling, biking, or getting a
          ride.
        </dd>
      </div>
      <div>
        <dt>When</dt>
        <dd>{WWD_DATE_RANGE}, {wwd.year}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd>Las Vegas Valley</dd>
      </div>
      <div>
        <dt>Who runs it locally</dt>
        <dd>
          <a href={lvbt.url} data-print-url={lvbt.url} class="body-link font-bold">{lvbt.name}</a>{
            ' '
          }(LVBT), a 501(c)(3) nonprofit.
        </dd>
      </div>
      <div>
        <dt>National campaign</dt>
        <dd>
          Organized by {wwd.nationalOrganizer} with the Nondrivers Alliance.{' '}
          <a
            href={wwd.nationalUrl}
            data-print-url={wwd.nationalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="body-link font-bold"
          >
            weekwithoutdriving.org
          </a>
        </dd>
      </div>
      <div>
        <dt>Take part</dt>
        <dd>
          Anyone can. Sign up to win at <a href="/sign-up" class="body-link font-bold"
            >lvwwd.org/sign-up</a
          >.
        </dd>
      </div>
      <div>
        <dt>Hashtag</dt>
        <dd>{wwd.hashtag}</dd>
      </div>
    </dl>
  </section>

  {/* PHOTOS AND LOGOS */}
  <section class="container-page section" aria-labelledby="downloads-heading">
    <h2 id="downloads-heading" class="section-title">Photos and logos</h2>
    <p class="section-intro">Downloads are on the way. Check back closer to October 1.</p>
    <ul class="section-body grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        downloads.map((item) => (
          <li class="press-card flex flex-col gap-2">
            <Icon name={item.icon} class="size-8 text-primary-ink" aria-hidden="true" />
            <p class="press-card__title">{item.name}</p>
            <p class="text-on-surface-variant">{item.body}</p>
            <span class="to-come mt-1 w-fit">To come</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* STORIES */}
  <section class="container-page section" aria-labelledby="stories-heading">
    <h2 id="stories-heading" class="section-title">Stories we can connect you with</h2>
    <p class="section-intro">
      Tell us what you're working on, and we'll help find the right person or angle.
    </p>
    <ul class="stories section-body">
      {storyAngles.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .press-card {
    max-width: 40rem;
    padding: clamp(1.25rem, 4vw, 1.75rem);
    background: var(--color-surface-container);
    border-radius: 1rem;
  }
  .press-card__title {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .facts {
    border-top: 1px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
  }
  .facts > div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface) 14%, transparent);
  }
  .facts dt {
    font-weight: 800;
  }
  .facts dd {
    line-height: 1.5;
  }
  .stories {
    display: grid;
    gap: 0.5rem;
    max-width: 40rem;
    padding-left: 1.25rem;
    font-size: 1.1rem;
    line-height: 1.5;
    list-style: disc;
  }
  @media (min-width: 40rem) {
    .facts > div {
      grid-template-columns: 12rem 1fr;
    }
  }
</style>
