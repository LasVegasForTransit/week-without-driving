---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { days } from '../lib/campaign';
import { lvbt } from '../lib/site';
import { wwd } from '../lib/wwd';

// My week: the page a signed-up person comes back to. It shows their
// entries as the eight days of the week, the one button that checks them
// in for today, an optional photo, reminders, and their details. The page
// is the same for everyone; /scripts/my-week.js fills it in from the
// Worker's API for the person signed in on this phone, or shows the
// signed-out state. Opening an "Open my week" link (/my-week?t=...) is
// handled by the Worker before this page loads.
const title = 'My week · Week Without Driving Las Vegas';

// How someone got around without driving. Any one of them makes the day a
// car-free trip and an entry.
const modes = [
  { value: 'bus', label: 'Bus', icon: 'mdi:bus' },
  { value: 'walk', label: 'Walked or rolled', icon: 'mdi:walk' },
  { value: 'bike', label: 'Bike or scooter', icon: 'mdi:bike' },
  { value: 'ride', label: 'Got a ride', icon: 'mdi:account-multiple-outline' },
] as const;

const shortcuts = [
  { href: '/go', label: 'Find a bus', icon: 'mdi:bus' },
  { href: '/guides', label: 'Rider guides', icon: 'mdi:book-open-variant-outline' },
  { href: '/bingo', label: 'Play bingo', icon: 'mdi:grid' },
] as const;
---

<BaseLayout title={title} description="Your shared trips, entries and details." noindex>
  <div class="container-page myweek narrow">
    {/* Shown when the API can't be reached */}
    <p data-me-offline hidden class="myweek__lede" role="alert"></p>

    {/* Signed out on this phone */}
    <section data-me-out hidden class="myweek__out" aria-labelledby="out-heading">
      <h1 id="out-heading" class="page-title">My week</h1>
      <p class="myweek__lede">This phone isn’t signed in.</p>
      <div class="myweek__actions">
        <a href="/my-week/link" class="btn btn--primary btn--big">Get my link</a>
        <a href="/sign-up" class="btn btn--outline">Sign up to win</a>
      </div>
      <p class="myweek__note">
        Signed up on another phone? We’ll send your link to the phone number or email you used.
      </p>
    </section>

    {/* Signed in */}
    <div data-me-in hidden>
      <section class="myweek__hello" aria-labelledby="hello-heading">
        <p class="myweek__welcome" data-me-welcome hidden>
          <Icon name="mdi:check-circle" class="size-6" aria-hidden="true" />
          <span data-me-welcome-text>You’re signed up.</span>
        </p>
        <h1 id="hello-heading" class="page-title">
          Hi, <span data-me-name>there</span>.
        </h1>
        <p class="myweek__lede" data-me-phase>Share each day you skip the car, October 1 to 8.</p>
        <div class="preview-link" data-preview-link hidden></div>
      </section>

      {/* ENTRIES: the eight days, today's trip, and sharing it. */}
      <section class="entries" aria-labelledby="entries-heading">
        <div class="entries__head">
          <h2 id="entries-heading" class="entries__count">
            <span data-me-count>0</span> of {wwd.maxEntries} entries
          </h2>
          <p class="entries__prize">Win a one-month RTC bus pass.</p>
        </div>
        <ol class="entries__days">
          {
            days.map((d) => (
              <li class="entries__day" data-day={d.number}>
                <span class="entries__weekday">{d.weekday}</span>
                <span class="entries__date">{d.monthDay.replace('Oct ', '')}</span>
                <span class="entries__mark" aria-hidden="true">
                  <Icon name="mdi:check-bold" class="entries__check" />
                </span>
                <span class="sr-only" data-day-status>
                  No trip logged
                </span>
              </li>
            ))
          }
        </ol>

        {/* Today's trip, in three steps: how, the post, and sending it in. */}
        <form data-trip-form hidden class="trip" novalidate>
          <fieldset class="trip__step" aria-describedby="trip-error">
            <legend class="trip__q"
              ><span class="trip__n" aria-hidden="true">1</span> How did you get around today without
              driving?</legend
            >
            <div class="log__modes">
              {
                modes.map((m) => (
                  <label class="log__mode">
                    <input type="checkbox" name="mode" value={m.value} />
                    <Icon name={m.icon} class="log__icon" aria-hidden="true" />
                    <span>{m.label}</span>
                  </label>
                ))
              }
            </div>
            <label for="trip-hard" class="log__hard-label">
              Was anything hard? <span class="log__optional">(optional)</span>
            </label>
            <textarea
              id="trip-hard"
              name="hard"
              rows="2"
              maxlength="280"
              class="log__hard"
              placeholder="A stop with no shade, a sidewalk that ends, a long wait…"></textarea>
          </fieldset>

          <div class="trip__step" data-share-step>
            <p class="trip__q">
              <span class="trip__n" aria-hidden="true">2</span> Post a photo or video of your trip.
            </p>
            <p class="trip__help">
              Use one you took on the way. Tag @lasvegasfortransit on Instagram, or post anywhere
              public with #WeekWithoutDriving. You can add our picture to your post too.
            </p>
            <button type="button" class="btn shared__save mt-3" data-make-picture>
              <Icon name="mdi:image-outline" class="size-5" aria-hidden="true" />
              Add our picture
            </button>
            <div data-share-kit hidden>
              <img
                data-share-preview
                alt=""
                hidden
                class="shared__preview"
                width="1080"
                height="1350"
              />
              <div class="shared__actions">
                <button type="button" class="btn shared__share" data-share-image>
                  <Icon name="mdi:share-variant" class="size-5" aria-hidden="true" />
                  Share
                </button>
                <button type="button" class="btn shared__save" data-save-image>
                  <Icon name="mdi:download" class="size-5" aria-hidden="true" />
                  Save
                </button>
              </div>
              <p class="shared__caption-label">Caption to paste</p>
              <p class="shared__caption" data-share-caption></p>
              <button type="button" class="shared__copy" data-copy-caption>Copy the caption</button>
              <p class="shared__status" data-share-status aria-live="polite"></p>
            </div>
          </div>

          <fieldset class="trip__step">
            <legend class="trip__q"
              ><span class="trip__n" aria-hidden="true">3</span> Send us your post.</legend
            >
            <label for="trip-link" class="log__hard-label">Link to your post</label>
            <input
              id="trip-link"
              name="link"
              type="url"
              inputmode="url"
              autocomplete="off"
              class="trip__link"
              placeholder="https://www.instagram.com/p/…"
            />
            <label class="trip__screenshot">
              <input
                type="file"
                name="screenshot"
                accept="image/jpeg,image/png,image/heic,image/heif,image/webp"
                class="sr-only"
                data-screenshot-input
              />
              <Icon name="mdi:cellphone-screenshot" class="size-6" aria-hidden="true" />
              <span data-screenshot-label
                >Private account? Add a screenshot of your post instead.</span
              >
            </label>
            <label class="trip__consent">
              <input type="checkbox" name="share" />
              <span>LVBT may share my post on Instagram and lvwwd.org.</span>
            </label>
            <p class="trip__help" data-tag-note hidden>
              Tagged @lasvegasfortransit from your Instagram? We count it for you, so you can skip
              this step.
            </p>
          </fieldset>

          <button type="submit" class="btn btn--primary btn--big btn--block" data-trip-submit>
            Enter today’s trip
          </button>
          <p id="trip-error" class="log__error" data-trip-error aria-live="polite"></p>
          <p class="log__drove">
            Had to drive today? You haven’t failed. Try one trip without the car tomorrow.
          </p>
        </form>

        {/* After entering: the day's entry, confirmed. */}
        <div data-trip-done hidden class="shared">
          <p class="shared__title" data-trip-done-title aria-live="polite"></p>
          <p class="shared__ask">
            We check every post before the draw. Come back tomorrow for another entry.
          </p>
        </div>

        <p class="entries__status" data-log-closed hidden></p>
        <p class="entries__fine">
          One entry for each day you share a trip without driving, up to 8. We check every post
          before the draw. No social media? <a href="/giveaway#by-mail" class="body-link"
            >Enter by mail</a
          >. See the <a href="/giveaway/rules" class="body-link">Official Rules</a>.
        </p>
      </section>

      {/* GETTING AROUND */}
      <section class="myweek__section" aria-labelledby="go-heading">
        <h2 id="go-heading" class="myweek__h2">Plan today’s trip</h2>
        <ul class="shortcuts">
          {
            shortcuts.map((s) => (
              <li>
                <a href={s.href} class="shortcut">
                  <Icon name={s.icon} class="shortcut__icon" aria-hidden="true" />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {/* REMINDERS */}
      <section class="myweek__card" aria-labelledby="remind-heading">
        <h2 id="remind-heading" class="myweek__h2">Remind me to share my trip</h2>
        <p class="myweek__p">One reminder a day, October 1 to 8, at about 8 am. Stop anytime.</p>
        <label class="check-row" data-remind-row="push">
          <input type="checkbox" data-remind="push" />
          <span>Send a notification to this phone.</span>
        </label>
        <label class="check-row" data-remind-row="text" hidden>
          <input type="checkbox" data-remind="text" />
          <span>
            Text me one reminder a day, October 1 to 8, 2026, from Week Without Driving Las Vegas.
            Up to 8 texts. Message and data rates may apply. Reply STOP to end, HELP for help.
          </span>
        </label>
        <label class="check-row" data-remind-row="email" hidden>
          <input type="checkbox" data-remind="email" />
          <span>Email me one reminder a day, October 1 to 8.</span>
        </label>
        <p class="entries__status" data-remind-status aria-live="polite"></p>
      </section>

      {/* DETAILS */}
      <section class="myweek__section" aria-labelledby="details-heading">
        <h2 id="details-heading" class="myweek__h2">Your details</h2>
        <dl class="details">
          <div><dt>Name</dt><dd data-me-field="firstName"></dd></div>
          <div><dt>Contact</dt><dd data-me-field="contact"></dd></div>
          <div><dt>ZIP code</dt><dd data-me-field="zip"></dd></div>
          <div><dt>Instagram</dt><dd data-me-field="instagram"></dd></div>
        </dl>
        <a href="/sign-up?edit=1" class="arrow-link mt-4">Change my details</a>
      </section>

      <section class="myweek__card" aria-labelledby="phones-heading">
        <h2 id="phones-heading" class="myweek__h2">Open My week on another phone</h2>
        <p class="myweek__p" data-me-link-line>
          We sent you a link. Open it on any phone to come back here.
        </p>
        <a href="/my-week/link" class="arrow-link mt-3">Send my link again</a>
      </section>

      <section class="myweek__section" aria-labelledby="after-heading">
        <h2 id="after-heading" class="myweek__h2">Keep going after the week</h2>
        <p class="myweek__p">
          Las Vegans for Better Transit works all year for better buses and safer streets.
        </p>
        <a href={lvbt.joinUrl} class="arrow-link mt-3">Join LVBT</a>
      </section>

      <p class="myweek__signout">
        Not you?{' '}
        <button type="button" class="body-link font-bold" data-signout
          >Sign out of this phone</button
        >
      </p>
      <p class="form-error" data-signout-status aria-live="polite"></p>
    </div>

    <noscript>
      <p class="myweek__lede">My week needs JavaScript turned on in your browser.</p>
    </noscript>
  </div>

  <script is:inline src="/scripts/participant-api.js" defer></script>
  <script is:inline src="/scripts/share-trip.js" defer></script>
  <script is:inline src="/scripts/my-week.js" defer></script>
</BaseLayout>

<style>
  .myweek {
    padding-block: clamp(2.25rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem);
  }
  .myweek__lede {
    margin-top: 0.9rem;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .myweek__welcome {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    font-weight: 800;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: 999px;
  }
  .myweek__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .myweek__note {
    margin-top: 1rem;
    color: var(--color-on-surface-variant);
  }
  .myweek__section,
  .myweek__card {
    margin-top: 2rem;
  }
  .myweek__card {
    padding: clamp(1.25rem, 4vw, 1.75rem);
    background: var(--color-surface-container);
    border-radius: 1.25rem;
  }
  .myweek__h2 {
    font-size: clamp(1.4rem, 5vw, 1.75rem);
    line-height: 1.15;
  }
  .myweek__p {
    margin-top: 0.4rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .myweek__signout {
    margin-top: 3rem;
    color: var(--color-on-surface-variant);
  }

  /* Entries: a ticket-like card with the eight days. */
  .entries {
    margin-top: 1.75rem;
    padding: clamp(1.25rem, 4vw, 1.75rem);
    color: var(--color-on-slab);
    background: var(--color-slab);
    border-radius: 1.25rem;
  }
  .entries__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .entries__count {
    font-size: clamp(1.8rem, 7vw, 2.4rem);
    line-height: 1.05;
  }
  .entries__count [data-me-count] {
    color: var(--color-on-slab-accent);
  }
  .entries__prize {
    font-weight: 700;
    color: var(--color-on-slab-variant);
  }
  .entries__days {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-block: 1.25rem;
  }
  .entries__day {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.55rem 0.25rem 0.6rem;
    color: var(--color-on-slab);
    border: 2px dashed color-mix(in srgb, var(--color-on-slab) 40%, transparent);
    border-radius: 0.75rem;
  }
  .entries__weekday {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-slab-variant);
  }
  .entries__date {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .entries__mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.2rem;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-on-slab) 35%, transparent);
  }
  .entries__mark :global(.entries__check) {
    width: 1.1rem;
    height: 1.1rem;
    opacity: 0;
  }
  .entries__day[data-state='done'] {
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
    border: 2px solid var(--color-primary-warm);
  }
  .entries__day[data-state='done'] .entries__weekday {
    color: var(--color-on-primary-warm);
  }
  .entries__day[data-state='done'] .entries__mark {
    color: var(--color-primary-warm);
    background: var(--color-on-primary-warm);
    border-color: var(--color-on-primary-warm);
  }
  .entries__day[data-state='done'] :global(.entries__check) {
    opacity: 1;
  }
  .entries__day[data-state='today'] {
    border-style: solid;
    border-color: var(--color-on-slab);
  }
  .entries__day[data-state='missed'] {
    opacity: 0.45;
  }
  .entries .btn--primary {
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
  }
  .entries .btn--primary:not(:disabled):hover,
  .entries .btn--primary:focus-visible {
    background: var(--color-on-slab);
  }
  /* Waiting or done: an outlined state, not a faded button. */
  .entries .btn--primary:disabled {
    color: var(--color-on-slab);
    background: transparent;
    border: 2px solid color-mix(in srgb, var(--color-on-slab) 55%, transparent);
    opacity: 1;
  }
  .entries__status {
    margin-top: 0.75rem;
    font-weight: 800;
  }
  .entries__status:empty {
    display: none;
  }
  .entries__fine {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-on-slab-variant);
  }
  .entries__fine :global(a) {
    color: inherit;
  }

  /* Today's trip */
  .log__modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .log__q {
    grid-column: 1 / -1;
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .log__mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 5.5rem;
    padding: 0.6rem;
    font-weight: 800;
    text-align: center;
    border: 2px solid color-mix(in srgb, var(--color-on-slab) 35%, transparent);
    border-radius: 1rem;
    cursor: pointer;
  }
  .log__mode input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .log__mode :global(.log__icon) {
    width: 2rem;
    height: 2rem;
  }
  .log__mode:has(input:checked) {
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
    border-color: var(--color-primary-warm);
  }
  .log__mode:has(input:focus-visible) {
    outline: 3px solid var(--color-on-slab);
    outline-offset: 2px;
  }
  .log__hard-label {
    display: block;
    margin-top: 1rem;
    font-weight: 800;
  }
  .log__optional {
    font-weight: 400;
    color: var(--color-on-slab-variant);
  }
  .log__hard {
    display: block;
    width: 100%;
    margin-block: 0.4rem 1rem;
    padding: 0.7rem 0.9rem;
    font-size: 1.05rem;
    color: var(--color-on-surface);
    background: var(--color-field);
    border: 2px solid transparent;
    border-radius: 0.75rem;
  }
  .log__error {
    margin-top: 0.6rem;
    font-weight: 800;
    color: var(--color-on-slab-accent);
  }
  .log__error:empty {
    display: none;
  }
  .log__drove {
    margin-top: 0.75rem;
    color: var(--color-on-slab-variant);
  }

  /* Today's trip, in three steps */
  .trip__step {
    padding-block: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-slab) 22%, transparent);
  }
  .trip__q {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .trip__n {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    font-size: 1rem;
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
    border-radius: 50%;
  }
  .trip__help {
    color: var(--color-on-slab-variant);
  }
  .trip__link {
    display: block;
    width: 100%;
    min-height: 52px;
    margin-top: 0.4rem;
    padding: 0 0.9rem;
    font-size: 1.05rem;
    color: var(--color-on-surface);
    background: var(--color-field);
    border-radius: 0.75rem;
  }
  .trip__screenshot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding: 0.75rem 0.9rem;
    font-weight: 700;
    border: 2px dashed color-mix(in srgb, var(--color-on-slab) 45%, transparent);
    border-radius: 0.75rem;
    cursor: pointer;
  }
  .trip__screenshot:focus-within {
    outline: 3px solid var(--color-on-slab);
    outline-offset: 2px;
  }
  .trip__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .trip__consent input {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.1rem;
    accent-color: var(--color-primary-warm);
  }

  /* Share what you did */
  .shared__title {
    font-size: 1.3rem;
    font-weight: 800;
  }
  .shared__ask {
    margin-top: 0.25rem;
    color: var(--color-on-slab-variant);
  }
  .shared__preview {
    width: 100%;
    max-width: 18rem;
    height: auto;
    margin-top: 1rem;
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
  }
  .shared__actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .shared__actions .btn {
    white-space: nowrap;
  }
  .shared__share {
    color: var(--color-on-primary-warm);
    background: var(--color-primary-warm);
  }
  .shared__save {
    color: var(--color-on-slab);
    border: 2px solid color-mix(in srgb, var(--color-on-slab) 60%, transparent);
  }
  .shared__caption-label {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-slab-variant);
  }
  .shared__caption {
    margin-top: 0.3rem;
    padding: 0.75rem 0.9rem;
    line-height: 1.45;
    background: color-mix(in srgb, var(--color-on-slab) 10%, transparent);
    border-radius: 0.75rem;
  }
  .shared__copy {
    margin-top: 0.5rem;
    font-weight: 800;
    color: var(--color-on-slab);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .shared__status {
    margin-top: 0.5rem;
    font-weight: 700;
  }
  .shared__status:empty {
    display: none;
  }
  @media (min-width: 40rem) {
    .log__modes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Photo */
  .photo-pick {
    display: flex;
    flex-direction: column;
    align-items: center;
