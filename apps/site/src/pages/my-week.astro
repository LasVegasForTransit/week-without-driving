---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import KeepGoingCard from '../components/KeepGoingCard.astro';
import { days } from '../lib/campaign';
import { destinations } from '../lib/destinations';
import { KEEP_GOING } from '../lib/newsletter';
import { REMINDERS } from '../lib/reminders';
import { wwd } from '../lib/wwd';

// My week: the page a signed-up person comes back to. It shows their
// entries as the eight days of the week, the form that sends today's
// shared trip, daily reminders, their details, and, at the foot, "Sign up
// someone else" for a volunteer signing people up on one tablet. The page
// is the same for everyone; /scripts/my-week.js fills it in from the
// Worker's API for the person signed in on this phone, or shows the
// signed-out state. /scripts/needs-connection.js says so, and grays out
// the buttons that send something, while the phone is offline. Opening an
// "Open my week" link (/my-week?t=...) is handled by the Worker before
// this page loads.
const title = 'My week · Week Without Driving Las Vegas';

// How someone got around without driving. Any one of them makes the day a
// car-free trip and an entry.
const modes = [
  { value: 'bus', label: 'Bus', icon: 'mdi:bus' },
  { value: 'walk', label: 'Walked or rolled', icon: 'mdi:walk' },
  { value: 'bike', label: 'Bike or scooter', icon: 'mdi:bike' },
  { value: 'ride', label: 'Got a ride', icon: 'mdi:account-multiple-outline' },
] as const;

const shortcuts = [
  { href: '/go', label: 'Find a bus', icon: 'mdi:bus' },
  { href: '/guides', label: 'Rider guides', icon: 'mdi:book-open-variant-outline' },
] as const;

const planOutings = destinations.filter(
  (destination) => destination.anchor !== 'allegiant-stadium',
);
const planModes = [
  { value: 'bus', label: 'Bus' },
  { value: 'walk', label: 'Walk or roll' },
  { value: 'bike', label: 'Bike' },
  { value: 'scooter', label: 'Scooter' },
  { value: 'ride', label: 'Get a ride' },
] as const;
---

<BaseLayout title={title} description="Your shared trips, entries and details." noindex>
  <div class="container-page myweek narrow">
    {/* Shown when the API can't be reached */}
    <p data-me-offline hidden class="myweek__lede" role="alert"></p>

    {/* Signed out on this phone */}
    <section data-me-out hidden class="myweek__out" aria-labelledby="out-heading">
      <h1 id="out-heading" class="page-title">Your Week Without Driving</h1>
      <p class="myweek__lede">
        Plan car-free trips. Track your eight days. Tell us about each trip.
      </p>
      <div class="myweek__actions">
        <a href="/sign-up" class="btn btn--primary btn--big">Sign up</a>
        <a href="/my-week/link" class="btn btn--outline">Email me a sign-in link</a>
      </div>
      <p class="myweek__note">
        Already signed up? Use the same email. We’ll send a link that opens My Week on this phone.
      </p>
    </section>

    {/* Signed in */}
    <div data-me-in hidden>
      <section class="myweek__hello" aria-labelledby="hello-heading">
        <p class="myweek__welcome" data-me-welcome hidden>
          <Icon name="mdi:check-circle" class="size-6" aria-hidden="true" />
          <span data-me-welcome-text>You’re signed up.</span>
        </p>
        <h1 id="hello-heading" class="page-title">
          Hi, <span data-me-name>there</span>.
        </h1>
        <p class="myweek__lede" data-me-phase>
          Describe a trip each day you skip the car, October 1 to 8.
        </p>
        <div class="preview-link" data-preview-link hidden></div>
      </section>

      {/* ENTRIES: the eight days, today's trip, and sharing it. */}
      <section class="entries" aria-labelledby="entries-heading">
        <div class="entries__head">
          <h2 id="entries-heading" class="entries__count">
            <span data-me-count>0</span> of {wwd.maxEntries} days logged
          </h2>
          <p class="entries__prize">Win a 30-day RTC bus pass.</p>
        </div>
        <p class="entries__intro" data-me-progress-line>
          Your eight days start October 1. Each day you describe a trip can be one entry.
        </p>
        <div
          class="entries__progress"
          role="progressbar"
          aria-label="Days with a trip logged"
          aria-valuemin="0"
          aria-valuemax={wwd.maxEntries}
          aria-valuenow="0"
          data-me-progress
        >
          <span data-me-progress-fill></span>
        </div>
        <ol class="entries__days" aria-label="October 1 to 8, one day at a time">
          {
            days.map((d) => (
              <li class="entries__day" data-day={d.number}>
                <span class="entries__day-number">Day {d.number}</span>
                <span class="entries__date">
                  {d.weekday}, {d.monthDay}
                </span>
                <span class="entries__mark" aria-hidden="true">
                  <Icon name="mdi:check-bold" class="entries__check" />
                </span>
                <span class="entries__state" data-day-status>
                  Coming up
                </span>
                <span class="entries__modes" data-day-modes hidden />
                <ul class="entries__plans" data-day-plans hidden />
              </li>
            ))
          }
        </ol>
        <a href="/bingo" class="entries__bingo">
          <Icon name="mdi:grid" class="size-6" aria-hidden="true" />
          Play Transit Bingo while you go
          <Icon name="mdi:arrow-right" class="size-5" aria-hidden="true" />
        </a>

        {/* Today's trip: how they traveled, a description, and optional media. */}
        <form data-trip-form hidden class="trip" novalidate data-needs-connection="trip">
          <input type="hidden" name="planId" data-trip-plan-id disabled />
          <p class="trip__plan" data-trip-plan-selected hidden></p>
          <fieldset class="trip__step" aria-describedby="trip-error">
            <legend class="trip__q"
              ><span class="trip__n" aria-hidden="true">1</span> How did you get around today without
              driving?</legend
            >
            <div class="log__modes">
              {
                modes.map((m) => (
                  <label class="log__mode">
                    <input type="checkbox" name="mode" value={m.value} />
                    <Icon name={m.icon} class="log__icon" aria-hidden="true" />
                    <span>{m.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="trip__step">
            <legend class="trip__q"
              ><span class="trip__n" aria-hidden="true">2</span> Tell us about the trip.</legend
            >
            <label for="trip-description" class="log__hard-label"
              >Where did you go, and how did you get there?</label
            >
            <textarea
              id="trip-description"
              name="description"
              rows="3"
              maxlength="500"
              required
              class="log__hard"
              placeholder="I took the bus to the grocery store and walked home."></textarea>
            <label for="trip-hard" class="log__hard-label"
              >Was anything hard? <span class="log__optional"
                >(optional, separate from your entry)</span
              ></label
            >
            <textarea
              id="trip-hard"
              name="hard"
              rows="2"
              maxlength="280"
              class="log__hard"
              placeholder="A stop with no shade, a sidewalk that ends, a long wait…"></textarea>
          </fieldset>

          <div class="trip__step" data-share-step>
            <p class="trip__q">
              <span class="trip__n" aria-hidden="true">3</span> Add a post, if you want.
            </p>
            <p class="trip__help">
              A post is optional. If you share one, say “Week Without Driving giveaway entry” at the
              start of the caption or on the story itself. Tag @lasvegasfortransit on Instagram or
              use #WeekWithoutDriving. You can add our picture to your post.
            </p>
            <button type="button" class="btn shared__save mt-3" data-make-picture>
              <Icon name="mdi:image-outline" class="size-5" aria-hidden="true" />
              Add our picture
            </button>
            <div data-share-kit hidden>
              <img
                data-share-preview
                alt=""
                hidden
                class="shared__preview"
                width="1080"
                height="1350"
              />
              <div class="shared__actions">
                <button type="button" class="btn shared__share" data-share-image>
                  <Icon name="mdi:share-variant" class="size-5" aria-hidden="true" />
                  Share
                </button>
                <button type="button" class="btn shared__save" data-save-image>
                  <Icon name="mdi:download" class="size-5" aria-hidden="true" />
                  Save
                </button>
              </div>
              <p class="shared__caption-label">Caption to paste</p>
              <p class="shared__caption" data-share-caption></p>
              <button type="button" class="shared__copy" data-copy-caption>Copy the caption</button>
              <p class="shared__status" data-share-status aria-live="polite"></p>
            </div>
          </div>

          <fieldset class="trip__step">
            <legend class="sr-only">Optional post details</legend>
            <label for="trip-link" class="log__hard-label"
              >Link to your post <span class="log__optional">(optional)</span></label
            >
            <input
              id="trip-link"
              name="link"
              type="url"
              inputmode="url"
              autocomplete="off"
              class="trip__link"
              placeholder="https://www.instagram.com/p/…"
            />
            <label class="trip__screenshot">
              <input
                type="file"
                name="screenshot"
                accept="image/jpeg,image/png,image/heic,image/heif,image/webp"
                class="sr-only"
                data-screenshot-input
              />
              <Icon name="mdi:cellphone-screenshot" class="size-6" aria-hidden="true" />
              <span data-screenshot-label
                >Private account? You can add a screenshot of your post.</span
              >
            </label>
            <label class="trip__consent">
              <input type="checkbox" name="share" />
              <span>LVBT may share my post or screenshot on Instagram and lvwwd.org.</span>
            </label>
            <p class="trip__help" data-tag-note hidden>
              A tag from your registered Instagram handle may count after volunteer review. Enter
              here to make sure your trip is submitted.
            </p>
          </fieldset>

          <button
            type="submit"
            class="btn btn--primary btn--big btn--block"
            data-trip-submit
            data-needs-connection-button
          >
            Enter today’s trip
          </button>
          <p id="trip-error" class="log__error" data-trip-error aria-live="polite"></p>
          <p class="log__drove">
            Had to drive today? You haven’t failed. Try one trip without the car tomorrow.
          </p>
        </form>

        {/* After entering: the day's entry, confirmed. */}
        <div data-trip-done hidden class="shared">
          <p class="shared__title" data-trip-done-title aria-live="polite"></p>
          <p class="shared__ask">
            We check every trip before the draw. Come back tomorrow for another entry.
          </p>
        </div>

        <p class="entries__status" data-log-closed hidden></p>
        <p class="entries__fine">
          One entry for each day you describe a trip without driving, up to 8. A post is optional.
          See the <a href="/giveaway/rules" class="body-link">Official Rules</a>.
        </p>
      </section>

      {/* A plan is preparation; a completed trip becomes an entry only after it is described. */}
      <section class="myweek__section planner" aria-labelledby="go-heading">
        <p class="planner__eyebrow">Make it happen</p>
        <h2 id="go-heading" class="myweek__h2">Plan a trip or event</h2>
        <p class="myweek__p">
          Pick a place and a way to get there. Save the plan for one of your eight days, then come
          back to describe the trip you actually take. Planning alone is not an entry.
        </p>
        <p class="planner__status" data-plan-status role="status" aria-live="polite" tabindex="-1">
        </p>

        <form data-plan-form hidden class="planner__form" novalidate data-needs-connection="plan">
          <p class="planner__progress" data-plan-progress>Step 1 of 4</p>

          <fieldset class="planner__step" data-plan-step="1">
            <legend>1. Where are you going?</legend>
            <div class="planner__choices">
              <label
                ><input type="radio" name="planKind" value="outing" /> Pick a place to try</label
              >
              <label><input type="radio" name="planKind" value="event" /> Go to an event</label>
              <label><input type="radio" name="planKind" value="own" /> My own destination</label>
            </div>
            <div class="planner__detail" data-plan-kind-panel="outing" hidden>
              <label for="plan-outing">Choose a place</label>
              <select id="plan-outing" name="outing">
                <option value="">Choose a place</option>
                {
                  planOutings.map((outing) => (
                    <option value={outing.anchor} data-destination={outing.heading}>
                      {outing.heading}
                    </option>
                  ))
                }
              </select>
            </div>
            <div class="planner__detail" data-plan-kind-panel="event" hidden>
              <label for="plan-event-name">What event?</label>
              <input id="plan-event-name" name="eventName" type="text" maxlength="120" />
              <label for="plan-event-place">Where is it?</label>
              <input id="plan-event-place" name="eventDestination" type="text" maxlength="120" />
            </div>
            <div class="planner__detail" data-plan-kind-panel="own" hidden>
              <label for="plan-own-place">Where do you want to go?</label>
              <input id="plan-own-place" name="ownDestination" type="text" maxlength="120" />
            </div>
          </fieldset>

          <fieldset class="planner__step" data-plan-step="2" hidden>
            <legend>2. When will you go?</legend>
            <div class="planner__when">
              <div>
                <label for="plan-day">Day of the week</label>
                <select id="plan-day" name="day" required>
                  <option value="">Choose a day</option>
                  {
                    days.map((day) => (
                      <option value={day.number}>
                        {day.weekday}, {day.monthDay}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div>
                <label for="plan-time">About what time?</label>
                <input id="plan-time" name="time" type="time" required />
              </div>
            </div>
            <p class="planner__hint">Use Las Vegas time. An approximate departure time is fine.</p>
          </fieldset>

          <fieldset class="planner__step" data-plan-step="3" hidden>
            <legend>3. What could work for you?</legend>
            <p class="planner__hint">
              Choose what you have available, then what you would try. You can pick more than one.
            </p>
            <div class="planner__mode-groups">
              <div>
                <h3>Available to me</h3>
                <div class="planner__mode-choices">
                  {
                    planModes.map((mode) => (
                      <label>
                        <input type="checkbox" name="availableMode" value={mode.value} />{' '}
                        {mode.label}
                      </label>
                    ))
                  }
                </div>
              </div>
              <div>
                <h3>I’d consider</h3>
                <div class="planner__mode-choices">
                  {
                    planModes.map((mode) => (
                      <label>
                        <input type="checkbox" name="willingMode" value={mode.value} /> {mode.label}
                      </label>
                    ))
                  }
                </div>
              </div>
            </div>
          </fieldset>

          <div class="planner__step" data-plan-step="4" hidden>
            <h3>4. Your plan</h3>
            <p class="planner__summary" data-plan-summary></p>
            <p class="planner__hint">Check a route and your trip home before you leave.</p>
            <ul class="planner__suggestions" data-plan-suggestions></ul>
            <p class="planner__hint">
              Planning alone is not an entry. After your trip, come back to describe what you did.
            </p>
          </div>

          <p class="planner__error" data-plan-error role="alert" aria-live="polite"></p>
          <div class="planner__actions">
            <button type="button" class="btn btn--outline" data-plan-back hidden>Back</button>
            <button type="button" class="btn btn--primary" data-plan-next>Next</button>
            <button
              type="submit"
              class="btn btn--primary"
              data-plan-save
              data-needs-connection-button
              hidden>I’ll go without driving</button
            >
          </div>
        </form>
        <h3 class="planner__tools-heading">Helpful tools</h3>
        <ul class="shortcuts">
          {
            shortcuts.map((s) => (
              <li>
                <a href={s.href} class="shortcut">
                  <Icon name={s.icon} class="shortcut__icon" aria-hidden="true" />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        /*
        REMINDERS: the intro, then one part for each way to get them.
        /scripts/reminders.js shows the parts and switches the whole
        section to its closing line once sign-up for reminders closes.
      */
      }
      <section
        hidden
        class="myweek__card"
        aria-labelledby="remind-heading"
        data-remind
        data-closes-at={REMINDERS.signupClosesAt}
        data-needs-connection="reminders"
      >
        <div data-remind-intro>
          <h2 id="remind-heading" class="myweek__h2">Remind me to share my trip</h2>
          <p class="myweek__p">
            One short reminder each morning, October 1 to 8, at about 8:00 am, to leave the car at
            home and share your trip. You can stop anytime.
          </p>
        </div>
        <p class="myweek__p remind__closed" data-remind-closed hidden>
          Daily reminders have ended. Thanks for taking part!
        </p>
        <div class="remind__part" data-push hidden>
          <h3 class="remind__h3">Browser notifications</h3>
          <p class="myweek__p" data-push-consent hidden>
            One notification a day on this phone, October 1 to 8, at about 8:00 am. No phone number
            needed. Tap it to open My week and share your trip. Turn them off anytime with Stop
            reminders on this page. See <a href="/privacy" class="body-link">Privacy</a>.
          </p>
          <p class="myweek__p" data-push-iphone hidden>
            On iPhone, notifications work only from the Home Screen. Add lvwwd.org to your Home
            Screen from this page, open it from the new WWD Las Vegas icon, tap My week, then tap
            Turn on notifications.
          </p>
          <p class="remind__status" data-push-status aria-live="polite"></p>
          <div class="remind__actions">
            <button
              type="button"
              class="btn btn--primary"
              data-push-on
              data-needs-connection-button
              hidden
            >
              Turn on notifications
            </button>
            <button
              type="button"
              class="btn btn--outline"
              data-push-stop
              data-needs-connection-button
              hidden
            >
              Stop reminders
            </button>
            <button
              type="button"
              class="btn btn--outline"
              data-push-how
              data-open-install-sheet
              hidden
            >
              Show me how
            </button>
          </div>
        </div>
      </section>

      <div class="myweek__card">
        <KeepGoingCard
          id="keep-going"
          heading={KEEP_GOING.heading}
          text={KEEP_GOING.text}
          source="keep_going"
        />
      </div>

      {/* DETAILS */}
      <section class="myweek__section" aria-labelledby="details-heading">
        <h2 id="details-heading" class="myweek__h2">Your details</h2>
        <dl class="details">
          <div><dt>Name</dt><dd data-me-field="firstName"></dd></div>
          <div><dt>Contact</dt><dd data-me-field="contact"></dd></div>
          <div><dt>ZIP code</dt><dd data-me-field="zip"></dd></div>
          <div><dt>County</dt><dd data-me-field="county"></dd></div>
          <div><dt>Instagram</dt><dd data-me-field="instagram"></dd></div>
        </dl>
        <a href="/sign-up?edit=1" class="arrow-link mt-4">Change my details</a>
      </section>

      <section
        class="myweek__card"
        aria-labelledby="phones-heading"
        data-needs-connection="send-link"
      >
        <h2 id="phones-heading" class="myweek__h2">Use My Week on another phone</h2>
        <p class="myweek__p" data-me-link-line>
          We can email a sign-in link to open My Week on another phone.
        </p>
        <a href="/my-week/link" class="arrow-link mt-3" data-needs-connection-button
          >Email a sign-in link</a
        >
      </section>

      <p class="myweek__signout">
        Not you?{' '}
        <button type="button" class="body-link font-bold" data-signout
          >Sign out of this phone</button
        >
      </p>
      <p class="form-error" data-signout-status aria-live="polite"></p>
      {/* For a volunteer signing people up one after another on one device. */}
      <div data-someone-else hidden>
        <button type="button" class="myweek__someone body-link font-bold" data-someone-else-button
          >Sign up someone else</button
        >
        <p class="form-error" data-someone-else-status aria-live="polite"></p>
      </div>
    </div>

    <noscript>
      <p class="myweek__lede">My week needs JavaScript turned on in your browser.</p>
    </noscript>
  </div>

  <script is:inline src="/scripts/participant-api.js" defer></script>
  <script is:inline src="/scripts/share-trip.js" defer></script>
  <script is:inline src="/scripts/reminders.js" defer></script>
  <script is:inline src="/scripts/my-week-plan-cards.js" defer></script>
  <script is:inline src="/scripts/my-week-planner.js" defer></script>
  <script is:inline src="/scripts/my-week.js" defer></script>
  <script is:inline src="/scripts/needs-connection.js" defer></script>
  <script is:inline src="/scripts/keep-going.js" defer></script>
</BaseLayout>

<style>
  .myweek {
    padding-block: clamp(2.25rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem);
  }
  .myweek__lede {
    margin-top: 0.9rem;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .myweek__welcome {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    font-weight: 700;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: 999px;
  }
  .myweek__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .myweek__note {
    margin-top: 1rem;
    color: var(--color-on-surface-variant);
  }
  .myweek__section,
  .myweek__card {
    margin-top: 2rem;
  }
  .myweek__card {
    padding: clamp(1.25rem, 4vw, 1.75rem);
    background: var(--color-surface-container);
    border-radius: 1.25rem;
  }
  .myweek__h2 {
    font-size: clamp(1.4rem, 5vw, 1.75rem);
    line-height: 1.15;
  }
  .myweek__p {
    margin-top: 0.4rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .myweek__signout {
    margin-top: 3rem;
    color: var(--color-on-surface-variant);
  }
  /* Thumb-sized targets that don't touch each other. */
  .myweek__signout button,
  .myweek__someone {
    min-height: 44px;
  }
  .myweek__someone {
    margin-top: 0.75rem;
  }

  /* Entries: a ticket-like card with the eight days. */
  .entries {
    margin-top: 1.75rem;
    padding: clamp(1.25rem, 4vw, 1.75rem);
    color: var(--color-on-slab);
    background: var(--color-slab);
    border-radius: 1.25rem;
  }
  .entries__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .entries__count {
    font-size: clamp(1.8rem, 7vw, 2.4rem);
    line-height: 1.05;
  }
  .entries__count [data-me-count] {
    color: var(--color-on-slab-accent);
  }
  .entries__prize {
    font-weight: 700;
    color: var(--color-on-slab-variant);
  }
  .entries__intro {
    margin-top: 0.8rem;
    color: var(--color-on-slab-variant);
  }
  .entries__progress {
    height: 0.75rem;
    margin-top: 1rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-on-slab) 18%, transparent);
    border-radius: 999px;
  }
